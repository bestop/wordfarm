/* pages/game/game.wxss - 游戏页样式 */

/*
 * 布局原理（v17 根治 = 移除 JS 高度绑定 + 纯 CSS 视口链路）:
 *   app.wxss 已有 page{height:100%}(=windowHeight 视口高度)
 *   .game-page height:100% 继承视口高度,与 JS pageHeight 数据完全解耦
 *   —— 根治 v16 及之前"layout 未就绪 fallback 1334rpx > 实际视口"导致的底部裁切
 *   flex column: hud(固定) + shop-bar(固定) + canvas-wrap(flex:1,弹性收缩,min 160rpx) + quiz-wrap(固定,文档流)
 *   · canvas-wrap flex:1 flex-shrink:1 自动吸收剩余空间 (min 160rpx 兜底)
 *   · quiz-wrap flex-shrink:0 物理上不被压缩，永远完整显示 4 个答案选项
 *   · v16 紧凑化答题区：option 60rpx + gap 8rpx + padding 5/8rpx
 *   · 两者在文档流中物理相邻，不可能相互重叠
 *   · 实际 canvas 像素尺寸由 JS 通过 SelectorQuery 实测 DOM 渲染尺寸后设置
 */
.game-page {
  width: 100%;
  height: 100%;      /* v17: 纯 CSS 视口链路,不依赖 JS pageHeight */
  max-height: 100%;  /* v17: 双保险,任何情况下不超视口 */
  display: flex;
  flex-direction: column;
  background: #FBF3E2;   /* v63: 木语农场纸色底 */
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
}

/* ============ HUD ============ */
/* v63：HUD → 农场木质横梁（板条纹理 + 深色压边 + 顶光） */
.hud {
  flex-shrink: 0;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(63, 38, 20, 0.14) 0 3rpx,
      rgba(255, 255, 255, 0.05) 3rpx 6rpx,
      rgba(63, 38, 20, 0) 6rpx 86rpx),
    linear-gradient(180deg,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0) 40%,
      rgba(63, 38, 20, 0.12) 100%),
    linear-gradient(180deg, #D8AC74 0%, #BC8048 55%, #9A6238 100%);
  border-bottom: 4rpx solid #6B4224;
  box-shadow: 0 6rpx 14rpx rgba(63, 38, 20, 0.3);
  padding: 6rpx 20rpx 10rpx;
}
.hud-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hud-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  overflow: hidden;
  padding: 4rpx 12rpx;
  /* v63：梁上雕刻凹槽木牌（深色内凹 + 奶白刻字） */
  border-radius: 14rpx 20rpx 16rpx 22rpx / 18rpx 14rpx 22rpx 16rpx;
  background: rgba(63, 38, 20, 0.30);
  border: 2rpx solid rgba(63, 38, 20, 0.45);
  box-shadow: inset 0 3rpx 6rpx rgba(42, 24, 12, 0.4),
              inset 0 -1rpx 0 rgba(255, 255, 255, 0.12);
}
.hud-label {
  font-size: 16rpx;
  color: rgba(255, 244, 214, 0.78);
  font-weight: 700;
  line-height: 1;
  margin-bottom: 3rpx;
}
.hud-value {
  font-size: 28rpx;
  font-weight: 900;
  color: #FFF4D6;
  text-shadow: 0 2rpx 0 rgba(42, 24, 12, 0.5);
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.hud-score { flex: 1.2; }
.hud-defense { flex: 1.4; }
.hud-combo { flex: 1; }
.hud-sunlight { flex: 1.1; }
/* v65：HUD 每格专属糖果色凹槽（阳光琥珀/分数天蓝/防线莓粉），一眼分辨信息类型 */
.hud-sunlight { background: rgba(140, 84, 0, 0.38); border-color: rgba(255, 183, 28, 0.65); }
.hud-score    { background: rgba(15, 74, 118, 0.42); border-color: rgba(79, 195, 247, 0.55); }
.hud-defense  { background: rgba(120, 22, 60, 0.36); border-color: rgba(255, 128, 171, 0.58); }
.hud-sunlight .hud-value {
  display: flex;
  align-items: center;
  gap: 3rpx;
  color: #FFE082;
}
.sun-icon { font-size: 24rpx; }
/* v52: 关卡徽章补缺 — level-badge 自 v2 起被 wxml 引用但样式缺失(裸默认文本)。
   v63：浅木小牌 + 琥珀刻字（在深色凹槽内更醒目）；flex-shrink:0 防被 ellipsis 截断 */
.hud-score .hud-value {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.level-badge {
  font-size: 20rpx;
  font-weight: 800;
  color: #5A3A10;
  background: linear-gradient(180deg, #FFD54F, #FFB300);
  border: 2rpx solid rgba(95, 59, 34, 0.65);
  border-radius: 10rpx 14rpx 12rpx 16rpx / 14rpx 10rpx 16rpx 12rpx;
  padding: 2rpx 10rpx;
  line-height: 1.25;
  flex-shrink: 0;
  text-shadow: none;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.6);
}
.hud-combo.combo-active {
  /* v63：连击燃烧 → 火焰烙印凹槽（木梁上像被烙铁烫过） */
  background: linear-gradient(180deg, rgba(216, 67, 21, 0.55), rgba(183, 28, 28, 0.55));
  border-color: rgba(120, 20, 10, 0.8);
}
.combo-fire { font-size: 22rpx; }

.lives-row { display: flex; gap: 5rpx; }
.flower { font-size: 26rpx; line-height: 1; transition: transform 0.2s; }
.flower.on { filter: none; }
.flower.off { filter: grayscale(1) opacity(0.28); }   /* v59: 失守防线一眼可辨 */

.hud-pause {
  padding: 4rpx;
  background: transparent;
  border: none;
  box-shadow: none;
}
.pause-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  /* v63：圆木图钉按钮（v65 提亮蜜色橡木） */
  background-image:
    radial-gradient(circle at 32% 30%, rgba(255,255,255,0.55) 0 12rpx, rgba(255,255,255,0) 16rpx),
    linear-gradient(180deg, #D8AC74 0%, #BC8048 60%, #9A6238 100%);
  border: 3rpx solid rgba(63, 38, 20, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFF8EA;
  font-weight: 900;
  box-shadow: 0 4rpx 10rpx rgba(63, 38, 20, 0.4), inset 0 -3rpx 6rpx rgba(63, 38, 20, 0.3);
}

/* ============ Canvas 区 ============ */
/* v17 根治（Task 21）：min-height 200→160rpx 再释放 40rpx 兜底
   · 空间充裕时 canvas 自动吸收剩余空间（flex:1）
   · 空间不足时 canvas 优先收缩（flex-shrink:1 比 quiz-wrap 的 0 大），
     保护 quiz-wrap 永远完整显示 4 个答案选项
   · 纯 CSS 视口链路下最坏预算：HUD 87 + Shop 96 + Canvas min 160 + Quiz 247 + safeBottom 68
     = 658rpx < 任何在售机型视口(最小 ~1016rpx)，canvas 仍可扩展 358rpx+ */
.canvas-wrap {
  flex: 1 1 0;
  flex-shrink: 1;         /* v15: 与 quiz-wrap flex-shrink:0 形成对比 */
  min-height: 160rpx;     /* v17: 200→160 再释放 40rpx 给 quiz 兜底 */
  position: relative;
  /* v63：Canvas 透出区 → 农场天空兜底（与 Canvas 内草地场景衔接） */
  background: linear-gradient(180deg, #9ED9FF 0%, #B9E88B 100%);
  width: 100%;
}
.game-canvas {
  display: block;
}

/* ============ 可收集阳光 DOM 层（v3） ============ */
.suns-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 15;
}
.sun-coin {
  position: absolute;
  /* v23: 点击热区 88→132rpx（+50%）；transform: translate(-50%, -50%) 以中心
     对齐，元素位置/视觉中心不变，视觉直径由 sun-coin-inner 保持 88rpx */
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  will-change: transform, opacity, left, top;
}
.sun-coin-inner {
  position: relative;
  /* v23: 视觉直径不变（88rpx），scale 动画由 wxml 内联 style 应用在本元素 */
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #FFFBE0 0%, #FFD84D 55%, #FFA000 100%);
  box-shadow: 0 6rpx 14rpx rgba(255, 168, 0, 0.42), inset 0 -4rpx 10rpx rgba(180, 110, 10, 0.3), inset 0 4rpx 10rpx rgba(255,255,255,0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}
.sun-emoji {
  font-size: 44rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 2rpx rgba(160, 90, 10, 0.25));
}
.sun-value-label {
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  font-weight: 700;
  color: #E08E00;
  text-shadow: 0 2rpx 0 rgba(255,255,255,0.75);
  white-space: nowrap;
  pointer-events: none;
}
.sun-coin-collected {
  transition: none; /* 动画由 setData 的 style 控制每帧插值 */
  pointer-events: none;
}
/* 基础呼吸/飘动：在 setData 每帧刷新位置的基础上再叠加微小柔和颤动 */
.sun-coin:not(.sun-coin-collected) {
  animation: sun-float 1.8s ease-in-out infinite;
}
@keyframes sun-float {
  0%, 100% { filter: drop-shadow(0 2rpx 3rpx rgba(230, 160, 40, 0.35)); }
  50%      { filter: drop-shadow(0 6rpx 10rpx rgba(245, 190, 60, 0.6)); }
}

/* ============ 暂停遮罩 ============ */
.pause-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.52);   /* v59: 0.4→0.52 背景压制, 聚光卡片 */
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}
.pause-card {
  width: 70%;
  text-align: center;
  padding: 48rpx 32rpx;
}
.pause-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #4A342A;
  margin-bottom: 12rpx;
}
.pause-tip {
  font-size: 24rpx;
  color: #7A6450;
  margin-bottom: 32rpx;
}
.pause-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pause-actions .kawaii-btn {
  width: 100%;
  font-size: 30rpx;
  padding: 20rpx 0;
}
/* v59: 次级「退出本局」弱化 — v63 同步纸签风（虚线墨框） */
.pause-actions .kawaii-btn-ghost {
  font-size: 26rpx;
  padding: 15rpx 0;
  color: #7A6450;
  border-color: rgba(74, 52, 42, 0.35);
  background: rgba(255, 253, 245, 0.75);
  box-shadow: 0 3rpx 0 rgba(74, 52, 42, 0.18);
}

/* ============ 答题面板（v16 文档流弹性布局 + 紧凑化升级） ============ */
/* v16 升级（Task 15）：在 v15 文档流末端 flex 子项 flex-shrink:0 基础上，
   紧凑化 quiz-panel 内部（option 60rpx / gap 8rpx / padding 5/8rpx）释放 ~47rpx。
   · 与 canvas-wrap (flex-shrink:1, min 200rpx) 形成 flex 链路协同：canvas 弹性收缩，
     quiz-wrap 永远完整显示 4 个答案选项
   · 不依赖 boundingClientRect 异步测高，无时序竞态、无换题抖动
   · 与 canvas-wrap 物理相邻（前者在上、本块在下），不可能相互遮挡 */
.quiz-wrap {
  flex-shrink: 0;          /* v15: 文档流末端，不被压缩 */
  width: 100%;
  box-sizing: border-box;
  position: relative;
  background: #FBF3E2;     /* v63: 木语农场纸色兜底，防止透出 canvas */
}


/* ============ 植物商店栏 ============ */
/* v63：商店栏 → 农场种子木架（横板条货架 + 深色压边） */
.shop-bar {
  flex-shrink: 0;
  height: 96rpx;
  background-image:
    repeating-linear-gradient(0deg,
      rgba(63, 38, 20, 0.12) 0 2rpx,
      rgba(255, 255, 255, 0.04) 2rpx 4rpx,
      rgba(63, 38, 20, 0) 4rpx 40rpx),
    linear-gradient(180deg,
      rgba(255, 255, 255, 0.16) 0%,
      rgba(255, 255, 255, 0) 45%,
      rgba(63, 38, 20, 0.14) 100%),
    linear-gradient(180deg, #D8AC74 0%, #BC8048 55%, #9A6238 100%);
  border-top: 3rpx solid rgba(255, 244, 214, 0.4);
  border-bottom: 4rpx solid #6B4224;
  box-shadow: 0 6rpx 12rpx rgba(63, 38, 20, 0.22);
  padding: 6rpx 10rpx 4rpx;
  box-sizing: border-box;
  position: relative;
}
.shop-scroll {
  white-space: nowrap;
  height: 72rpx;
}
.shop-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 72rpx;
  margin-right: 8rpx;
  /* v63：种子纸包（纸卡 + 抖动圆角 + 墨线） */
  border-radius: 12rpx 18rpx 14rpx 20rpx / 16rpx 12rpx 20rpx 14rpx;
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.04) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 18rpx),
    linear-gradient(180deg, #FFFDF5 0%, #F6EDD6 100%);
  border: 2rpx solid rgba(74, 52, 42, 0.5);
  box-shadow: 0 3rpx 0 rgba(63, 38, 20, 0.35);
  vertical-align: top;
  transition: transform 0.12s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}
.shop-item.selected {
  /* v65：选中 = 墨线/落影转为本卡植物本命色（currentColor）+ 抬起 */
  border-color: currentColor;
  transform: translateY(-4rpx);
  box-shadow: 0 7rpx 0 currentColor, 0 10rpx 14rpx rgba(63, 38, 20, 0.3);
}
.shop-item.disabled {
  opacity: 0.45;
  filter: grayscale(0.4);
}
/* ===== v65：每株植物专属「彩色种子纸包」=====
   顶部 5rpx 本命色带（inset shadow）+ 纸色染（与 Canvas 角色主色 1:1）
   color 即本命色 → 选中态 border/落影自动跟随（currentColor） */
.shop-item-sunflower { color: #E68900; background: linear-gradient(180deg, #FFFBE8 0%, #FFF1BF 100%); box-shadow: inset 0 5rpx 0 rgba(255, 193, 7, 0.40), 0 3rpx 0 rgba(63, 38, 20, 0.35); }
.shop-item-shooter   { color: #4E8C1F; background: linear-gradient(180deg, #F6FBE6 0%, #E4F3C6 100%); box-shadow: inset 0 5rpx 0 rgba(131, 198, 65, 0.38), 0 3rpx 0 rgba(63, 38, 20, 0.35); }
.shop-item-wall      { color: #8C5A34; background: linear-gradient(180deg, #FBF1E6 0%, #F0DEC8 100%); box-shadow: inset 0 5rpx 0 rgba(184, 90, 24, 0.32), 0 3rpx 0 rgba(63, 38, 20, 0.35); }
.shop-item-freezer   { color: #17837E; background: linear-gradient(180deg, #EDFBFD 0%, #D6F3F6 100%); box-shadow: inset 0 5rpx 0 rgba(33, 185, 174, 0.34), 0 3rpx 0 rgba(63, 38, 20, 0.35); }
.shop-item-cherry    { color: #C62828; background: linear-gradient(180deg, #FFF1EE 0%, #FFDAD6 100%); box-shadow: inset 0 5rpx 0 rgba(244, 67, 54, 0.32), 0 3rpx 0 rgba(63, 38, 20, 0.35); }
.shop-item-chomper   { color: #751F99; background: linear-gradient(180deg, #F9EFFB 0%, #ECD8F4 100%); box-shadow: inset 0 5rpx 0 rgba(156, 52, 198, 0.30), 0 3rpx 0 rgba(63, 38, 20, 0.35); }
.shop-item-fire      { color: #C74B1D; background: linear-gradient(180deg, #FFF4EC 0%, #FFE0CC 100%); box-shadow: inset 0 5rpx 0 rgba(255, 110, 64, 0.32), 0 3rpx 0 rgba(63, 38, 20, 0.35); }
/* ===== v66: 铲子工具纸包（工具卡定位 — 灰蓝金属色系, 与植物色系区分） =====
   选中态复用 .shop-item.selected（currentColor 边线+落影+抬起） */
.shop-item-shovel    { color: #546E7A; background: linear-gradient(180deg, #F4F7F9 0%, #E3EBEF 100%); box-shadow: inset 0 5rpx 0 rgba(84, 110, 122, 0.28), 0 3rpx 0 rgba(63, 38, 20, 0.35); }
.shop-cost-shovel    { color: #546E7A; font-size: 11rpx; }
/* 铲子纯 CSS 图形：木柄 + 握把 + 金属铲头 + 星光（40rpx 画布内） */
.shop-avatar-shovel .sv-handle {
  position: absolute;
  left: 17rpx;
  top: 4rpx;
  width: 6rpx;
  height: 18rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #C8894E 0%, #A96B34 100%);
  box-shadow: inset 0 -2rpx 0 rgba(63, 38, 20, 0.25);
}
.shop-avatar-shovel .sv-grip {
  position: absolute;
  left: 12rpx;
  top: 2rpx;
  width: 16rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #C8894E 0%, #A96B34 100%);
}
.shop-avatar-shovel .sv-blade {
  position: absolute;
  left: 13rpx;
  top: 21rpx;
  width: 14rpx;
  height: 13rpx;
  border-radius: 3rpx 3rpx 8rpx 8rpx;
  background: linear-gradient(180deg, #B7C9D3 0%, #7E97A5 100%);
  border: 2rpx solid rgba(63, 38, 20, 0.35);
  box-shadow: inset -3rpx -3rpx 0 rgba(0, 0, 0, 0.10);
}
.shop-avatar-shovel .sv-spark {
  position: absolute;
  left: 27rpx;
  top: 6rpx;
  width: 7rpx;
  height: 7rpx;
  background: #FFC733;
  border-radius: 2rpx;
  transform: rotate(45deg);
  opacity: 0.9;
}
.shop-item-shovel.selected .sv-spark {
  animation: shovel-spark 0.9s ease-in-out infinite alternate;
}
@keyframes shovel-spark {
  from { transform: rotate(45deg) scale(0.8); opacity: 0.55; }
  to   { transform: rotate(45deg) scale(1.25); opacity: 1; }
}
/* ===== 商店栏：纯 CSS 萌系植物头像（设计系统 Tokens v2 - 与 Canvas 1:1 对齐）
   - 眼睛比例：eyeDX=36% headR · eyeR=24% headR（精确 RENDER_TOKENS.FACE）
   - 瞳孔位置：右下 16/12%（Canvas pOffX/Y 同）
   - 腮红位置：X=±62% headR · 底部距离= 70%（Canvas cy+0.38r 对应）
   - 高光统一左上 45°：top 14% · left 18% · 椭圆 -40deg
   - 色彩：全部从 RENDER_TOKENS.COLORS 取值（Hex 值严格对应）
=================================================================== */
/* ---- 1. 共用头部（与 Canvas head ellipse 同色板） ---- */
.shop-avatar {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto;
}
.shop-avatar .sa-head {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: #7DBE33;
  border: 2rpx solid #FFFFFF;
  box-shadow: inset -7rpx -7rpx 0 rgba(0,0,0,0.10),
              0 2rpx 4rpx rgba(125,190,51,0.45);
}
/* 统一高光：左上 45°，与 Canvas HEAD.HLIGHT_X/Y/W/H/ROT 精确对应（比例相同） */
.shop-avatar .sa-head::after {
  content: '';
  position: absolute;
  top: 14%;
  left: 18%;
  width: 28%;
  height: 42%;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);   /* RENDER_TOKENS HEAD.HLIGHT_ALPHA */
  transform: rotate(-40deg);            /* RENDER_TOKENS HEAD.HLIGHT_ROT */
}

/* ---- 2. 顶部/左右装饰（按类型差异化） ---- */
.shop-avatar .sa-deco-top {
  position: absolute;
  left: 50%;
  top: -14%;
  transform: translateX(-50%);
  width: 58%;
  height: 26%;
  border-radius: 50%;
  background: #33691E;       /* S_MOUTH_IN */
  border: 2.5rpx solid #FFFFFF;   /* v3 2→2.5 加粗描边 */
}
.shop-avatar .sa-deco-top::after {
  content: '';
  position: absolute;
  left: 50%;
  top: -55%;
  transform: translateX(-50%);
  width: 56%;
  height: 90%;
  border-radius: 50%;
  background: #CFE98C;       /* S_PEA_LIGHT (v65) */
  border: 2.5rpx solid #FFFFFF;  /* v3 加粗 */
  box-shadow: inset -3rpx -3rpx 0 rgba(255,255,255,0.35);
}
.shop-avatar .sa-deco-left,
.shop-avatar .sa-deco-right {
  position: absolute;
  bottom: -8%;
  width: 46%;
  height: 30%;
  border-radius: 50%;
  background: #9CCC65;       /* S_LEAF_MID */
  border: 2.5rpx solid #FFFFFF;  /* v3 2→2.5 加粗 */
}
.shop-avatar .sa-deco-left  { left: -18%; transform: rotate(-28deg); }
.shop-avatar .sa-deco-right { right: -18%; transform: rotate(28deg); }

/* ---- 3. 眼睛系统：严格对齐 RENDER_TOKENS.FACE ----
   FACE: EYE_DX_RATIO=0.36 · EYE_R_RATIO=0.24
   换算 %：眼中心 X 距离中心 36% → left = 50-36-24 = -10% + 单位头宽内？
   在 56rpx 圆头像（= 1×headR）中：
     eyeR = 24% × head diameter = 48% × headR（diameter=2R），所以宽度 48%？
     哦，CSS 的 % 是相对于父元素（shop-avatar）宽度（即直径 = 2R），
     Canvas 里的 eyeR = 0.24 R（半径），所以 eye 宽度 = 0.48 R = 24% of (直径 2R)。
     宽度/高度各 24%（眼睛正圆直径 2×eyeR = 48% R → 24% of 直径宽）。
     中心距离：eyeDX = 0.36 R = 18% of 直径。即左眼中心在 50% - 18% = 32%。
     所以 sa-eye-l left = 32% - 12%(半宽) = 20%
     Canvas 眼 Y：eyeY = headR×0.08（头中心偏下 0.08 直径=4% of 直径）
     所以 sa-eye top = 50% - 12%(半高) + 4% = 42%。改到 42%。
   ==============================================================================*/
.shop-avatar .sa-eye {
  position: absolute;
  top: 42%;             /* 精确 T.FACE: eyeY=cy+0.08R（中心 50% → 顶部 42%） */
  width: 24%;
  height: 24%;          /* 正圆眼（0.24R×2 = 24% of 直径） */
  border-radius: 50%;
  background: #FFFFFF;  /* T.COLORS.STROKE (眼白) */
  border: 2rpx solid #FFFFFF;   /* v3 加粗 1.5→2rpx（眼白描边在 56rpx 下必须锐利） */
}
.shop-avatar .sa-eye-l { left: 20%; }  /* = 中心距 18% + 半宽 12% → 左缘 20% */
.shop-avatar .sa-eye-r { right: 20%; } /* 镜像 */
/* 瞳孔：偏右下（v3 放大 56% → 60%，小尺寸更醒目；右下偏 16/14 保留） */
.shop-avatar .sa-pupil {
  position: absolute;
  right: 16%;           /* PUPIL_OFF_X = 0.16 eyeR → 16% of 眼宽 */
  bottom: 14%;          /* PUPIL_OFF_Y = 0.14 eyeR → 14% of 眼高 */
  width: 60%;           /* v3 56% → 60%，小尺寸不糊 */
  height: 60%;
  border-radius: 50%;
  background: #4E342E;  /* T.COLORS.INK */
}
/* 双高光：两颗 · 大 42% pupil + 小 18% pupil（sh1 左上, sh2 右下）—— 依然保留，灵动灵魂 */
.shop-avatar .sa-shine {
  position: absolute;
  left: 22%;
  top: 16%;
  width: 26%;
  height: 26%;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 14rpx 22rpx 0 -2rpx #FFFFFF;   /* 第二颗小高光 */
}

/* ---- 4. 腮红：v3 爱心 → 实心圆（56rpx 下 before/after 爱心边缘糊成锯齿，平涂圆更干净）
   仍保持 left/right 11%（BLUSH_CX=62%R），bottom 22% 对齐 mouth 上方
================================================================================== */
.shop-avatar .sa-blush {
  position: absolute;
  bottom: 22%;
  width: 18%;            /* v3 16% → 18% 略放大（圆比爱心面积小） */
  height: 14%;           /* v3 10% → 14% 正圆直径 */
  border-radius: 50%;    /* v3 爱心贝塞尔 → 纯圆 */
  background: rgba(255,141,163,0.78);   /* v65 提饱和（=BLUSH_PINK） */
}
/* 删除 before/after 双爱心伪元素（56rpx 下糊） */
.shop-avatar .sa-blush::before,
.shop-avatar .sa-blush::after { display: none; }
.shop-avatar .sa-blush-l { left: 11%; }
.shop-avatar .sa-blush-r { right: 11%; }

/* ---- 5. 嘴：v3 线条 2.2rpx → 2.8rpx 加粗（小尺寸仍锐利）
============================================================= */
.shop-avatar .sa-mouth {
  position: absolute;
  left: 50%;
  bottom: 18%;
  transform: translateX(-50%);
  width: 24%;
  height: 12%;
  border: 2.8rpx solid #4E342E;    /* T.STROKE.INK · 2.2→2.8 +27% */
  border-top: none;
  border-left: none;
  border-right: none;
  border-radius: 0 0 60% 60% / 0 0 100% 100%;
}

