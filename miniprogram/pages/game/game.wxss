  bottom: 20%;
}
.shop-avatar.shop-avatar-cherry .sa-mouth::after { display: none; }  /* 无白牙（愤怒紧闭） */
/* 浓腮红（怒气脸红） */
.shop-avatar.shop-avatar-cherry .sa-blush-l,
.shop-avatar.shop-avatar-cherry .sa-blush-r {
  background: rgba(244,143,177,0.82);   /* BLUSH_RICH */
}

/* 向日葵 sunflower v17 - 参照 role_banner.png 重新设计
   核心识别：12 片金黄花瓣 + 光滑暖橙黄花盘 + 月牙高光 + 珊瑚粉腮红
   色板：花盘 #FFA000（暖橙黄，替代原棕色），花瓣 #FFD54F（金黄），
        内层花瓣 #FFC107（橙黄），高光 #FFFDE7，腮红 #FFAB91，描边 #E65100 */
.shop-avatar.shop-avatar-sunflower .sa-head {
  background: #FFD54F;                   /* 外层花瓣主色：金黄 */
  box-shadow:
    inset -6rpx -6rpx 0 rgba(230,150,0,0.22),    /* 花瓣层立体阴影 */
    0 0 0 2rpx #E65100,                            /* v17: 深橙描边，强化花瓣轮廓 */
    0 2rpx 6rpx rgba(255,213,79,0.45);
}
/* 花盘：v17 暖橙黄（替代原棕色种子区），径向渐变营造 3D 球体感 */
.shop-avatar.shop-avatar-sunflower .sa-head::before {
  content: '';
  position: absolute;
  left: 18%; right: 18%;
  top: 18%; bottom: 18%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFB300 0%, #FFA000 60%, #FF8F00 100%);
  z-index: 0;
}
/* v17 月牙形高光：左上方白色光斑，3D 球体光泽感 */
.shop-avatar.shop-avatar-sunflower .sa-head::after {
  content: '';
  position: absolute;
  left: 25%; top: 25%;
  width: 24%; height: 18%;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,253,231,0.85) 0%, rgba(255,255,255,0) 100%);
  transform: rotate(-25deg);
  z-index: 1;
  pointer-events: none;
}
/* 顶部装饰：花芯小圆（亮黄点缀） */
.shop-avatar.shop-avatar-sunflower .sa-deco-top {
  background: #FFC107;                   /* v17: 内层花瓣色，与外层 #FFD54F 形成层次 */
  width: 34%;
  height: 34%;
  top: -16%;
  border-radius: 50%;
  border: 2.5rpx solid #E65100;          /* v17: 深橙描边替代白色 */
}
.shop-avatar.shop-avatar-sunflower .sa-deco-top::after { display: none; }
.shop-avatar.shop-avatar-sunflower .sa-deco-top::before { display: none; }
/* 侧叶改为小花瓣（金黄，比射手叶子更圆润上翘） */
.shop-avatar.shop-avatar-sunflower .sa-deco-left,
.shop-avatar.shop-avatar-sunflower .sa-deco-right {
  background: linear-gradient(180deg, #FFE082 0%, #FFCA28 100%);  /* v17: 渐变水滴形花瓣 */
  width: 50%;
  height: 34%;
  bottom: -10%;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  border: 2rpx solid #E65100;            /* v17: 深橙描边 */
}
.shop-avatar.shop-avatar-sunflower .sa-deco-left  { transform: rotate(-38deg); }
.shop-avatar.shop-avatar-sunflower .sa-deco-right { transform: rotate(38deg); }
/* 眼睛/瞳孔/高光浮于花盘之上 */
.shop-avatar.shop-avatar-sunflower .sa-eye,
.shop-avatar.shop-avatar-sunflower .sa-pupil,
.shop-avatar.shop-avatar-sunflower .sa-shine,
.shop-avatar.shop-avatar-sunflower .sa-blush,
.shop-avatar.shop-avatar-sunflower .sa-mouth { z-index: 2; }
/* v17 腮红：珊瑚粉 #FFAB91（替代原橙色），匹配暖橙黄花盘暖色调 */
.shop-avatar.shop-avatar-sunflower .sa-blush-l,
.shop-avatar.shop-avatar-sunflower .sa-blush-r {
  background: rgba(255, 171, 145, 0.7);
}
/* 微笑小嘴（弧线，暖棕） */
.shop-avatar.shop-avatar-sunflower .sa-mouth {
  border-color: #6D4C41;
}

/* 食人花 chomper v25 - 核心识别：紫渐变大圆头 + 深紫斑点 + 大嘴獠牙 + 倒八字斜视眉
   色板 1:1 对齐 Canvas：头 #E9C6F0→#8E24AA→#4A148C（径向），斑 #5E1980，
   唇 #6A1B9A，腔 #4A0E66，叶 #558B2F，眉 #3B1252，腮 rgba(206,147,216,0.50) */
.shop-avatar.shop-avatar-chomper .sa-head {
  background:
    radial-gradient(circle at 78% 26%, #6C2493 0 5.5%, transparent 6.5%),
    radial-gradient(circle at 24% 20%, #6C2493 0 4.5%, transparent 5.5%),
    radial-gradient(circle at 84% 62%, #6C2493 0 5%, transparent 6%),
    radial-gradient(circle at 14% 60%, #6C2493 0 4%, transparent 5%),
    radial-gradient(circle at 56% 9%,  #6C2493 0 3.5%, transparent 4.5%),
    radial-gradient(circle at 35% 30%, #F2D3F8 0%, #9C34C6 55%, #6A1FB8 100%);
  box-shadow: inset -8rpx -8rpx 0 rgba(74,20,110,0.30), 0 2rpx 6rpx rgba(156,52,198,0.45);
}
/* 头顶装饰隐藏（大嘴 + 斑点是识别核心，去掉旧版尖刺更贴经典造型） */
.shop-avatar.shop-avatar-chomper .sa-deco-top { display: none; }
/* 侧叶：深绿（绿叶托紫头，PvZ 经典搭配） */
.shop-avatar.shop-avatar-chomper .sa-deco-left,
.shop-avatar.shop-avatar-chomper .sa-deco-right {
  background: #558B2F;
}
.shop-avatar.shop-avatar-chomper .sa-deco-left  { transform: rotate(-16deg); }
.shop-avatar.shop-avatar-chomper .sa-deco-right { transform: rotate(16deg); }
/* 高位眼（大嘴占据下半脸，眼睛上移避开：Canvas eyeCY = -0.36 headR → top 22%） */
.shop-avatar.shop-avatar-chomper .sa-eye { top: 22%; }
/* 向内斜视瞳孔（左瞳偏右 / 右瞳偏左，与 Canvas pupilInward 1:1） */
.shop-avatar.shop-avatar-chomper .sa-eye-l .sa-pupil { right: 12%; }
.shop-avatar.shop-avatar-chomper .sa-eye-r .sa-pupil { right: auto; left: 12%; }
/* 倒八字凶眉（深紫黑，与 Canvas CH_BROW 同色） */
.shop-avatar.shop-avatar-chomper .sa-eye::before {
  content: '';
  position: absolute;
  left: -12%;
  top: -34%;
  width: 124%;
  height: 34%;
  border-radius: 4rpx;
  background: #3B1252;
  transform: rotate(-16deg);
}
.shop-avatar.shop-avatar-chomper .sa-eye-r::before { transform: rotate(16deg); }
/* 大嘴：近黑紫口腔 + 深紫厚唇（白描边外圈）+ 上下白獠牙 */
.shop-avatar.shop-avatar-chomper .sa-mouth {
  left: 50%;
  top: 48%;
  bottom: auto;
  width: 54%;
  height: 30%;
  background: #460C66;
  border: 4rpx solid #7B27AA;
  box-shadow: 0 0 0 2rpx #FFFFFF;
  border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
}
/* 上獠牙（2 颗圆尖牙从上唇垂下） */
.shop-avatar.shop-avatar-chomper .sa-mouth::after {
  content: '';
  position: absolute;
  left: 9%;
  right: 9%;
  top: 0;
  height: 55%;
  background:
    radial-gradient(circle at 30% 0%, #FFFFFF 0 52%, transparent 54%),
    radial-gradient(circle at 70% 0%, #FFFFFF 0 52%, transparent 54%);
  z-index: 1;
}
/* 下獠牙（1 颗大尖牙从下唇立起） */
.shop-avatar.shop-avatar-chomper .sa-mouth::before {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 30%;
  height: 45%;
  background: #FFFFFF;
  clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
  transform: translateX(-50%);
  z-index: 1;
}
/* 淡紫腮红（凶萌调性，随眼睛上移） */
.shop-avatar.shop-avatar-chomper .sa-blush-l,
.shop-avatar.shop-avatar-chomper .sa-blush-r {
  background: rgba(224,144,246,0.62);
  bottom: 38%;
}

/* 火焰射手 fire v25 - 核心识别：橙红渐变头 + 头顶火苗冠 + 焦土叶 + 倒八字斜视眉 + 坏笑
   色板 1:1 对齐 Canvas：头 #FFE0B2→#FF6E40→#D84315（径向），烬斑 #E64A19，
   火苗 #E64A19/#FF8A65/#FFEB3B，叶 #A1887F，眉 #8D2819，腮 rgba(255,112,67,0.45) */
.shop-avatar.shop-avatar-fire .sa-head {
  background:
    radial-gradient(circle at 74% 22%, #E64A19 0 5%, transparent 6%),
    radial-gradient(circle at 26% 62%, #E64A19 0 4%, transparent 5%),
    radial-gradient(circle at 35% 30%, #FFE0B2 0%, #FF6E40 55%, #D84315 100%);
  box-shadow: inset -8rpx -8rpx 0 rgba(216,67,21,0.28), 0 2rpx 6rpx rgba(255,110,64,0.45);
}
/* 头顶火苗冠（三层色尖角火苗：外深橙红 + 中橙 + 内亮黄，clip-path 火苗形） */
.shop-avatar.shop-avatar-fire .sa-deco-top {
  top: -44%;
  width: 46%;
  height: 48%;
  border: none;
  border-radius: 0;
  background: linear-gradient(180deg, #FF8A65 0%, #E64A19 70%);
  clip-path: polygon(50% 0%, 76% 20%, 100% 100%, 0% 100%, 24% 20%);
  transform: translateX(-50%);
}
/* 中层橙火苗（内缩 20%） */
.shop-avatar.shop-avatar-fire .sa-deco-top::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 62%;
  height: 78%;
  background: #FF8A65;
  clip-path: polygon(50% 0%, 76% 22%, 100% 100%, 0% 100%, 24% 22%);
}
/* 内核亮黄火苗（底部中心） */
.shop-avatar.shop-avatar-fire .sa-deco-top::before {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40%;
  height: 56%;
  background: #FFEB3B;
  clip-path: polygon(50% 0%, 76% 24%, 100% 100%, 0% 100%, 24% 24%);
}
/* 侧叶：焦土棕（焦土植物，区别于绿色系） */
.shop-avatar.shop-avatar-fire .sa-deco-left,
.shop-avatar.shop-avatar-fire .sa-deco-right {
  background: #A1887F;
}
.shop-avatar.shop-avatar-fire .sa-deco-left  { transform: rotate(-22deg); }
.shop-avatar.shop-avatar-fire .sa-deco-right { transform: rotate(22deg); }
/* 向内斜视瞳孔（与 Canvas pupilInward 1:1） */
.shop-avatar.shop-avatar-fire .sa-eye-l .sa-pupil { right: 12%; }
.shop-avatar.shop-avatar-fire .sa-eye-r .sa-pupil { right: auto; left: 12%; }
/* 倒八字怒眉（深红棕，与 Canvas FR_BROW 同色） */
.shop-avatar.shop-avatar-fire .sa-eye::before {
  content: '';
  position: absolute;
  left: -12%;
  top: -34%;
  width: 124%;
  height: 34%;
  border-radius: 4rpx;
  background: #8D2819;
  transform: rotate(-16deg);
}
.shop-avatar.shop-avatar-fire .sa-eye-r::before { transform: rotate(16deg); }
/* grin 坏笑嘴（深粉 + 白牙，与 Canvas mouth:'grin' 1:1） */
.shop-avatar.shop-avatar-fire .sa-mouth {
  background: #E91E63;
  border-top: none;
  border-left: 2.8rpx solid #FFFFFF;
  border-right: 2.8rpx solid #FFFFFF;
  border-bottom: 2.8rpx solid #FFFFFF;
  border-radius: 0 0 50% 50% / 0 0 100% 100%;
  width: 32%;
  height: 16%;
  bottom: 16%;
}
.shop-avatar.shop-avatar-fire .sa-mouth::after {
  content: '';
  position: absolute;
  left: 20%;
  top: -2rpx;
  width: 60%;
  height: 38%;
  background: #FFFFFF;
  border-radius: 0 0 50% 50%;
}
/* 暖橙腮红（火系暖调） */
.shop-avatar.shop-avatar-fire .sa-blush-l,
.shop-avatar.shop-avatar-fire .sa-blush-r {
  background: rgba(255,112,67,0.58);
}

/* 选中/禁用 状态（与 Tokens 联动） */
.shop-item.selected .shop-avatar {
  transform: scale(1.12) rotate(-3deg);
}
.shop-item.disabled .shop-avatar {
  filter: grayscale(0.5) opacity(0.6);
}

.shop-name {
  font-size: 14rpx;
  color: #6D5138;
  font-weight: 700;
  line-height: 1.1;
  margin-top: 1rpx;
}
.shop-cost {
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 13rpx;
  color: #EF8F00;
  font-weight: 800;
  line-height: 1;
  margin-top: 1rpx;
}
.shop-cost-icon { font-size: 14rpx; }
/* 植物选择提示浮层：v63 纸签便条风（胶带贴顶），悬浮于 canvas 顶部居中 */
.plant-tip-toast {
  position: absolute;
  left: 50%;
  top: 18rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 30rpx;
  max-width: 80%;
  font-size: 25rpx;
  font-weight: 500;
  color: #4A342A;
  text-align: center;
  letter-spacing: 0.6rpx;
  line-height: 1.35;
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.04) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 22rpx),
    rgba(255, 253, 245, 0.94);
  border: 2.5rpx solid rgba(101, 155, 46, 0.62);
  border-radius: 18rpx 26rpx 20rpx 28rpx / 24rpx 18rpx 28rpx 20rpx;
  box-shadow: 2rpx 3rpx 0 rgba(74, 52, 42, 0.12),
              0 6rpx 14rpx rgba(63, 71, 55, 0.16);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  animation: tipFadeIn 220ms ease-out both;
  z-index: 20;
  pointer-events: none;
}
/* 顶部小胶带 */
.plant-tip-toast::before {
  content: "";
  position: absolute;
  top: -10rpx;
  left: 50%;
  width: 64rpx;
  height: 20rpx;
  transform: translateX(-50%) rotate(-2deg);
  background: linear-gradient(180deg, rgba(255, 236, 153, 0.85), rgba(255, 221, 102, 0.7));
  pointer-events: none;
}
.plant-tip-emoji {
  font-size: 26rpx;
  opacity: 0.82;
  filter: saturate(0.85);
  animation: plantTipBob 1.1s ease-in-out infinite;   /* v59 */
}
@keyframes tipFadeIn {
  0%   { opacity: 0; transform: translate(-50%, -10rpx); }
  100% { opacity: 1; transform: translate(-50%, 0); }
}
/* v59: 手指上下浮动 — 静态贴纸 → 动态引导点击 */
@keyframes plantTipBob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}

/* ============ 游戏结束结算浮层（v63：羊皮纸奖状 + 木框） ============ */
.gameover-mask {
  position: absolute;
  inset: 0;
  background: rgba(42, 30, 20, 0.52);
  backdrop-filter: blur(3rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  z-index: 90;   /* v14 高于 fixed 答题面板(50)，结算时完全覆盖 */
  animation: fadeIn 0.32s ease-out;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.gameover-card {
  width: 100%;
  max-width: 640rpx;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 30rpx 28rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  /* v63：羊皮纸奖状 + 木质厚框 + 压边 */
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.05) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 28rpx),
    linear-gradient(180deg, #FFFDF5 0%, #F6EDD6 100%);
  border-radius: 34rpx 26rpx 38rpx 28rpx / 28rpx 36rpx 26rpx 38rpx;
  border: 6rpx solid #6B4224;
  box-shadow:
    0 10rpx 0 rgba(63, 38, 20, 0.3),
    0 22rpx 44rpx rgba(42, 30, 20, 0.4),
    inset 0 0 0 3rpx rgba(255, 255, 255, 0.55),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.8);
  animation: cardPop 0.42s cubic-bezier(.2,.9,.2,1.15);
}
@keyframes cardPop {
  0%   { opacity: 0; transform: scale(0.72) translateY(20rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

/* 头部：emoji + 标题 + 破纪录徽章 */
.go-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.go-emoji {
  font-size: 82rpx;
  line-height: 1;
  animation: goTrophy 2.6s ease-in-out infinite;
}
@keyframes goTrophy {
  0%, 100% { transform: translateY(0) rotate(-5deg); }
  50%      { transform: translateY(-8rpx) rotate(5deg); }
}
.go-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #4A342A;
  letter-spacing: 2rpx;
  line-height: 1.2;
}
.go-record {
  margin-top: 4rpx;
  padding: 6rpx 20rpx;
  /* v63 新纪录火漆章（v65 提亮） */
  background: linear-gradient(180deg, #FFD54F, #FFB300);
  color: #5A3A10;
  font-size: 20rpx;
  font-weight: 800;
  border: 2rpx solid rgba(169, 106, 0, 0.75);
  border-radius: 14rpx 20rpx 16rpx 22rpx / 18rpx 14rpx 22rpx 16rpx;
  box-shadow: 0 3rpx 8rpx rgba(240, 168, 0, 0.35),
              inset 0 2rpx 0 rgba(255,255,255,0.65);
  animation: stamp-in 0.4s cubic-bezier(.2,.9,.2,1.2) 0.3s both;
}

/* 星级 */
.go-stars {
  flex-shrink: 0;
  display: flex;
  gap: 10rpx;
  margin: 10rpx 0 4rpx;
}
.go-star {
  font-size: 48rpx;
  line-height: 1;
  transition: all 0.3s ease;
}
.go-star.on {
  color: #FFB300;
  text-shadow: 0 2rpx 6rpx rgba(255,179,0,0.5);
  animation: starPop 0.6s cubic-bezier(.2,.9,.2,1.3);
}
.go-star.off {
  color: rgba(141,110,99,0.28);
}
@keyframes starPop {
  0%   { transform: scale(0.3) rotate(-30deg); opacity: 0; }
  60%  { transform: scale(1.25) rotate(10deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

/* 得分区 */
.go-score-row {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 4rpx 0 10rpx;
}
.go-score-label {
  font-size: 18rpx;
  color: #8D6E63;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.go-score-value {
  font-size: 66rpx;
  font-weight: 900;
  line-height: 1.05;
  /* v63：墨绿烙印分数 */
  background: linear-gradient(180deg, #2E6C12 0%, #3F9420 55%, #66C23A 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  font-variant-numeric: tabular-nums;
}

/* 4 项统计 2×2 */
.go-stats {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  justify-content: space-between;
  align-content: stretch;
  row-gap: 10rpx;          /* v59: 8→10 2×2 网格呼吸感 */
  column-gap: 8rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}
.go-stat {
  width: calc((100% - 8rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 13rpx 8rpx;     /* v59: 微增内边距, 儿童产品留白 */
  /* v63：小纸片统计格 */
  background: linear-gradient(180deg, #FFFDF5, #FBF3E2);
  border-radius: 12rpx 18rpx 14rpx 20rpx / 16rpx 12rpx 20rpx 14rpx;
  border: 2rpx solid rgba(74, 52, 42, 0.4);
  box-shadow: 1rpx 2rpx 0 rgba(74, 52, 42, 0.08);
  box-sizing: border-box;
}
.go-stat-num {
  font-size: 28rpx;
  font-weight: 900;
  color: #4A342A;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.go-stat-label {
  margin-top: 4rpx;   /* v59.1: 数值-标签主次行距 */
  font-size: 16rpx;
  color: #7A6450;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

/* 底部提示 */
.go-tip {
  flex-shrink: 0;
  font-size: 19rpx;   /* v59.1: 18→19 底部提示不再隐形 */
  color: #7A6450;
  line-height: 1.4;
  text-align: center;
  padding: 4rpx 12rpx 8rpx;
}

/* 操作按钮：两列并排 */
.go-actions {
  flex-shrink: 0;
  width: 100%;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 4rpx;
}
.go-actions .kawaii-btn {
  flex: 1 1 0;
  min-width: 0;
  padding: 16rpx 10rpx;
  font-size: 26rpx;
  border-width: 3rpx;
  box-shadow: none;
}
.go-actions .kawaii-btn-mint {
  box-shadow: 0 6rpx 0 #5FA886, 0 10rpx 20rpx rgba(123, 201, 166, 0.3),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.7);
}
.go-actions .kawaii-btn-ghost {
  border-width: 3rpx;
  color: #7A6450;                 /* v59→v63: 暖棕墨色，去「危险/惩罚」暗示 */
  border-color: rgba(74, 52, 42, 0.4);
  background: #FFFDF5;            /* v63: 纸签底 */
  box-shadow: 0 4rpx 0 rgba(74, 52, 42, 0.25), 0 8rpx 16rpx rgba(74, 52, 42, 0.12);
}
/* ============ v32: 亲子积分结算卡（结算浮层内，仅通关显示） ============ */
.go-reward {
  flex-shrink: 0;
  width: 100%;
  margin: 2rpx 0 8rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border: 2rpx solid #FFE082;
  border-radius: 18rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.9),
              0 3rpx 8rpx rgba(255,193,7,0.18);
  animation: rewardPop 0.5s cubic-bezier(.2,.9,.2,1.2) 0.25s both;
}
@keyframes rewardPop {
  0%   { opacity: 0; transform: scale(0.85) translateY(8rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}
.go-reward-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.go-reward-icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: #FFFFFF;
  border-radius: 50%;
  border: 2rpx solid #FFE082;
  box-shadow: 0 2rpx 6rpx rgba(255,179,0,0.25);
  animation: goTrophy 2.2s ease-in-out infinite;
}
.go-reward-main {
  flex: 1 1 auto;
  min-width: 0;
}
.go-reward-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #E65100;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}
.go-reward-detail {
  margin-top: 3rpx;
  font-size: 18rpx;                 /* v59: 17→18 结算明细可读性 */
  font-weight: 700;                 /* v32.1 VLM 建议：字重+颜色加深提高户外对比度 */
  color: #6D4C41;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.go-reward-unlock {
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 16rpx;
  font-weight: 700;
  text-align: center;
  color: #8A5B00;
  background: rgba(255,224,130,0.55);
  border-radius: 10rpx;
  line-height: 1.3;
}
/* v47: 败局努力积分卡片变体 — 暖绿（成长色, 呼应败局🌱）; 复用 rewardPop 入场动画 */
.go-reward--lose {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border-color: #A5D6A7;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.9),
              0 3rpx 8rpx rgba(76,175,80,0.15);
}
.go-reward--lose .go-reward-icon {
  border-color: #A5D6A7;
  box-shadow: 0 2rpx 6rpx rgba(76,175,80,0.22);
}
.go-reward--lose .go-reward-title {
  color: #2E7D32;
}
.go-reward--lose .go-reward-unlock {
  color: #33691E;
  background: rgba(165,214,167,0.45);
}
/* v36: 得分→积分换算条（结算卡内, 展示实际得分换算亲子积分） */
.go-reward-score {
  margin-top: 8rpx;
}
.go-rs-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1.2;
}
.go-rs-score {
  color: #6D4C41;
  font-variant-numeric: tabular-nums;
}
.go-rs-pts {
  color: #E65100;
  font-variant-numeric: tabular-nums;
}
.go-rs-bar {
  margin-top: 6rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255,224,130,0.45);
  overflow: hidden;
}
.go-rs-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #FFB300 0%, #FF8F00 100%);
  transition: width 0.6s ease;
}

/* ============ v61: 里程碑全屏彩带层 ============ */
/* 覆盖整页(HUD/商店/canvas/答题面板)的纯视觉庆祝层。
   fixed 锚定视口（.game-page 无 position, 不依赖祖先定位链）;
   pointer-events:none 与 suns-layer 同款 — 彩带飘落期间答题/收集完全不受影响 */
.confetti-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 60;               /* 高于固定答题面板(50), 低于结算浮层(90) */
  pointer-events: none;
  overflow: hidden;
}
.confetti-piece {
  position: absolute;
  top: -6%;                  /* 起点在视口上方, 落满全程 ~112vh */
  animation-name: confetti-fall-a;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  will-change: transform;
}
.confetti-strip { border-radius: 3rpx; }   /* 长条彩带 */
.confetti-dot { border-radius: 50%; }      /* 圆点纸屑 */
.confetti-emoji { font-size: 34rpx; line-height: 1; }   /* 星星 emoji 片 */
/* 三条下落路径: a 右摆 / b 左摆 / c S 弧线 — 旋转方向各异, 混出「漫天」感 */
.confetti-b { animation-name: confetti-fall-b; }
.confetti-c { animation-name: confetti-fall-c; }
@keyframes confetti-fall-a {
  0%   { transform: translate3d(0, 0, 0) rotate(0deg); opacity: 1; }
  100% { transform: translate3d(14vw, 112vh, 0) rotate(660deg); opacity: 0.85; }
}
@keyframes confetti-fall-b {
  0%   { transform: translate3d(0, 0, 0) rotate(0deg); opacity: 1; }
  100% { transform: translate3d(-14vw, 112vh, 0) rotate(-540deg); opacity: 0.85; }
}
@keyframes confetti-fall-c {
  0%   { transform: translate3d(0, 0, 0) rotate(0deg); opacity: 1; }
  50%  { transform: translate3d(9vw, 56vh, 0) rotate(300deg); opacity: 1; }
  100% { transform: translate3d(-6vw, 112vh, 0) rotate(240deg); opacity: 0.85; }
}
