/* pages/game/game.wxss - 游戏页样式 */

/*
 * 布局原理:
 *   不使用 100vh（含导航栏），改用 100%（page 高度 = windowHeight）
 *   flex column: hud(固定) + shop-bar(固定) + canvas-wrap(弹性flex:1) + quiz-wrap(固定)
 *   canvas-wrap 自动吸收剩余空间，实际 canvas 像素尺寸由 JS 通过
 *   SelectorQuery 实测 DOM 渲染尺寸后设置，避免手动计算累积误差导致底部裁切。
 */
.game-page {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #FFF5F8;
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
}

/* ============ HUD ============ */
.hud {
  flex-shrink: 0;
  background: linear-gradient(180deg, #FFE5EC 0%, #FFD1DC 50%, #D4C5F9 100%);
  border-bottom: 3rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 4rpx 12rpx rgba(243,139,168,0.16);
  padding: 6rpx 20rpx 10rpx;
}
.hud-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hud-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  overflow: hidden;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.65);
  border: 2rpx solid rgba(255,255,255,0.9);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.95);
}
.hud-label {
  font-size: 16rpx;
  color: #8D6E63;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 3rpx;
}
.hud-value {
  font-size: 28rpx;
  font-weight: 900;
  color: #5D4037;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.hud-score { flex: 1.2; }
.hud-lives { flex: 1.4; }
.hud-defense { flex: 1.4; }
.hud-combo { flex: 1; }
.hud-sunlight { flex: 1.1; }
.hud-sunlight .hud-value {
  display: flex;
  align-items: center;
  gap: 3rpx;
  color: #F9A825;
}
.sun-icon { font-size: 24rpx; }
.hud-combo.combo-active {
  background: linear-gradient(145deg, #FFF3B0, #FFD1DC);
  border-color: #F48FB1;
}
.combo-fire { font-size: 22rpx; }

.lives-row { display: flex; gap: 5rpx; }
.flower { font-size: 26rpx; line-height: 1; transition: transform 0.2s; }
.flower.on { filter: none; }
.flower.off { filter: grayscale(1) opacity(0.35); }

.hud-pause {
  padding: 4rpx;
  background: transparent;
  border: none;
  box-shadow: none;
}
.pause-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FFFFFF, #FFE5EC);
  border: 3rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #F48FB1;
  font-weight: 900;
  box-shadow: 0 4rpx 10rpx rgba(243,139,168,0.22);
}

/* ============ Canvas 区 ============ */
/* v13 关键：flex-shrink 大值让 canvas 在空间不足时优先自我收缩，
   保护 quiz-wrap（flex-shrink:0）永远完整显示所有答案选项。
   min-height 保底防止 canvas 被压缩到不可用。 */
.canvas-wrap {
  flex: 1 1 0;
  flex-shrink: 10000;     /* v13 空间不足时优先牺牲 canvas */
  min-height: 300rpx;    /* v13 保底：游戏区最低可用高度 */
  position: relative;
  background: linear-gradient(180deg, #FFF0F5, #E7DCFF);
  width: 100%;
}
.game-canvas {
  display: block;
}

/* ============ 可收集阳光 DOM 层（v3） ============ */
.suns-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 15;
}
.sun-coin {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  pointer-events: auto;
  will-change: transform, opacity, left, top;
}
.sun-coin-inner {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #FFF6C7 0%, #FFD95A 55%, #F0A830 100%);
  box-shadow: 0 6rpx 14rpx rgba(230, 160, 40, 0.35), inset 0 -4rpx 10rpx rgba(180, 110, 10, 0.3), inset 0 4rpx 10rpx rgba(255,255,255,0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}
.sun-emoji {
  font-size: 44rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 2rpx rgba(160, 90, 10, 0.25));
}
.sun-value-label {
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  font-weight: 700;
  color: #B97918;
  text-shadow: 0 2rpx 0 rgba(255,255,255,0.6);
  white-space: nowrap;
  pointer-events: none;
}
.sun-coin-collected {
  transition: none; /* 动画由 setData 的 style 控制每帧插值 */
  pointer-events: none;
}
/* 基础呼吸/飘动：在 setData 每帧刷新位置的基础上再叠加微小柔和颤动 */
.sun-coin:not(.sun-coin-collected) {
  animation: sun-float 1.8s ease-in-out infinite;
}
@keyframes sun-float {
  0%, 100% { filter: drop-shadow(0 2rpx 3rpx rgba(230, 160, 40, 0.35)); }
  50%      { filter: drop-shadow(0 6rpx 10rpx rgba(245, 190, 60, 0.6)); }
}

/* ============ 暂停遮罩 ============ */
.pause-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}
.pause-card {
  width: 70%;
  text-align: center;
  padding: 48rpx 32rpx;
}
.pause-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #5D4037;
  margin-bottom: 12rpx;
}
.pause-tip {
  font-size: 24rpx;
  color: #8D6E63;
  margin-bottom: 32rpx;
}
.pause-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.pause-actions .kawaii-btn {
  width: 100%;
  font-size: 30rpx;
  padding: 20rpx 0;
}

/* ============ 答题面板（v14 结构性修复） ============ */
/* position:fixed 钉死在视口底部，脱离文档流：
   无论上方 HUD/商店栏/Canvas 发生任何布局异常，
   4 个答案选项都完整可见——这是物理保证，不依赖 flex 链路。 */
.quiz-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  z-index: 50;
  background: #FFF5F8;   /* 兜底底色，防止透出 canvas */
}

/* 占位元素：高度由 JS 实测面板高度填充，为 fixed 面板腾出文档流空间 */
.quiz-spacer {
  flex: 0 0 auto;
  width: 100%;
}

/* ============ 植物商店栏 ============ */
.shop-bar {
  flex-shrink: 0;
  height: 96rpx;
  background: linear-gradient(180deg, rgba(255,243,224,0.95) 0%, rgba(255,224,178,0.95) 100%);
  border-top: 2rpx solid rgba(255,255,255,0.85);
  border-bottom: 2rpx solid rgba(243,139,168,0.25);
  padding: 6rpx 10rpx 4rpx;
  box-sizing: border-box;
  position: relative;
}
.shop-scroll {
  white-space: nowrap;
  height: 72rpx;
}
.shop-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 72rpx;
  margin-right: 8rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #FFFFFF, #FFF8E1);
  border: 2rpx solid #FFE0B2;
  box-shadow: 0 2rpx 0 rgba(243,139,168,0.15);
  vertical-align: top;
  transition: transform 0.12s ease, border-color 0.15s ease;
}
.shop-item.selected {
  border-color: #F48FB1;
  background: linear-gradient(145deg, #FFD1DC, #FFE5EC);
  transform: translateY(-2rpx);
  box-shadow: 0 5rpx 10rpx rgba(244,143,177,0.35);
}
.shop-item.disabled {
  opacity: 0.45;
  filter: grayscale(0.4);
}
/* ===== 商店栏：纯 CSS 萌系植物头像（设计系统 Tokens v2 - 与 Canvas 1:1 对齐）
   - 眼睛比例：eyeDX=36% headR · eyeR=24% headR（精确 RENDER_TOKENS.FACE）
   - 瞳孔位置：右下 16/12%（Canvas pOffX/Y 同）
   - 腮红位置：X=±62% headR · 底部距离= 70%（Canvas cy+0.38r 对应）
   - 高光统一左上 45°：top 14% · left 18% · 椭圆 -40deg
   - 色彩：全部从 RENDER_TOKENS.COLORS 取值（Hex 值严格对应）
=================================================================== */
/* ---- 1. 共用头部（与 Canvas head ellipse 同色板） ---- */
.shop-avatar {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto;
}
.shop-avatar .sa-head {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: #7CB342;
  border: 2rpx solid #FFFFFF;
  box-shadow: inset -7rpx -7rpx 0 rgba(0,0,0,0.10),
              0 2rpx 4rpx rgba(124,179,66,0.40);
}
/* 统一高光：左上 45°，与 Canvas HEAD.HLIGHT_X/Y/W/H/ROT 精确对应（比例相同） */
.shop-avatar .sa-head::after {
  content: '';
  position: absolute;
  top: 14%;
  left: 18%;
  width: 28%;
  height: 42%;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);   /* RENDER_TOKENS HEAD.HLIGHT_ALPHA */
  transform: rotate(-40deg);            /* RENDER_TOKENS HEAD.HLIGHT_ROT */
}

/* ---- 2. 顶部/左右装饰（按类型差异化） ---- */
.shop-avatar .sa-deco-top {
  position: absolute;
  left: 50%;
  top: -14%;
  transform: translateX(-50%);
  width: 58%;
  height: 26%;
  border-radius: 50%;
  background: #33691E;       /* S_MOUTH_IN */
  border: 2.5rpx solid #FFFFFF;   /* v3 2→2.5 加粗描边 */
}
.shop-avatar .sa-deco-top::after {
  content: '';
  position: absolute;
  left: 50%;
  top: -55%;
  transform: translateX(-50%);
  width: 56%;
  height: 90%;
  border-radius: 50%;
  background: #C5E1A5;       /* S_PEA_LIGHT */
  border: 2.5rpx solid #FFFFFF;  /* v3 加粗 */
  box-shadow: inset -3rpx -3rpx 0 rgba(255,255,255,0.35);
}
.shop-avatar .sa-deco-left,
.shop-avatar .sa-deco-right {
  position: absolute;
  bottom: -8%;
  width: 46%;
  height: 30%;
  border-radius: 50%;
  background: #9CCC65;       /* S_LEAF_MID */
  border: 2.5rpx solid #FFFFFF;  /* v3 2→2.5 加粗 */
}
.shop-avatar .sa-deco-left  { left: -18%; transform: rotate(-28deg); }
.shop-avatar .sa-deco-right { right: -18%; transform: rotate(28deg); }

/* ---- 3. 眼睛系统：严格对齐 RENDER_TOKENS.FACE ----
   FACE: EYE_DX_RATIO=0.36 · EYE_R_RATIO=0.24
   换算 %：眼中心 X 距离中心 36% → left = 50-36-24 = -10% + 单位头宽内？
   在 56rpx 圆头像（= 1×headR）中：
     eyeR = 24% × head diameter = 48% × headR（diameter=2R），所以宽度 48%？
     哦，CSS 的 % 是相对于父元素（shop-avatar）宽度（即直径 = 2R），
     Canvas 里的 eyeR = 0.24 R（半径），所以 eye 宽度 = 0.48 R = 24% of (直径 2R)。
     宽度/高度各 24%（眼睛正圆直径 2×eyeR = 48% R → 24% of 直径宽）。
     中心距离：eyeDX = 0.36 R = 18% of 直径。即左眼中心在 50% - 18% = 32%。
     所以 sa-eye-l left = 32% - 12%(半宽) = 20%
     Canvas 眼 Y：eyeY = headR×0.08（头中心偏下 0.08 直径=4% of 直径）
     所以 sa-eye top = 50% - 12%(半高) + 4% = 42%。改到 42%。
   ==============================================================================*/
.shop-avatar .sa-eye {
  position: absolute;
  top: 42%;             /* 精确 T.FACE: eyeY=cy+0.08R（中心 50% → 顶部 42%） */
  width: 24%;
  height: 24%;          /* 正圆眼（0.24R×2 = 24% of 直径） */
  border-radius: 50%;
  background: #FFFFFF;  /* T.COLORS.STROKE (眼白) */
  border: 2rpx solid #FFFFFF;   /* v3 加粗 1.5→2rpx（眼白描边在 56rpx 下必须锐利） */
}
.shop-avatar .sa-eye-l { left: 20%; }  /* = 中心距 18% + 半宽 12% → 左缘 20% */
.shop-avatar .sa-eye-r { right: 20%; } /* 镜像 */
/* 瞳孔：偏右下（v3 放大 56% → 60%，小尺寸更醒目；右下偏 16/14 保留） */
.shop-avatar .sa-pupil {
  position: absolute;
  right: 16%;           /* PUPIL_OFF_X = 0.16 eyeR → 16% of 眼宽 */
  bottom: 14%;          /* PUPIL_OFF_Y = 0.14 eyeR → 14% of 眼高 */
  width: 60%;           /* v3 56% → 60%，小尺寸不糊 */
  height: 60%;
  border-radius: 50%;
  background: #4E342E;  /* T.COLORS.INK */
}
/* 双高光：两颗 · 大 42% pupil + 小 18% pupil（sh1 左上, sh2 右下）—— 依然保留，灵动灵魂 */
.shop-avatar .sa-shine {
  position: absolute;
  left: 22%;
  top: 16%;
  width: 26%;
  height: 26%;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 14rpx 22rpx 0 -2rpx #FFFFFF;   /* 第二颗小高光 */
}

/* ---- 4. 腮红：v3 爱心 → 实心圆（56rpx 下 before/after 爱心边缘糊成锯齿，平涂圆更干净）
   仍保持 left/right 11%（BLUSH_CX=62%R），bottom 22% 对齐 mouth 上方
================================================================================== */
.shop-avatar .sa-blush {
  position: absolute;
  bottom: 22%;
  width: 18%;            /* v3 16% → 18% 略放大（圆比爱心面积小） */
  height: 14%;           /* v3 10% → 14% 正圆直径 */
  border-radius: 50%;    /* v3 爱心贝塞尔 → 纯圆 */
  background: rgba(255,150,170,0.70);   /* v3 0.65→0.70 小尺寸对比更强 */
}
/* 删除 before/after 双爱心伪元素（56rpx 下糊） */
.shop-avatar .sa-blush::before,
.shop-avatar .sa-blush::after { display: none; }
.shop-avatar .sa-blush-l { left: 11%; }
.shop-avatar .sa-blush-r { right: 11%; }

/* ---- 5. 嘴：v3 线条 2.2rpx → 2.8rpx 加粗（小尺寸仍锐利）
============================================================= */
.shop-avatar .sa-mouth {
  position: absolute;
  left: 50%;
  bottom: 18%;
  transform: translateX(-50%);
  width: 24%;
  height: 12%;
  border: 2.8rpx solid #4E342E;    /* T.STROKE.INK · 2.2→2.8 +27% */
  border-top: none;
  border-left: none;
  border-right: none;
  border-radius: 0 0 60% 60% / 0 0 100% 100%;
}

/* ===== 3 种植物差异化（色板严格取自 RENDER_TOKENS.COLORS） ===== */
/* 豌豆 shooter */
.shop-avatar.shop-avatar-shooter .sa-head { background: #7CB342; box-shadow: inset -8rpx -8rpx 0 rgba(0,0,0,0.08),0 2rpx 6rpx rgba(124,179,66,0.35); }
.shop-avatar.shop-avatar-shooter .sa-deco-top         { background: #558B2F; }  /* S_MOUTH_OUT */
.shop-avatar.shop-avatar-shooter .sa-deco-top::after   { background: #C5E1A5; }  /* S_PEA_LIGHT */
.shop-avatar.shop-avatar-shooter .sa-deco-left,
.shop-avatar.shop-avatar-shooter .sa-deco-right { background: #AED581; }         /* S_LEAF_DARK */
.shop-avatar.shop-avatar-shooter .sa-mouth { /* grin 露齿笑 */
  background: #E91E63;                  /* T.COLORS.MOUTH_PINK */
  border-top: none;
  border-left: 2.8rpx solid #FFFFFF;    /* v3 2.2→2.8 加粗唇描边 */
  border-right: 2.8rpx solid #FFFFFF;
  border-bottom: 2.8rpx solid #FFFFFF;  /* T.STROKE.LIP */
  border-radius: 0 0 50% 50% / 0 0 100% 100%;
  width: 32%;
  height: 16%;
  bottom: 16%;
}
.shop-avatar.shop-avatar-shooter .sa-mouth::after { /* 白牙齿 */
  content: '';
  position: absolute;
  left: 20%;
  top: -2rpx;
  width: 60%;
  height: 38%;
  background: #FFFFFF;                  /* T.COLORS.STROKE */
  border-radius: 0 0 50% 50%;
}

/* 坚果 wall - 色板取自 T.COLORS.W_*
   v3 简化：壳纹 3 条→2 条粗横纹；嫩芽 3→1 颗中间（删两侧伪元素），小尺寸识别度更高 */
.shop-avatar.shop-avatar-wall .sa-head {
  background: #A1887F;
  border-radius: 46%;                   /* 坚果圆头，与 Canvas ellipse 1.0/1.05 同比例 */
  box-shadow: inset -8rpx -8rpx 0 rgba(0,0,0,0.14),0 2rpx 6rpx rgba(161,136,127,0.40);
}
/* 坚果两条粗横纹（3→2）：删除 top 一条，只留 middle+bottom 两条（间距更大，一眼识别） */
.shop-avatar.shop-avatar-wall .sa-head::before {
  content: '';
  position: absolute;
  left: 20%;
  right: 20%;
  top: 34%;
  height: 36%;
  /* v3 只留中间线 + 底线，2 条粗纹（删除 border-top） */
  border-bottom: 2.5rpx solid rgba(109,76,65,0.40);    /* v3 加粗 2rpx→2.5rpx，α 0.35→0.40 更黑 */
  z-index: 0;
  box-sizing: border-box;
  padding-top: 18%;
  /* 第二条中线：用背景线性渐变画，比 border 定位更精确 */
  background-image: linear-gradient(rgba(109,76,65,0.40), rgba(109,76,65,0.40));
  background-position: left center;
  background-repeat: no-repeat;
  background-size: 100% 2.5rpx;
}
/* 坚果无侧叶 */
.shop-avatar.shop-avatar-wall .sa-deco-left,
.shop-avatar.shop-avatar-wall .sa-deco-right { display: none; }
/* 顶部嫩芽：v3 只留中央 1 颗大嫩芽（删除 ::before/::after 两侧），核心特征更集中 */
.shop-avatar.shop-avatar-wall .sa-deco-top {
  background: #81C784;                  /* W_SPROUT_LIGHT */
  width: 28%;                           /* v3 24% → 28%，放大单颗辨识度 */
  height: 42%;                          /* v3 36% → 42%，更高更醒目 */
  border-radius: 48%;
  top: -26%;                            /* v3 -22% → -26% 再上移，不压头 */
  transform: translateX(-50%) rotate(0deg);
}
.shop-avatar.shop-avatar-wall .sa-deco-top::before,
.shop-avatar.shop-avatar-wall .sa-deco-top::after {
  display: none;                        /* v3 删除两侧小嫩芽（原 130% 偏移的两颗） */
}
/* 坚果浓腮红 */
.shop-avatar.shop-avatar-wall .sa-blush-l,
.shop-avatar.shop-avatar-wall .sa-blush-r {
  background: rgba(244,143,177,0.82);   /* T.COLORS.BLUSH_RICH · v3 α 0.78→0.82 */
}

/* 寒冰 freezer - 色板取自 T.COLORS.F_*
   v3 简化：删除雪花/柔光；保留"发射口椭圆 + 顶菱形冰晶 + 冰晶十字纹"三件套识别
   v3 阵营区分：clip-path 六边形头部（与 Canvas 冰晶头一致，区别于射手圆头） */
.shop-avatar.shop-avatar-freezer .sa-head { background: #4FC3F7; box-shadow: inset -8rpx -8rpx 0 rgba(0,0,0,0.06),0 2rpx 6rpx rgba(79,195,247,0.35); border-radius: 38%; }
.shop-avatar.shop-avatar-freezer .sa-deco-left,
.shop-avatar.shop-avatar-freezer .sa-deco-right { background: #80DEEA; }  /* F_LEAF_MID */
.shop-avatar.shop-avatar-freezer .sa-deco-top {
  background: #0277BD;                  /* F_MOUTH_OUT */
  width: 58%;                           /* v3 54% → 58%，发射口放大（核心识别） */
  height: 24%;                          /* v3 22% → 24% */
  top: -10%;
  border-width: 2.5rpx;                 /* v3 2rpx → 2.5rpx */
}
/* 顶部菱形冰晶（加粗描边 2→2.5rpx，略放大，小尺寸必须一眼看见"冰晶"） */
.shop-avatar.shop-avatar-freezer .sa-deco-top::after {
  content: '';
  position: absolute;
  left: 50%;
  top: -175%;                           /* v3 -160% → -175% 略放大冰晶 */
  transform: translateX(-50%) rotate(45deg);
  width: 50%;                           /* v3 46% → 50% */
  height: 280%;                         /* v3 260% → 280% */
  background: #E1F5FE;                  /* F_CRYSTAL */
  border-radius: 14%;
  border: 2.5rpx solid #FFFFFF;         /* v3 2 → 2.5rpx 加粗 */
  box-shadow: none;
}
/* 冰晶十字纹（加粗 inset 1.5 → 2rpx） */
.shop-avatar.shop-avatar-freezer .sa-deco-top::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -160%;
  transform: translateX(-50%);
  width: 24%;                           /* v3 22% → 24% 更宽 */
  height: 255%;                         /* v3 230% → 255% 更长 */
  z-index: 1;
  pointer-events: none;
  box-shadow: inset 2rpx 0 0 #FFFFFF, inset -2rpx 0 0 #FFFFFF; /* v3 1.5→2rpx 加粗十字 */
}
/* 冰蓝腮红 */
.shop-avatar.shop-avatar-freezer .sa-blush-l,
.shop-avatar.shop-avatar-freezer .sa-blush-r {
  background: rgba(120,200,255,0.62);   /* T.COLORS.BLUSH_COOL · v3 α 0.58→0.62 */
}
/* O 型张嘴 */
.shop-avatar.shop-avatar-freezer .sa-mouth {
  width: 20%;
  height: 20%;
  background: #E91E63;                  /* T.COLORS.MOUTH_PINK */
  border: 2.8rpx solid #FFFFFF;         /* T.STROKE.LIP · 2.2→2.8rpx */
  border-radius: 50%;
  bottom: 18%;
  box-shadow: inset 0 -4.5rpx 0 #F48FB1; /* T.COLORS.MOUTH_LIP · 下唇高光 4→4.5rpx 加粗 */
}
.shop-avatar.shop-avatar-freezer .sa-mouth::before,
.shop-avatar.shop-avatar-freezer .sa-mouth::after {
  display: none;
}

/* 樱桃炸弹 cherry - 色板取自 T.COLORS.C_*
   核心识别：双红球 + 绿色茎/引线 + 火花 */
.shop-avatar.shop-avatar-cherry .sa-head {
  background: #E53935;                  /* C_BODY */
  border-radius: 48%;
  box-shadow: inset -8rpx -8rpx 0 rgba(0,0,0,0.12),0 2rpx 6rpx rgba(229,57,53,0.40);
}
/* 右樱桃（主表情，略大）—— 替换 sa-head 默认 render */
.shop-avatar.shop-avatar-cherry .sa-head::after {
  display: none;
}
/* 左樱桃（靠后，略小）—— 用 sa-deco-left 改造 */
.shop-avatar.shop-avatar-cherry .sa-deco-left {
  left: -36%;
  bottom: 10%;
  width: 70%;
  height: 70%;
  border-radius: 50%;
  background: #C62828;                  /* C_BODY_DARK */
  border: 3rpx solid #FFFFFF;
  transform: none;
  box-shadow: inset -6rpx -6rpx 0 rgba(0,0,0,0.10);
  z-index: -1;
}
/* 左樱桃简易表情（单眼+迷你腮红，不抢主表情） */
.shop-avatar.shop-avatar-cherry .sa-deco-left::after {
  content: '';
  position: absolute;
  left: 20%;
  top: 25%;
  width: 26%;
  height: 26%;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 16rpx 0 0 0 #FFFFFF;
}
.shop-avatar.shop-avatar-cherry .sa-deco-right {
  display: none;
}
/* 绿色引线/茎（从顶部伸出，弯曲） */
.shop-avatar.shop-avatar-cherry .sa-deco-top {
  background: #7CB342;                  /* C_FUSE */
  width: 18%;
  height: 70%;
  border-radius: 40%;
  top: -62%;
  transform: translateX(-50%) rotate(8deg);
  border-width: 2.5rpx;
}
.shop-avatar.shop-avatar-cherry .sa-deco-top::after {
  /* 顶部小叶子 */
  content: '';
  position: absolute;
  left: 50%;
  top: -30%;
  transform: translateX(-50%) rotate(30deg);
  width: 160%;
  height: 40%;
  border-radius: 50%;
  background: #66BB6A;                  /* C_LEAF */
  border: 2.5rpx solid #FFFFFF;
}
/* 火花（引信末端闪烁星，CSS 动画模拟） */
.shop-avatar.shop-avatar-cherry .sa-deco-top::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -80%;
  transform: translateX(-50%) rotate(45deg);
  width: 40%;
  height: 90%;
  background: #FFEB3B;                  /* C_SPARK */
  border-radius: 2rpx;
  animation: cherry-spark 0.35s ease-in-out infinite alternate;
  z-index: 2;
}
@keyframes cherry-spark {
  0% { opacity: 0.4; transform: translateX(-50%) rotate(45deg) scale(0.6); }
  100% { opacity: 1; transform: translateX(-50%) rotate(45deg) scale(1.1); }
}
/* 樱桃愤怒表情（grin 露齿 + 浓腮红） */
.shop-avatar.shop-avatar-cherry .sa-mouth {
  width: 32%;
  height: 16%;
  background: #E91E63;
  border: 2.8rpx solid #FFFFFF;
  border-radius: 0 0 50% 50% / 0 0 100% 100%;
  bottom: 16%;
}
.shop-avatar.shop-avatar-cherry .sa-mouth::after {
  content: '';
  position: absolute;
  left: 20%;
  top: -2rpx;
  width: 60%;
  height: 38%;
  background: #FFFFFF;
  border-radius: 0 0 50% 50%;
}
.shop-avatar.shop-avatar-cherry .sa-blush-l,
.shop-avatar.shop-avatar-cherry .sa-blush-r {
  background: rgba(244,143,177,0.82);   /* BLUSH_RICH */
}

/* 向日葵 sunflower - 核心识别：棕色花盘 + 周身金黄色花瓣
   色板：花盘 #8D6E63（棕），花瓣 #FFD54F（金黄），内心 #FFF8E1（亮黄） */
.shop-avatar.shop-avatar-sunflower .sa-head {
  background: #FFD54F;                   /* 花瓣主色：金黄圆头 */
  box-shadow: inset -6rpx -6rpx 0 rgba(230,150,0,0.22),0 2rpx 6rpx rgba(255,213,79,0.45);
}
/* 花盘：中央大棕色圆（种子区），占据头部中心 */
.shop-avatar.shop-avatar-sunflower .sa-head::before {
  content: '';
  position: absolute;
  left: 18%; right: 18%;
  top: 18%; bottom: 18%;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, #A1887F 0%, #8D6E63 70%);
  z-index: 0;
}
/* 顶部装饰改为花芯小圆（亮黄点缀，替代豌豆的发射口） */
.shop-avatar.shop-avatar-sunflower .sa-deco-top {
  background: #FFB300;                   /* 花芯亮橙 */
  width: 34%;
  height: 34%;
  top: -16%;
  border-radius: 50%;
  border: 2.5rpx solid #FFFFFF;
}
.shop-avatar.shop-avatar-sunflower .sa-deco-top::after { display: none; }
.shop-avatar.shop-avatar-sunflower .sa-deco-top::before { display: none; }
/* 侧叶改为小花瓣（金黄，比射手叶子更圆润上翘） */
.shop-avatar.shop-avatar-sunflower .sa-deco-left,
.shop-avatar.shop-avatar-sunflower .sa-deco-right {
  background: #FFCA28;                  /* 花瓣层次色 */
  width: 50%;
  height: 34%;
  bottom: -10%;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
}
.shop-avatar.shop-avatar-sunflower .sa-deco-left  { transform: rotate(-38deg); }
.shop-avatar.shop-avatar-sunflower .sa-deco-right { transform: rotate(38deg); }
/* 眼睛/瞳孔/高光浮于花盘之上 */
.shop-avatar.shop-avatar-sunflower .sa-eye,
.shop-avatar.shop-avatar-sunflower .sa-pupil,
.shop-avatar.shop-avatar-sunflower .sa-shine,
.shop-avatar.shop-avatar-sunflower .sa-blush,
.shop-avatar.shop-avatar-sunflower .sa-mouth { z-index: 2; }
/* 腮红偏橙（暖色系，匹配花盘） */
.shop-avatar.shop-avatar-sunflower .sa-blush-l,
.shop-avatar.shop-avatar-sunflower .sa-blush-r {
  background: rgba(255,152,90,0.55);
}
/* 微笑小嘴（弧线，暖棕） */
.shop-avatar.shop-avatar-sunflower .sa-mouth {
  border-color: #6D4C41;
}

/* 食人花 chomper - 核心识别：紫色大圆头 + 尖刺 + 张嘴獠牙
   色板：头 #AB47BC（紫），内唇 #6A1B9A（深紫），獠牙 #FFFFFF */
.shop-avatar.shop-avatar-chomper .sa-head {
  background: #AB47BC;                   /* 紫色大圆头 */
  box-shadow: inset -8rpx -8rpx 0 rgba(74,20,110,0.30),0 2rpx 6rpx rgba(171,71,188,0.40);
}
/* 头顶尖刺：用顶部装饰改造成 3 根三角刺（clip-path 锥形） */
.shop-avatar.shop-avatar-chomper .sa-deco-top {
  background: #7B1FA2;                   /* 深紫刺 */
  width: 20%;
  height: 34%;
  top: -30%;
  border-radius: 0;
  border: none;
  transform: translateX(-50%);
  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
}
.shop-avatar.shop-avatar-chomper .sa-deco-top::after { display: none; }
.shop-avatar.shop-avatar-chomper .sa-deco-top::before { display: none; }
/* 侧叶：深绿（食人花带毒的深色叶片，比射手叶子下垂尖锐） */
.shop-avatar.shop-avatar-chomper .sa-deco-left,
.shop-avatar.shop-avatar-chomper .sa-deco-right {
  background: #558B2F;                   /* 深绿叶 */
  width: 44%;
  height: 30%;
  bottom: -8%;
  border-radius: 50% 50% 50% 50% / 30% 30% 70% 70%;
}
.shop-avatar.shop-avatar-chomper .sa-deco-left  { transform: rotate(-16deg); }
.shop-avatar.shop-avatar-chomper .sa-deco-right { transform: rotate(16deg); }
/* 邪魅眯眯眼（瞳孔缩小，显得凶狠） */
.shop-avatar.shop-avatar-chomper .sa-pupil {
  width: 46%;
  height: 46%;
}
/* 凶狠眉毛：用眼睛上方的细条模拟（深紫） */
.shop-avatar.shop-avatar-chomper .sa-eye::before {
  content: '';
  position: absolute;
  left: -10%;
  top: -30%;
  width: 120%;
  height: 34%;
  border-radius: 4rpx;
  background: #4A148C;                   /* 深紫眉 */
  transform: rotate(-8deg);
}
.shop-avatar.shop-avatar-chomper .sa-eye-r::before { transform: rotate(8deg); }
/* 张嘴獠牙：大嘴（深紫口腔）+ 上下白獠牙 */
.shop-avatar.shop-avatar-chomper .sa-mouth {
  width: 42%;
  height: 22%;
  background: #6A1B9A;                   /* 深紫口腔 */
  border: 2.5rpx solid #FFFFFF;
  border-radius: 20% 20% 45% 45% / 20% 20% 80% 80%;
  bottom: 14%;
}
/* 上獠牙（2颗三角尖牙，倒置向下） */
.shop-avatar.shop-avatar-chomper .sa-mouth::after {
  content: '';
  position: absolute;
  left: 12%; right: 12%;
  top: -1rpx;
  height: 46%;
  background:
    radial-gradient(circle at 22% 100%, #FFFFFF 0 32%, transparent 34%),
    radial-gradient(circle at 78% 100%, #FFFFFF 0 32%, transparent 34%);
  z-index: 1;
}
/* 下獠牙（1颗大尖牙，向上） */
.shop-avatar.shop-avatar-chomper .sa-mouth::before {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 26%;
  height: 40%;
  background: #FFFFFF;
  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  z-index: 1;
}
/* 无腮红（食人花凶狠，不需要可爱腮红） */
.shop-avatar.shop-avatar-chomper .sa-blush-l,
.shop-avatar.shop-avatar-chomper .sa-blush-r {
  display: none;
}

/* 选中/禁用 状态（与 Tokens 联动） */
.shop-item.selected .shop-avatar {
  transform: scale(1.12) rotate(-3deg);
}
.shop-item.disabled .shop-avatar {
  filter: grayscale(0.5) opacity(0.6);
}

.shop-emoji {
  font-size: 28rpx;
  line-height: 1;
}
.shop-name {
  font-size: 14rpx;
  color: #6D4C41;
  font-weight: 700;
  line-height: 1.1;
  margin-top: 1rpx;
}
.shop-cost {
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 13rpx;
  color: #F9A825;
  font-weight: 800;
  line-height: 1;
  margin-top: 1rpx;
}
.shop-cost-icon { font-size: 14rpx; }
/* 植物选择提示浮层：柔和低饱和风格，悬浮于 canvas 顶部居中，不占布局空间 */
.plant-tip-toast {
  position: absolute;
  left: 50%;
  top: 18rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 30rpx;
  max-width: 80%;
  font-size: 25rpx;
  font-weight: 500;
  color: #3E4A3F;
  text-align: center;
  letter-spacing: 0.6rpx;
  line-height: 1.35;
  background-color: rgba(232, 237, 228, 0.92);
  border: 1rpx solid rgba(145, 153, 130, 0.30);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 14rpx rgba(63, 71, 55, 0.12),
              0 1rpx 2rpx rgba(255, 255, 255, 0.45) inset;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  animation: tipFadeIn 220ms ease-out both;
  z-index: 20;
  pointer-events: none;
}
.plant-tip-emoji {
  font-size: 26rpx;
  opacity: 0.82;
  filter: saturate(0.85);
}
@keyframes tipFadeIn {
  0%   { opacity: 0; transform: translate(-50%, -10rpx); }
  100% { opacity: 1; transform: translate(-50%, 0); }
}

/* ============ 游戏结束结算浮层（一屏 100%，居中卡片，禁止滚动） ============ */
.gameover-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.48);
  backdrop-filter: blur(3rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  z-index: 90;   /* v14 高于 fixed 答题面板(50)，结算时完全覆盖 */
  animation: fadeIn 0.32s ease-out;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.gameover-card {
  width: 100%;
  max-width: 640rpx;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,248,250,0.98) 100%);
  border-radius: 40rpx;
  border: 5rpx solid rgba(255,255,255,0.98);
  box-shadow:
    0 20rpx 48rpx rgba(243,139,168,0.28),
    inset 0 3rpx 0 rgba(255,255,255,0.95);
  animation: cardPop 0.42s cubic-bezier(.2,.9,.2,1.15);
}
@keyframes cardPop {
  0%   { opacity: 0; transform: scale(0.72) translateY(20rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

/* 头部：emoji + 标题 + 破纪录徽章 */
.go-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.go-emoji {
  font-size: 82rpx;
  line-height: 1;
  animation: goTrophy 2.6s ease-in-out infinite;
}
@keyframes goTrophy {
  0%, 100% { transform: translateY(0) rotate(-5deg); }
  50%      { transform: translateY(-8rpx) rotate(5deg); }
}
.go-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #5D4037;
  letter-spacing: 2rpx;
  line-height: 1.2;
}
.go-record {
  margin-top: 4rpx;
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #FFE082, #FFB300);
  color: #5D4037;
  font-size: 20rpx;
  font-weight: 800;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(255,179,0,0.35),
              inset 0 2rpx 0 rgba(255,255,255,0.7);
}

/* 星级 */
.go-stars {
  flex-shrink: 0;
  display: flex;
  gap: 10rpx;
  margin: 10rpx 0 4rpx;
}
.go-star {
  font-size: 48rpx;
  line-height: 1;
  transition: all 0.3s ease;
}
.go-star.on {
  color: #FFB300;
  text-shadow: 0 2rpx 6rpx rgba(255,179,0,0.5);
  animation: starPop 0.6s cubic-bezier(.2,.9,.2,1.3);
}
.go-star.off {
  color: rgba(141,110,99,0.28);
}
@keyframes starPop {
  0%   { transform: scale(0.3) rotate(-30deg); opacity: 0; }
  60%  { transform: scale(1.25) rotate(10deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

/* 得分区 */
.go-score-row {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 4rpx 0 10rpx;
}
.go-score-label {
  font-size: 18rpx;
  color: #8D6E63;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.go-score-value {
  font-size: 66rpx;
  font-weight: 900;
  line-height: 1.05;
  background: linear-gradient(180deg, #2F5312 0%, #4C8B2A 55%, #7BC86A 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  font-variant-numeric: tabular-nums;
}

/* 4 项统计 2×2 */
.go-stats {
  width: 100%;
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  justify-content: space-between;
  align-content: stretch;
  row-gap: 8rpx;
  column-gap: 8rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}
.go-stat {
  width: calc((100% - 8rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 6rpx;
  background: linear-gradient(180deg, #FFFFFF, #FFF7FA);
  border-radius: 18rpx;
  border: 2rpx solid #FFE5EC;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.95),
              0 3rpx 6rpx rgba(243,139,168,0.08);
  box-sizing: border-box;
}
.go-stat-num {
  font-size: 28rpx;
  font-weight: 900;
  color: #5D4037;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.go-stat-label {
  margin-top: 2rpx;
  font-size: 16rpx;
  color: #A1887F;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

/* 底部提示 */
.go-tip {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #8D6E63;
  line-height: 1.4;
  text-align: center;
  padding: 4rpx 12rpx 8rpx;
}

/* 操作按钮：两列并排 */
.go-actions {
  flex-shrink: 0;
  width: 100%;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 4rpx;
}
.go-actions .kawaii-btn {
  flex: 1 1 0;
  min-width: 0;
  padding: 16rpx 10rpx;
  font-size: 26rpx;
  border-width: 3rpx;
  box-shadow: none;
}
.go-actions .kawaii-btn-mint {
  box-shadow: 0 6rpx 0 #5FA886, 0 10rpx 20rpx rgba(123, 201, 166, 0.3),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.7);
}
.go-actions .kawaii-btn-ghost {
  border-width: 3rpx;
  color: #C2185B;
  border-color: #F48FB1;
  background: #FFFFFF;
  box-shadow: 0 4rpx 0 rgba(244, 143, 177, 0.35), 0 8rpx 16rpx rgba(243, 139, 168, 0.15);
}
