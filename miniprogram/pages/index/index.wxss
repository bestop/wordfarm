/* pages/index/index.wxss — v70 布局回调（v69 插画版基础上的反馈调整）
   v70 更新：
   - 导航牌匾「单词农场」加大（36rpx/加宽内衬）并整体下移
   - 右侧 ⚙️ 钮避让宽度改由 JS 按胶囊【左缘】计算（navRightInset），不再被小程序胶囊遮挡
   - 大冒险卡改纵向两段：上段（左插画 + 右文案/2×2 白胶囊）+ 下段（卡内「开始冒险」主按钮
     + 右下角红浆果「奖励中心」）
   - 玩法徽章 ac-chips 改 grid 两列，四个标签严格两排两列（不再依赖 calc/换行）
   - 取消 start-wrap / tuft / blade 与页缘 reward-fab 绝对定位浮层
   - km-* 弹窗 / pack-bar / hud-strip / hero-banner / diff-pills 样式自 v69 原样保留
   v7 设计 tokens：字号 5 级 / 圆角 3 级 / 间距 3 级 / 文本色 3 级
*/

/* ========== 页面容器（v69：PvZ 鲜绿草坪渐变 + 晨光晕） ========== */
.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background:
    radial-gradient(120% 55% at 50% -4%, #F6FFD0 0%, rgba(246, 255, 208, 0) 52%),
    radial-gradient(80% 40% at 50% 108%, rgba(140, 205, 80, 0.5) 0%, rgba(140, 205, 80, 0) 60%),
    linear-gradient(180deg, #EEF6CB 0%, #DCF0A6 34%, #C4E287 68%, #B3D870 100%);
  overflow: hidden;
  position: relative;
}
.page > .nav-bar,
.page > .main-view { position: relative; z-index: 1; }

/* ---- v69 页缘灌木丛（参考图底部左右深绿树丛） ---- */
.page-flora {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 200rpx;
  pointer-events: none;
  z-index: 0;
}
.fb {
  position: absolute;
  border-radius: 50% 50% 40% 40%;
  background: linear-gradient(180deg, #5EA53C 0%, #477F2A 70%, #3A6B22 100%);
  box-shadow: inset -6rpx -8rpx 0 rgba(38, 74, 18, 0.35);
}
.fb--1 { width: 200rpx; height: 150rpx; left: -70rpx;  bottom: -46rpx; transform: rotate(-8deg); }
.fb--2 { width: 150rpx; height: 110rpx; left: 70rpx;   bottom: -60rpx; opacity: 0.9; }
.fb--3 { width: 110rpx; height: 84rpx;  left: -30rpx;  bottom: 52rpx;  opacity: 0.75; }
.fb--4 { width: 210rpx; height: 160rpx; right: -80rpx; bottom: -50rpx; transform: rotate(7deg); }
.fb--5 { width: 150rpx; height: 112rpx; right: 66rpx;  bottom: -62rpx; opacity: 0.9; }
.fb--6 { width: 104rpx; height: 80rpx;  right: -22rpx; bottom: 50rpx;  opacity: 0.75; }

/* ========== 自定义导航栏 ========== */
.nav-bar {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* padding 由内联 style 动态设置：padding-left:20rpx; padding-right:{navRightInset}px（v70 按胶囊左缘避让） */
  box-sizing: border-box;
}
.nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(180deg, #EBCD97 0%, #D9AB6C 55%, #C08A4B 100%);
  border: 2.5rpx solid #7A5230;
  box-shadow: 0 3rpx 0 rgba(95, 59, 34, 0.5),
              0 6rpx 12rpx rgba(95, 59, 34, 0.28),
              inset 0 2rpx 0 rgba(255, 244, 214, 0.75);
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease;
}
.nav-btn-hover {
  transform: scale(0.94);
  filter: brightness(0.96);
  box-shadow: 0 1rpx 0 rgba(95, 59, 34, 0.45),
              0 3rpx 8rpx rgba(95, 59, 34, 0.2),
              inset 0 2rpx 0 rgba(255, 244, 214, 0.6);
}
.nav-icon {
  font-size: 42rpx;
  font-weight: 900;
  color: #5C3A1E;
  line-height: 1;
  margin-top: -5rpx;
  text-shadow: 0 1rpx 0 rgba(255, 244, 214, 0.6);
}
.nav-gear {
  font-size: 32rpx;
  line-height: 1;
  filter: drop-shadow(0 1rpx 0 rgba(255, 244, 214, 0.5));
}

/* v69：中央木牌匾标题（参考图：紧凑木板圆角牌 + 双铆钉 + 深棕刻字） */
.nav-title {
  flex: 0 1 auto;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  margin: 8rpx 14rpx 0;      /* v70: 牌匾整体下移一点 */
  padding: 12rpx 44rpx;      /* v70: 随字号加大牌匾（内衬适中，预留窄屏余量） */
  position: relative;
  border-radius: 16rpx 22rpx 18rpx 24rpx / 22rpx 16rpx 24rpx 18rpx;
  background:
    repeating-linear-gradient(0deg,
      rgba(122, 74, 24, 0.07) 0 3rpx,
      rgba(255, 255, 255, 0.05) 3rpx 6rpx,
      rgba(122, 74, 24, 0) 6rpx 26rpx),
    linear-gradient(180deg, #F4DFB2 0%, #E5C487 55%, #D5AE6C 100%);
  border: 3rpx solid #7A5230;
  box-shadow: 0 5rpx 0 rgba(95, 59, 34, 0.5),
              0 10rpx 18rpx rgba(95, 59, 34, 0.24),
              inset 0 2rpx 0 rgba(255, 248, 224, 0.8);
}
.board-screw {
  position: absolute;
  top: 50%;
  width: 13rpx;
  height: 13rpx;
  margin-top: -6.5rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #D9B98C 0%, #8A5A28 70%);
  box-shadow: inset 0 1rpx 1rpx rgba(255, 240, 200, 0.55), 0 1rpx 1rpx rgba(60, 34, 12, 0.4);
}
.board-screw--l { left: 16rpx; }
.board-screw--r { right: 16rpx; }
.nav-title-text {
  color: #5C3A1E;
  font-size: 36rpx;          /* v70: 「单词农场」稍微加大 */
  font-weight: 900;
  letter-spacing: 4rpx;
  white-space: nowrap;       /* v70: 窄屏下禁止牌匾题字换行 */
  line-height: 1.2;
  text-shadow: 0 1.5rpx 0 rgba(255, 244, 214, 0.65);
}

/* v69 副标题（参考图：牌匾下方棕色粗体居中） */
.brand-sub {
  flex: 0 0 auto;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
  color: #5B4A22;
  letter-spacing: 3rpx;
  text-shadow: 0 1.5rpx 0 rgba(255, 255, 255, 0.55);
  line-height: 1.3;
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
}

/* ========== 主体：纯 flex 一屏，禁止滚动 ========== */
.main-view {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 10rpx 26rpx 16rpx;
  /* v70: 底部留出安全区（开始按钮已入卡贴底，避免被 Home 条遮挡） */
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 18rpx;
  box-sizing: border-box;
  justify-content: space-between;
}

/* ================================================================
   v69 数据条（参考图：卡其木胶囊横排 · 彩色图标 + 标签 + 白框数字徽章）
   ================================================================ */
.hud-strip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 46%),
    linear-gradient(180deg, #E6D6AE 0%, #D9C496 60%, #CDB584 100%);
  border: 2.5rpx solid rgba(122, 84, 42, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(95, 70, 30, 0.18),
              inset 0 2rpx 0 rgba(255, 252, 236, 0.6);
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.04s;
}
.hud-item {
  display: flex;
  align-items: center;
  gap: 7rpx;
  min-width: 0;
}
.hud-tap {
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, filter 150ms ease;
}
.hud-tap-hover { transform: scale(0.94); filter: brightness(0.96); }
.hud-ico {
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}
.hud-label {
  font-size: 20rpx;
  font-weight: 800;
  color: #5B4632;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}
.hud-badge {
  min-width: 36rpx;
  padding: 1rpx 10rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #5E4830 0%, #4A3826 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 2rpx 4rpx rgba(60, 40, 16, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hud-badge-txt {
  font-size: 18rpx;
  font-weight: 900;
  color: #FFF7E4;
  line-height: 1.5;
}

/* ================================================================
   v69 插画横幅（参考图主视觉：PvZ 插画 + 橙色白描边「VS」）
   ================================================================ */
.hero-banner {
  flex: 1 1 0;
  min-height: 290rpx;
  max-height: 390rpx;
  position: relative;
  width: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 10rpx 26rpx rgba(70, 110, 35, 0.28),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
  animation: rise-in 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.1s;
}
.hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.hero-shine {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0) 30%);
  pointer-events: none;
}
/* VS 大字：中偏右草地留白处（参考图位置），橙黄 + 白描边 + 立体投影 */
.hero-vs {
  position: absolute;
  top: 46%;
  right: 28%;
  transform: translateY(-50%) rotate(-5deg);
  pointer-events: none;
  animation: vsPop 0.6s cubic-bezier(0.2, 0.9, 0.2, 1.2) both;
  animation-delay: 0.32s;
}
.hero-vs-text {
  font-size: 86rpx;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 2rpx;
  color: #FFA125;
  -webkit-text-stroke: 5rpx #FFFFFF;
  text-shadow: 0 5rpx 0 rgba(205, 96, 0, 0.55),
               0 10rpx 22rpx rgba(120, 60, 0, 0.4);
  line-height: 1;
}
@keyframes vsPop {
  0%   { opacity: 0; transform: translateY(-50%) rotate(-5deg) scale(0.4); }
  100% { opacity: 1; transform: translateY(-50%) rotate(-5deg) scale(1); }
}

/* ================================================================
   v69 词库选择（参考图：单排六枚木牌 · 选中亮柠绿 + 白光圈 + 顶部小芽）
   ================================================================ */
.diff-pills {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  overflow: visible;
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.16s;
}
.diff-pill {
  position: relative;
  flex-shrink: 0;
  padding: 13rpx 17rpx;
  border-radius: 999rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0) 44%),
    linear-gradient(180deg, #F0DDB2 0%, #E2C994 58%, #D4B57C 100%);
  border: 2.5rpx solid #A97B46;
  box-shadow: 0 3.5rpx 0 rgba(150, 100, 50, 0.42),
              0 6rpx 10rpx rgba(110, 75, 35, 0.18),
              inset 0 2rpx 0 rgba(255, 250, 230, 0.7);
  -webkit-tap-highlight-color: transparent;
  transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
}
.diff-pill-hover {
  transform: scale(0.94);
  box-shadow: 0 1.5rpx 0 rgba(150, 100, 50, 0.4),
              inset 0 2rpx 0 rgba(255, 250, 230, 0.6);
}
.diff-pill-txt {
  font-size: 23rpx;
  font-weight: 900;
  color: #6B4A22;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  white-space: nowrap;
}
/* 选中态：亮柠绿 + 白光圈（参考图「初中」） */
.diff-pill.active {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.42) 0%, rgba(255, 255, 255, 0) 46%),
    linear-gradient(180deg, #E2F67C 0%, #C8E94E 55%, #AFD832 100%);
  border-color: #8FB62B;
  transform: scale(1.05);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.85),
              0 0 28rpx rgba(200, 233, 78, 0.95),
              0 4rpx 0 rgba(120, 150, 30, 0.42),
              0 8rpx 16rpx rgba(120, 150, 30, 0.25),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
}
.diff-pill.active .diff-pill-txt { color: #3F5A10; }
/* 顶部小芽：茎 + 两片对生叶（参考图选中牌上方嫩芽） */
.pill-sprout {
  position: absolute;
  top: -27rpx;
  left: 50%;
  width: 40rpx;
  height: 30rpx;
  margin-left: -20rpx;
  pointer-events: none;
  animation: sproutSway 2.6s ease-in-out infinite;
  transform-origin: 50% 100%;
}
@keyframes sproutSway {
  0%, 100% { transform: rotate(-4deg); }
  50%      { transform: rotate(4deg); }
}
.sprout-stem {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 3.5rpx;
  height: 22rpx;
  margin-left: -1.75rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #6FBF3A 0%, #4E8C2F 100%);
}
.sprout-leaf {
  position: absolute;
  top: 0;
  width: 17rpx;
  height: 11rpx;
  background: linear-gradient(180deg, #8FD14F 0%, #5FA23C 100%);
  border: 1.5rpx solid #3F7C1E;
  border-radius: 100% 6rpx 100% 6rpx;
  box-shadow: 0 1rpx 2rpx rgba(50, 90, 20, 0.3);
}
.sprout-leaf--l {
  left: 1rpx;
  transform: rotate(-38deg);
  transform-origin: 100% 100%;
}
.sprout-leaf--r {
  right: 1rpx;
  transform: rotate(38deg) scaleX(-1);
  transform-origin: 100% 100%;
}

/* ================================================================
   v35 自定义词包信息条（样式自 v68 原样保留）
   ================================================================ */
.pack-bar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 16rpx 22rpx 18rpx 24rpx / 20rpx 16rpx 24rpx 18rpx;
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.04) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 22rpx),
    linear-gradient(180deg, #FFFDF5 0%, #F6EDD6 100%);
  border: 2rpx solid rgba(74, 52, 42, 0.5);
  box-shadow: 2rpx 3rpx 0 rgba(74, 52, 42, 0.10),
              0 5rpx 12rpx rgba(74, 52, 42, 0.10);
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.21s;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, box-shadow 150ms ease;
}
.pack-bar-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(80, 120, 45, 0.10);
}
.pack-bar-icon {
  font-size: 24rpx;
  line-height: 1;
  flex-shrink: 0;
}
.pack-bar-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--farm-ink, #4A342A);
  letter-spacing: 0.3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: left;
}
.pack-bar-count {
  flex-shrink: 0;
  font-size: 16rpx;
  font-weight: 800;
  color: #4E8C2F;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(124, 179, 66, 0.18);
}
.pack-bar-action {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(74, 52, 42, 0.08);
  font-size: 16rpx;
  font-weight: 700;
  color: var(--farm-ink-soft, #7A6450);
}

/* ================================================================
   v70 大冒险卡（上段：左插画合影 + 右橙金标题/2×2 白胶囊；下段：卡内主按钮 + 奖励中心）
   ================================================================ */
.adventure-card {
  flex: 1.7 1 0;
  min-height: 430rpx;
  max-height: 640rpx;
  display: flex;
  flex-direction: column;    /* v70: 上段插画区 + 下段按钮排 */
  gap: 14rpx;
  padding: 20rpx 22rpx 18rpx;
  border-radius: 32rpx 26rpx 34rpx 28rpx / 26rpx 32rpx 28rpx 34rpx;
  background:
    repeating-linear-gradient(180deg,
      rgba(110, 150, 60, 0.045) 0 2rpx,
      rgba(110, 150, 60, 0) 2rpx 26rpx),
    linear-gradient(180deg, #F3F9D9 0%, #E4F1BC 58%, #D8EAAB 100%);
  border: 3rpx solid rgba(124, 160, 60, 0.55);
  box-shadow: 0 10rpx 26rpx rgba(80, 120, 40, 0.2),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
  overflow: hidden;
  animation: rise-in 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.26s;
  box-sizing: border-box;
}
/* v70: 上段（左插画 + 右文案/徽章），高度自适应吃掉余量 */
.ac-body {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
/* 左侧插画合影（白框圆角小图，向日葵+坚果+寒冰射手+金杯），v70 高度随卡体自适应 */
.ac-illu {
  position: relative;
  width: 232rpx;
  height: auto;
  align-self: stretch;
  min-height: 220rpx;
  max-height: 330rpx;
  flex-shrink: 0;
  border-radius: 22rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 16rpx rgba(80, 110, 40, 0.24);
  background: #E8F3C8;
}
.ac-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.ac-illu-ring {
  position: absolute;
  inset: 0;
  border-radius: 18rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.55);
  pointer-events: none;
}
/* 右侧文案区 */
.ac-main {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}
.ac-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #F59B0B;
  letter-spacing: 1rpx;
  line-height: 1.15;
  text-shadow: 0 2rpx 0 rgba(255, 244, 200, 0.9),
               0 3.5rpx 0 rgba(196, 110, 0, 0.4);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ac-sub {
  font-size: 22rpx;
  font-weight: 700;
  color: #6D5B33;
  letter-spacing: 1rpx;
  line-height: 1.3;
}
.ac-chips {
  display: grid;             /* v70: 两列网格，四个标签严格两排两列 */
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 2rpx;
}
/* 白胶囊玩法徽章（2×2 固定两排两列，参考图） */
.bchip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FDFBF2 100%);
  border: 2rpx solid rgba(74, 52, 42, 0.16);
  box-shadow: 0 2rpx 6rpx rgba(80, 110, 40, 0.14),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  min-width: 0;
}
.bchip-ico {
  font-size: 22rpx;
  line-height: 1;
  flex-shrink: 0;
}
.bchip-txt {
  font-size: 20rpx;
  font-weight: 800;
  color: #4A3B2A;
  letter-spacing: 0.3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ================================================================
   v70 大冒险卡下段：卡内「开始冒险」主按钮 + 右下角奖励中心（同排）
   ================================================================ */
.ac-start {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 2rpx 2rpx 0;
  animation: rise-in 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.32s;
}
.start-btn {
  flex: 1 1 auto;
  width: auto;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx 18rpx 24rpx 20rpx / 20rpx 24rpx 18rpx 24rpx;
  background-image:
    repeating-linear-gradient(0deg,
      rgba(122, 74, 24, 0.09) 0 3rpx,
      rgba(255, 255, 255, 0.07) 3rpx 6rpx,
      rgba(122, 74, 24, 0) 6rpx 34rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 40%),
    linear-gradient(180deg, #EDCB90 0%, #DCAB68 55%, #C9954F 100%);
  border: 3rpx solid #8B5A3C;
  box-shadow: 0 8rpx 0 #8B5A3C,
              0 16rpx 28rpx rgba(90, 60, 20, 0.3),
              inset 0 2rpx 0 rgba(255, 248, 224, 0.8);
  -webkit-tap-highlight-color: transparent;
  transition: transform 130ms ease, box-shadow 130ms ease, filter 130ms ease;
}
.start-btn-hover {
  transform: translateY(5rpx) scale(0.99);
  filter: brightness(0.97);
  box-shadow: 0 3rpx 0 #8B5A3C,
              0 6rpx 14rpx rgba(90, 60, 20, 0.24),
              inset 0 2rpx 0 rgba(255, 248, 224, 0.6);
}
.start-btn-label {
  font-size: 42rpx;
  font-weight: 900;
  color: #5A3A10;
  letter-spacing: 8rpx;
  margin-right: -8rpx;    /* 抵消末字字距，视觉居中 */
  line-height: 1.1;
  text-shadow: 0 1.5rpx 0 rgba(255, 244, 214, 0.65);
}

/* ================================================================
   v33 新增：「立即了解」玩法介绍弹窗（左对齐·卡片式·替代原生 showModal）
   - 遮罩：暗绿半透 + 毛玻璃，点击关闭；卡片 pop 弹入（回弹曲线）
   - 规则行：数字徽章（六色渐变循环）+ 标题/描述，全部左对齐
   - 逐条错峰淡入（内联 animation-delay）；小屏 scroll-view 兜底滚动
   - 底部：亲子积分联动提示（v32）+ 绿色渐变 CTA（复用 start-main 视觉）
   ================================================================ */
.km-mask {
  position: absolute;
  inset: 0;
  background: rgba(42, 30, 20, 0.5);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 36rpx;
  box-sizing: border-box;
  z-index: 200;              /* 高于导航栏/CTA(z1)，全页覆盖 */
  animation: kmFadeIn 0.28s ease-out;
}
@keyframes kmFadeIn { from { opacity: 0; } to { opacity: 1; } }

.km-card {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  flex-direction: column;
  padding: 30rpx 28rpx 26rpx;
  box-sizing: border-box;
  /* v63：羊皮纸卷轴 + 木质厚框 */
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.05) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 28rpx),
    linear-gradient(180deg, #FFFDF5 0%, #F6EDD6 100%);
  border-radius: 34rpx 26rpx 38rpx 28rpx / 28rpx 36rpx 26rpx 38rpx;
  border: 6rpx solid var(--wood-edge, #5F3B22);
  box-shadow:
    0 10rpx 0 rgba(63, 38, 20, 0.3),
    0 22rpx 44rpx rgba(42, 30, 20, 0.4),
    inset 0 0 0 3rpx rgba(255, 255, 255, 0.55),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.8);
  animation: kmPop 0.42s cubic-bezier(.2,.9,.2,1.15);
}
@keyframes kmPop {
  0%   { opacity: 0; transform: scale(0.82) translateY(24rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

/* ---- 头部：🌱 徽标 + 标题副标题（左） · 关闭 ✕（右） ---- */
.km-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.km-head-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.km-head-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 2rpx;
  min-width: 0;
}
.km-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  /* v63：木框纸印 logo 砖 */
  background: linear-gradient(180deg, #FFFDF5, #EAF3D2);
  border: 3rpx solid rgba(74, 52, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(63, 38, 20, 0.22), inset 0 2rpx 0 rgba(255,255,255,0.9);
  flex-shrink: 0;
}
.km-logo-emoji {
  font-size: 36rpx;
  line-height: 1;
  animation: kmSway 2.8s ease-in-out infinite;
}
@keyframes kmSway {
  0%, 100% { transform: rotate(-7deg); }
  50%      { transform: rotate(7deg); }
}
.km-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--farm-ink, #4A342A);
  letter-spacing: 1rpx;
  line-height: 1.2;
}
.km-subtitle {
  font-size: 16rpx;
  font-weight: 500;
  color: var(--farm-ink-soft, #7A6450);
  margin-top: 4rpx;
  letter-spacing: 0.5rpx;
}
.km-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(74, 52, 42, 0.08);
  border: 2rpx solid rgba(74, 52, 42, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--farm-ink-soft, #7A6450);
  flex-shrink: 0;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, background 150ms ease;
}
.km-close-hover {
  transform: scale(0.88);
  background: rgba(74, 52, 42, 0.16);
}

/* ---- 分割线：墨线渐隐（v63 手绘虚线感） ---- */
.km-divider {
  height: 0;
  margin: 22rpx 4rpx 24rpx;
  flex-shrink: 0;
  border-top: 3rpx dashed rgba(74, 52, 42, 0.35);
}

/* ---- 规则列表：左对齐行式布局，小屏兜底滚动 ---- */
.km-list {
  flex: 0 1 auto;
  min-height: 0;
  max-height: 760rpx;
}
.km-row {
  display: flex;
  align-items: flex-start;       /* 左对齐核心：徽章与文字块顶对齐 */
  gap: 14rpx;
  padding: 15rpx 16rpx;
  /* v63：纸条便签 + 左缘墨线 + 微抖圆角 */
  border-radius: 14rpx 20rpx 16rpx 22rpx / 18rpx 14rpx 22rpx 16rpx;
  border: 2rpx solid rgba(74, 52, 42, 0.35);
  border-left-width: 6rpx;
  box-shadow: 2rpx 2rpx 0 rgba(74, 52, 42, 0.08);
  box-sizing: border-box;
  opacity: 0;
  animation: kmRowIn 0.4s ease-out forwards;   /* 逐条淡入（delay 见内联） */
  -webkit-tap-highlight-color: transparent;
}
.km-row + .km-row { margin-top: 14rpx; }
@keyframes kmRowIn {
  from { opacity: 0; transform: translateY(14rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.km-num {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.4), 0 3rpx 6rpx rgba(0,0,0,0.08);
  border: 2rpx solid rgba(255,255,255,0.85);
  flex-shrink: 0;
  margin-top: -5rpx;           /* v58 2→-5：徽章中心对齐标题行（VLM P0） */
}
.km-body {
  flex: 1 1 auto;
  min-width: 0;
  text-align: left;              /* 文字块整体左对齐 */
}
.km-row-title {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--farm-ink, #4A342A);
  line-height: 1.3;
  letter-spacing: 0.3rpx;
}
.km-row-icon { font-size: 22rpx; line-height: 1; }
.km-row-name { flex: 1 1 auto; min-width: 0; }
.km-row-desc {
  margin-top: 8rpx;
  font-size: 17rpx;
  font-weight: 500;
  color: var(--farm-ink-soft, #7A6450);
  line-height: 1.6;
  letter-spacing: 0.2rpx;
  text-align: left;              /* 描述左对齐（不两端对齐，避免拉伸） */
}

/* ---- 联动提示：亲子积分 → 奖励中心（v32） ---- */
.km-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 16rpx 2rpx 4rpx;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, rgba(255, 193, 7, 0.10), rgba(255, 193, 7, 0.03));
  -webkit-tap-highlight-color: transparent;
}
.km-tip-icon { font-size: 20rpx; line-height: 1; flex-shrink: 0; }
.km-tip-text {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 16rpx;
  font-weight: 500;
  color: #A16207;
  letter-spacing: 0.2rpx;
  text-align: left;
}
.km-tip-link {
  flex-shrink: 0;
  font-size: 16rpx;
  font-weight: 800;
  color: #D97706;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, opacity 150ms ease;
}
.km-tip-link-hover { transform: scale(0.94); opacity: 0.8; }

/* ---- CTA：木牌按钮（与 start-main 视觉同族, v63 木质化） ---- */
.km-cta {
  position: relative;
  margin-top: 24rpx;
  padding: 16rpx 0;
  border-radius: 30rpx 24rpx 34rpx 26rpx / 26rpx 32rpx 24rpx 34rpx;
  border: 3rpx solid var(--wood-edge, #5F3B22);
  background-image:
    repeating-linear-gradient(0deg,
      rgba(63, 38, 20, 0.10) 0 3rpx,
      rgba(255, 255, 255, 0.05) 3rpx 6rpx,
      rgba(63, 38, 20, 0) 6rpx 30rpx),
    linear-gradient(180deg, #C89B72 0%, #A9714B 50%, #8B5A3C 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow:
    0 6rpx 0 var(--wood-edge, #5F3B22),
    0 12rpx 22rpx rgba(74, 52, 42, 0.3),
    inset 0 2rpx 0 rgba(255,255,255,0.4);
  -webkit-tap-highlight-color: transparent;
  transition: transform 130ms ease, box-shadow 130ms ease, filter 130ms ease;
}
.km-cta-shine {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(255,255,255,0.35), rgba(255,255,255,0));
  pointer-events: none;
}
.km-cta-text {
  font-size: 26rpx;
  font-weight: 900;
  color: #FFF8EA;
  letter-spacing: 3rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 0 rgba(63, 38, 20, 0.45);
}
.km-cta-arrow {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(255,255,255,0.9);
  line-height: 1;
}
.km-cta-hover {
  transform: translateY(4rpx) scale(0.99);
  filter: brightness(0.97);
  box-shadow:
    0 2rpx 0 var(--wood-edge, #5F3B22),
    0 5rpx 12rpx rgba(74, 52, 42, 0.24),
    inset 0 2rpx 0 rgba(255,255,255,0.35);
}

/* ================================================================
   v70 「奖励中心」红浆果圆钮——移入大冒险卡右下角（ac-start 同排）
   不再绝对定位于页面右下，随卡片布局排列
   ================================================================ */
.reward-fab {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease;
}
.reward-fab-hover { transform: scale(0.92); }
.fab-ico {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 26%, #FFA388 0%, #FF6A4D 46%, #E04A2E 78%, #C23A22 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 0 rgba(150, 44, 20, 0.45),
              0 12rpx 20rpx rgba(120, 40, 20, 0.32),
              inset 0 3rpx 6rpx rgba(255, 220, 200, 0.5);
  animation: fabBob 2.6s ease-in-out infinite;
}
/* 浆果高光 + 白色星芒（参考图红果白纹） */
.fab-spark {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.fab-spark::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 12rpx;
  width: 16rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  transform: rotate(-24deg);
  filter: blur(1rpx);
}
.fab-spark::after {
  content: "✦";
  position: absolute;
  right: 12rpx;
  bottom: 10rpx;
  font-size: 20rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 1rpx 2rpx rgba(160, 40, 20, 0.5);
}
.fab-label {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(74, 52, 42, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  color: #FFF8EA;
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  box-shadow: 0 3rpx 8rpx rgba(60, 40, 20, 0.3);
}
@keyframes fabBob {
  0%, 100% { transform: translateY(0) rotate(-3deg); }
  50%      { transform: translateY(-5rpx) rotate(3deg); }
}
