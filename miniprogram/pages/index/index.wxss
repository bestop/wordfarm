/* pages/index/index.wxss — v68 参考图重绘（PvZ 草地鲜绿风）
   v68 更新（参考附图逐区对齐）：
   - 页面背景：天空蓝→纸色 渐变改为草地鲜绿渐变（顶部晨光 + 草地深绿晕）
   - 导航木质化：圆形木盘返回钮/玩法钮 + 中央浅木牌匾「单词农场」；新增副标题「背单词，保卫农场」
   - hud-strip 磨砂 → 奶油胶囊横排：彩色图标 + 标签 + 白框数字
   - char-strip 增高放大（150→240rpx 弹性）：角色 --cs-s 变量 scale 1.5，VS 改橙色立体描边大字
   - diff-pill：未选中奶油木标签内凹，选中浅黄绿发芽高亮（保留 pillGlow）
   - banner-hero：木框公告栏 → 浅绿草地大圆角卡；标题橙棕渐变；副标题「背单词、养植物、闯关拿奖励」
     banner-scene 白描边插画框 + 新增迷你奖杯；chips 白描边胶囊化；右上角小叶装饰
   - 新增 reward-fab 右下角浮动「奖励中心」入口（含浮动动效）
   v62 更新（Banner 冲击力升级: 场景 336rpx / 太阳彩虹放大 / 寒冰射手入阵 / bannerRise 入场）
   v30 更新（char-strip 角色条 + Banner 场景元素升级）
   v7 设计 tokens（基于模块节奏 = 18rpx 的 1/3/2/3 比例）：
   - 字号 5 级：44(hero) / 30(nav-brand) / 26(section) / 22(button) / 18(caption) / 15(micro)
   - 圆角 3 级：22rpx(卡片) / 42rpx(主CTA) / 999rpx(胶囊)
   - 间距 3 级：20rpx(模块) / 12rpx(卡片间) / 6rpx(卡片内)
   - 文本色 3 级：#2F3A26(primary) / #5E6F48(secondary) / #657551(muted)
*/

/* ========== 页面容器（v68：PvZ 草地鲜绿渐变 + 阳光光斑，参考图背景） ========== */
.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background:
    radial-gradient(120% 60% at 50% -6%, #F4FFC8 0%, rgba(244,255,200,0) 55%),
    linear-gradient(180deg, #D2F0A2 0%, #BCE584 32%, #A9D968 66%, #9BCE58 100%);
  overflow: hidden;
  position: relative;
}
.page:before,
.page:after {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(60rpx);
  opacity: 0.55;
  z-index: 0;
}
.page:before {
  width: 520rpx; height: 520rpx;
  left: -180rpx; top: -120rpx;
  background: rgba(248, 255, 178, 0.55);   /* 晨光太阳晕（黄绿） */
}
.page:after {
  width: 560rpx; height: 560rpx;
  right: -200rpx; bottom: -160rpx;
  background: rgba(120, 190, 70, 0.45);   /* 草地深绿晕 */
}
.page > .nav-bar,
.page > .main-view { position: relative; z-index: 1; }

/* ========== 自定义导航栏 ========== */
.nav-bar {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* padding 由内联 style 动态设置：padding-left:20rpx; padding-right:{capsuleRight+12}px */
  box-sizing: border-box;
}
.nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* v68：木质圆盘钮（参考图） */
  border-radius: 50%;
  background: linear-gradient(180deg, #EBCD97 0%, #D9AB6C 55%, #C08A4B 100%);
  border: 2.5rpx solid #7A5230;
  box-shadow: 0 3rpx 0 rgba(95, 59, 34, 0.5),
              0 6rpx 12rpx rgba(95, 59, 34, 0.28),
              inset 0 2rpx 0 rgba(255, 244, 214, 0.75);
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease;
}
.nav-btn-hover {
  transform: scale(0.94);
  filter: brightness(0.96);
  box-shadow: 0 1rpx 0 rgba(95, 59, 34, 0.45),
              0 3rpx 8rpx rgba(95, 59, 34, 0.2),
              inset 0 2rpx 0 rgba(255, 244, 214, 0.6);
}
.nav-icon {
  font-size: 34rpx;
  font-weight: 800;
  color: #5C3A1E;
  line-height: 1;
  text-shadow: 0 1rpx 0 rgba(255, 244, 214, 0.6);
}
/* v68：中央木牌匾标题（参考图：浅木圆角牌 + 深棕描边） */
.nav-title {
  flex: 1;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  margin: 0 18rpx;
  padding: 6rpx 30rpx;
  border-radius: 14rpx 20rpx 16rpx 22rpx / 20rpx 14rpx 22rpx 16rpx;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0) 42%) ,
    linear-gradient(180deg, #F6E5BF 0%, #EBD29C 55%, #DFC084 100%);
  border: 3rpx solid #7A5230;
  box-shadow: 0 4rpx 0 rgba(95, 59, 34, 0.5),
              0 8rpx 16rpx rgba(95, 59, 34, 0.22),
              inset 0 2rpx 0 rgba(255, 248, 224, 0.8);
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  line-height: 1.25;
}
.nav-title-text {
  color: #5C3A1E;
  text-shadow: 0 1rpx 0 rgba(255, 244, 214, 0.65);
}
/* v68 导航右侧「玩法」入口：与返回钮同族木质圆盘（内容为 📖 图标） */
.nav-more-icon {
  font-size: 30rpx;
  line-height: 1;
  filter: drop-shadow(0 1rpx 0 rgba(255, 244, 214, 0.5));
}

/* v68 副标题（参考图：导航下棕色粗体居中） */
.brand-sub {
  flex: 0 0 auto;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #4C7A20;
  letter-spacing: 2.5rpx;
  text-shadow: 0 1.5rpx 0 rgba(255, 255, 255, 0.5);
  line-height: 1.3;
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
}

/* ========== 主体：纯 flex 一屏，禁止滚动 ========== */
.main-view {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 6rpx 28rpx 0;
  gap: 20rpx;             /* v67 18→20rpx：模块精简后节奏更舒展 */
  justify-content: space-between;  /* v30 模块均衡分布，标题与内容天然保留呼吸间隔 */
  box-sizing: border-box;
}

/* ================================================================
   v30 新增：游戏角色展示条 CSS（4 植物 VS 舞王僵尸）
   px→rpx 1:1 迁移自 preview_home.html（VLM 3 轮收敛版本）
   ================================================================ */
/* 展示条容器：v68 增高放大（参考图大场景卡）：蓝天→草地渐变 */
.char-strip {
  flex: 0 1 240rpx;          /* v68 150→240rpx 弹性：短屏可收缩至 190rpx 兑底 */
  min-height: 190rpx;
  height: 240rpx;
  position: relative;
  margin: 0 4rpx;
  border-radius: 26rpx;
  background:
    radial-gradient(46% 54% at 8% 6%, rgba(255,243,176,0.6) 0%, rgba(255,243,176,0) 62%),
    radial-gradient(60% 70% at 12% 0%, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0) 60%),
    linear-gradient(180deg, #AEDFFB 0%, #C8EFA8 42%, #A5DC72 74%, #8CCB54 100%);
  box-shadow: 0 10rpx 22rpx rgba(84,120,40,0.24),
              0 0 0 3rpx rgba(255,255,255,0.6),
              inset 0 2rpx 0 rgba(255,255,255,0.9);
  overflow: hidden;
}
/* 敌方紫雾区（僵尸侧氛围，Z_DN_SUIT 系色） */
.char-enemy-zone {
  position: absolute; right: 0; top: 0; bottom: 0; width: 258rpx;
  background: linear-gradient(90deg,
    rgba(107,61,116,0) 0%, rgba(107,61,116,0.08) 45%, rgba(74,37,80,0.16) 100%);
  pointer-events: none; z-index: 1;
}
/* 草地（v68 加厚：底色 + 双层波浪） */
.cs-ground {
  position: absolute; left: 0; right: 0; bottom: 0; height: 46rpx;
  background: linear-gradient(180deg, #85D44A 0%, #5FA82E 100%); z-index: 3;
}
.cs-grass { position: absolute; left: 0; right: 0; z-index: 4; pointer-events: none; }
.cs-grass-back {
  bottom: 36rpx; height: 18rpx; opacity: 0.85;
  background:
    radial-gradient(ellipse 18rpx 14rpx at 6%  100%, #6FC23A 0 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 21% 100%, #6FC23A 0 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 36% 100%, #6FC23A 0 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 51% 100%, #6FC23A 0 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 66% 100%, #6FC23A 0 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 81% 100%, #6FC23A 0 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 96% 100%, #6FC23A 0 50%, transparent 51%);
}
.cs-grass-front {
  bottom: 0; height: 12rpx; z-index: 5;
  background:
    radial-gradient(ellipse 15rpx 11rpx at 8%  100%, #47872A 0 50%, transparent 51%),
    radial-gradient(ellipse 15rpx 11rpx at 28% 100%, #47872A 0 50%, transparent 51%),
    radial-gradient(ellipse 15rpx 11rpx at 48% 100%, #47872A 0 50%, transparent 51%),
    radial-gradient(ellipse 15rpx 11rpx at 68% 100%, #47872A 0 50%, transparent 51%),
    radial-gradient(ellipse 15rpx 11rpx at 88% 100%, #47872A 0 50%, transparent 51%);
}
/* 草地小白花 */
.cs-daisy { position: absolute; width: 8rpx; height: 8rpx; background: #FFFFFF; border-radius: 50%; z-index: 4; }
.cs-daisy::after { content: ""; position: absolute; inset: 2rpx; background: #FFC107; border-radius: 50%; }
.cs-daisy--1 { left: 60rpx; bottom: 48rpx; }
.cs-daisy--2 { left: 196rpx; bottom: 51rpx; }
.cs-daisy--3 { left: 288rpx; bottom: 47rpx; }

/* v68 VS 大字：橙色渐变立体字（参考图：白描边 + 深色投影，去圆底） */
.char-vs {
  position: absolute; left: 404rpx; bottom: 64rpx;
  width: 96rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  transform: rotate(-6deg); z-index: 9;
  animation: vsPulse 2.4s ease-in-out infinite;
}
.vs-text {
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 1rpx;
  background: linear-gradient(180deg, #FFD34A 0%, #FF9E3E 52%, #EF6A1F 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  -webkit-text-stroke: 2rpx #FFFFFF;
  filter: drop-shadow(0 4rpx 0 rgba(186, 73, 22, 0.5));
}
@keyframes vsPulse {
  0%, 100% { transform: rotate(-6deg) scale(1); }
  50%      { transform: rotate(-3deg) scale(1.09); }
}
/* 音符（Z_DN_SUIT_LIGHT 紫，v29.1 对比度结论） */
.cs-note {
  position: absolute; color: #8A5590; font-weight: 900; z-index: 2;
  opacity: 0.9; animation: noteFloat 2.6s ease-in-out infinite;
}
.cs-note--1 { right: 62rpx; top: 18rpx; font-size: 26rpx; }
.cs-note--2 { right: 34rpx; top: 48rpx; font-size: 19rpx; animation-delay: 1.1s; }
.cs-note--3 { right: 96rpx; top: 42rpx; font-size: 16rpx; animation-delay: 0.5s; opacity: 0.7; }
@keyframes noteFloat {
  0%, 100% { transform: translateY(0) rotate(-6deg); }
  50%      { transform: translateY(-7rpx) rotate(8deg); }
}
/* 墓碑点缀（VS 与僵尸之间空档；v68 适配新草地） */
.cs-tomb {
  position: absolute; left: 500rpx; bottom: 30rpx;
  width: 38rpx; height: 48rpx; z-index: 5;
  background: linear-gradient(180deg, #CFCFCF 0%, #ADADAD 100%);
  border-radius: 17rpx 17rpx 4rpx 4rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.15), inset 2rpx 0 0 rgba(255,255,255,0.4);
}
.cs-tomb::before {
  content: ""; position: absolute; left: 50%; top: 12rpx; margin-left: -9rpx;
  width: 18rpx; height: 4rpx; background: #8A8A8A; border-radius: 2rpx;
}
.cs-tomb::after {
  content: ""; position: absolute; left: 50%; top: 7rpx; margin-left: -1.5rpx;
  width: 3rpx; height: 16rpx; background: #8A8A8A; border-radius: 2rpx;
}

/* v46 天空小太阳（暖光呼应植物侧, 复用 sceneSunGlow 脉动） */
.cs-sun {
  position: absolute; left: 20rpx; top: 16rpx;
  width: 22rpx; height: 22rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #FFF59D 0%, #FFD54F 60%, #FFB300 100%);
  box-shadow: 0 0 14rpx rgba(255, 200, 80, 0.75), 0 0 4rpx rgba(255, 224, 130, 0.9);
  z-index: 2; animation: sceneSunGlow 3.4s ease-in-out infinite;
}
/* v46 漂移小云×2（三团径向渐变拼形; 云2独立 keyframe 防动画覆盖 scale） */
.cs-cloud {
  position: absolute; width: 34rpx; height: 12rpx; z-index: 2; pointer-events: none;
  background:
    radial-gradient(ellipse 11rpx 8rpx at 18% 82%, #FFFFFF 0 58%, rgba(255,255,255,0) 59%),
    radial-gradient(ellipse 13rpx 10rpx at 52% 62%, #FFFFFF 0 58%, rgba(255,255,255,0) 59%),
    radial-gradient(ellipse 10rpx 7rpx at 84% 86%, #FFFFFF 0 58%, rgba(255,255,255,0) 59%);
  opacity: 0.92;
  animation: csCloudDrift 9s ease-in-out infinite;
}
.cs-cloud--1 { left: 128rpx; top: 16rpx; }
.cs-cloud--2 { left: 316rpx; top: 36rpx; animation-name: csCloudDrift2; animation-duration: 11s; animation-delay: 1.2s; }
@keyframes csCloudDrift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(9rpx); }
}
@keyframes csCloudDrift2 {
  0%, 100% { transform: translateX(0) scale(0.8); }
  50%      { transform: translateX(-7rpx) scale(0.8); }
}
/* 角色槽位（v68 放大 ×1.5：站位于草地顶面 bottom 46rpx，scale 用 --cs-s 变量） */
.cs-slot { position: absolute; bottom: 46rpx; z-index: 6; }
.cs-slot--sunflower { --cs-s: 1.52; left: 30rpx;  width: 97rpx; height: 119rpx; }
.cs-slot--shooter   { --cs-s: 1.5;  left: 138rpx; width: 87rpx; height: 111rpx; }
.cs-slot--ice       { --cs-s: 1.5;  left: 234rpx; width: 87rpx; height: 117rpx; }
.cs-slot--wall      { --cs-s: 1.5;  left: 330rpx; width: 72rpx; height: 84rpx; }
.cs-slot--zombie    { --cs-s: 1.5;  left: 570rpx; width: 93rpx; height: 144rpx; z-index: 7; }
.cs-slot .chr {
  position: absolute; left: 0; bottom: 0;
  transform-origin: 50% 100%;
  animation: charBob 2.8s ease-in-out infinite;
}
.cs-slot--shooter .chr { animation-delay: 0.4s; }
.cs-slot--ice .chr     { animation-delay: 0.8s; }
.cs-slot--wall .chr    { animation-delay: 1.2s; }
.cs-slot--zombie .chr  { animation: zombieGroove 1.8s ease-in-out infinite; }
@keyframes charBob {
  0%, 100% { transform: translateY(0) scale(var(--cs-s, 1)); }
  50%      { transform: translateY(-7rpx) scale(var(--cs-s, 1)); }
}
@keyframes zombieGroove {
  0%, 100% { transform: translateY(0) rotate(-4deg) scale(var(--cs-s, 1)); }
  50%      { transform: translateY(-8rpx) rotate(5deg) scale(var(--cs-s, 1)); }
}
/* v46 脚下接触阴影（消除角色悬浮感; ::after z-1 低于 .chr 且不随 charBob 抖动 → 贴地正确） */
.cs-slot::after {
  content: ""; position: absolute; bottom: -4rpx; left: 50%;
  width: 44rpx; height: 9rpx; margin-left: -22rpx; border-radius: 50%;
  background: radial-gradient(ellipse, rgba(52,78,22,0.34) 0%, rgba(52,78,22,0) 68%);
  z-index: -1; pointer-events: none;
}
.cs-slot--sunflower::after { width: 66rpx; margin-left: -33rpx; }
.cs-slot--shooter::after   { width: 58rpx; margin-left: -29rpx; }
.cs-slot--ice::after       { width: 58rpx; margin-left: -29rpx; }
.cs-slot--wall::after      { width: 50rpx; height: 9rpx; margin-left: -25rpx; }
.cs-slot--zombie::after    { width: 62rpx; height: 12rpx; margin-left: -31rpx;
  background: radial-gradient(ellipse, rgba(38,20,44,0.4) 0%, rgba(38,20,44,0) 68%); }
/* 名牌（RPG 立牌风，敌方深紫底；v68 适配放大后槽位） */
.cs-name {
  position: absolute; bottom: 6rpx; padding: 0 10rpx;
  height: 27rpx; line-height: 27rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,0.85);
  letter-spacing: 0.5rpx;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 2rpx 4rpx rgba(80,120,45,0.14);
  font-size: 16rpx; font-weight: 700; color: #4B6A2D;
  z-index: 8; white-space: nowrap;
}
.cs-name--sunflower { left: 26rpx; }
.cs-name--shooter   { left: 124rpx; }
.cs-name--ice       { left: 220rpx; }
.cs-name--wall      { left: 322rpx; }
.cs-name--zombie    { left: 556rpx; background: rgba(58,28,64,0.85); color: #F3E5F5; box-shadow: 0 2rpx 4rpx rgba(58,28,64,0.3); }

/* ---------- 通用角色骨架 ---------- */
.chr { position: absolute; left: 0; bottom: 0; }

/* ---------- 向日葵（迷你 v17 风格：8 花瓣 + 暖橙花盘 + 腮红） ---------- */
.chr--sunflower { width: 64rpx; height: 78rpx; }
.sun-stem {
  position: absolute; left: 50%; bottom: 0; width: 6rpx; height: 36rpx; margin-left: -3rpx;
  background: linear-gradient(180deg, #8BC34A 0%, #558B2F 100%); border-radius: 3rpx;
}
.sun-leaf {
  position: absolute; width: 20rpx; height: 12rpx;
  background: linear-gradient(135deg, #8BC34A 0%, #558B2F 100%);
  border-radius: 50% 50% 50% 50% / 70% 70% 30% 30%;
}
.sun-leaf--l { left: 6rpx; bottom: 8rpx; transform: rotate(-26deg); }
.sun-leaf--r { right: 6rpx; bottom: 4rpx; transform: rotate(26deg) scaleX(-1); }
.sun-head { position: absolute; left: 50%; top: 0; width: 44rpx; height: 44rpx; margin-left: -22rpx; }
.sun-p {
  position: absolute; left: 50%; top: 50%;
  width: 11rpx; height: 16rpx; margin: -8rpx 0 0 -5.5rpx;
  background: linear-gradient(180deg, #FFE082 0%, #FFB300 100%);
  border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
  border: 1rpx solid #E65100; z-index: 1;
}
.sun-p--1 { transform: translate(0, -16rpx) rotate(0deg); }
.sun-p--2 { transform: translate(11.3rpx, -11.3rpx) rotate(45deg); }
.sun-p--3 { transform: translate(16rpx, 0) rotate(90deg); }
.sun-p--4 { transform: translate(11.3rpx, 11.3rpx) rotate(135deg); }
.sun-p--5 { transform: translate(0, 16rpx) rotate(180deg); }
.sun-p--6 { transform: translate(-11.3rpx, 11.3rpx) rotate(225deg); }
.sun-p--7 { transform: translate(-16rpx, 0) rotate(270deg); }
.sun-p--8 { transform: translate(-11.3rpx, -11.3rpx) rotate(315deg); }
.sun-disc {
  position: absolute; left: 50%; top: 50%; width: 28rpx; height: 28rpx; margin: -14rpx 0 0 -14rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFCA28 0%, #FFA000 60%, #FF8F00 100%);
  border: 1.5rpx solid #E65100;
  box-shadow: inset 0 -2rpx 3rpx rgba(120,60,0,0.3);
  z-index: 2;
}
.sun-disc::after {
  content: ""; position: absolute; left: 16%; top: 16%;
  width: 34%; height: 26%; border-radius: 50%;
  background: linear-gradient(135deg, rgba(255,253,231,0.85) 0%, rgba(255,255,255,0) 100%);
  transform: rotate(-25deg);
}
.sun-eye {
  position: absolute; top: 16rpx; width: 5rpx; height: 5rpx; border-radius: 50%;
  background: #FFFFFF; box-shadow: 0 1rpx 1rpx rgba(0,0,0,0.25); z-index: 3;
}
.sun-eye--l { left: 13rpx; }
.sun-eye--r { left: 26rpx; }
.sun-eye::before {
  content: ""; position: absolute; left: 1.2rpx; top: 0.8rpx;
  width: 2.6rpx; height: 3.4rpx; border-radius: 50%; background: #4E342E;
}
.sun-blush {
  position: absolute; top: 22rpx; width: 6rpx; height: 4rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,171,145,0.9) 0%, rgba(255,171,145,0) 100%);
  z-index: 3;
}
.sun-blush--l { left: 8rpx; }
