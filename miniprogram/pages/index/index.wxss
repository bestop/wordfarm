/* pages/index/index.wxss — v6 优化布局 + 纯 CSS Banner 重绘（一屏自适应）
   优化要点：
   - main-view 节奏从 14rpx → 18rpx，模块间更舒展
   - stats 卡片 min-height 88→96rpx，数字与标签层级更稳
   - howto-card 高度 120→132rpx，icon-circle 直径放大，标题字号 16→18rpx
   - brand-chip logo 圆角微调，整体视觉重量提升
   - Banner 从 120rpx 半高旧版（依赖 broken PNG）→ 200rpx 全 CSS 农场插画
   - CTA 按钮阴影节奏微调，光感更细腻
   参考图对应区块：
   - 背景：浅黄绿渐变（#F1FBE6 → #E6F5D3），顶有柔光光晕
   - Hero LOGO：居中白色胶囊（绿方🌱 + "单词农场"深绿渐变文字）
   - 统计卡：白底圆角矩形，数字在上文字在下，底部绿色渐变下划线
   - 难度胶囊：小学/中学（选中态实心绿 + 🍃）/大学
   - 玩法标题：左"🌱 游戏玩法"带绿色竖条，右"立即了解"药丸
   - 1×4 玩法卡：图标圆圈背景（白）+ 说明文字
   - Banner：纯 CSS 农场场景（太阳/云朵/向日葵/豌豆射手/栅栏/草地/小花）
     + 右侧"单词农场大冒险"+副标题+"开始冒险"绿色按钮
   - CTA 按钮：圆角矩形（非胶囊）绿色渐变，压边立体阴影
*/

/* ========== 页面容器 ========== */
.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background:
    radial-gradient(120% 80% at 50% -10%, #FFFDE1 0%, rgba(255,253,225,0) 60%),
    linear-gradient(180deg, #F6FFE9 0%, #ECF8D5 55%, #F1FBE2 100%);
  overflow: hidden;
  position: relative;
}
.page:before,
.page:after {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(60rpx);
  opacity: 0.6;
  z-index: 0;
}
.page:before {
  width: 520rpx; height: 520rpx;
  left: -180rpx; top: -120rpx;
  background: rgba(200, 236, 152, 0.55);
}
.page:after {
  width: 560rpx; height: 560rpx;
  right: -200rpx; bottom: -160rpx;
  background: rgba(255, 241, 194, 0.55);
}
.page > .nav-bar,
.page > .main-view,
.page > .cta-bar { position: relative; z-index: 1; }

/* ========== 自定义导航栏 ========== */
.nav-bar {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* padding 由内联 style 动态设置：padding-left:20rpx; padding-right:{capsuleRight+12}px */
  box-sizing: border-box;
}
.nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 4rpx 12rpx rgba(74, 112, 38, 0.1);
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease;
}
.nav-btn-hover {
  transform: scale(0.94);
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 3rpx 10rpx rgba(74, 112, 38, 0.08);
}
.nav-icon {
  font-size: 34rpx;
  font-weight: 800;
  color: #3B5A1F;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  padding: 4rpx 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #2F3A26;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

/* ========== 主体：纯 flex 一屏，禁止滚动 ========== */
.main-view {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 4rpx 28rpx 0;
  gap: 18rpx;             /* v6 节奏：14→18rpx，模块间更舒展 */
  justify-content: flex-start;
  box-sizing: border-box;
}

/* ========== 品牌 Hero 胶囊 ========== */
.brand-hero {
  flex: 0 0 auto;
  position: relative;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.decor {
  position: absolute;
  line-height: 1;
  opacity: 0.9;
  pointer-events: none;
}
.decor-sun {
  top: 4rpx; left: 16rpx;
  font-size: 46rpx;
  animation: sunPulse 3.6s ease-in-out infinite;
}
.decor-flower {
  top: 18rpx; left: 90rpx;
  font-size: 28rpx;
}
.decor-leaf-l {
  bottom: 6rpx; left: 8rpx;
  transform: scaleX(-1);
  font-size: 56rpx;
  opacity: 0.75;
}
.decor-leaf-r {
  bottom: 8rpx; right: 6rpx;
  font-size: 62rpx;
  opacity: 0.75;
}
@keyframes sunPulse {
  0%, 100% { transform: scale(1) rotate(0deg); filter: drop-shadow(0 2rpx 6rpx rgba(255,192,0,0.35)); }
  50%      { transform: scale(1.08) rotate(12deg); filter: drop-shadow(0 6rpx 12rpx rgba(255,192,0,0.55)); }
}
.brand-chip {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 26rpx 12rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(74, 112, 38, 0.12),
              0 0 0 3rpx rgba(255,255,255,0.5);
}
.brand-logo-bg {
  width: 62rpx;
  height: 62rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #E5F7C6, #A8DC7E);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.7),
              0 4rpx 10rpx rgba(106, 156, 42, 0.22);
}
.brand-logo-emoji {
  font-size: 38rpx;
  line-height: 1;
  animation: leafFloat 2.6s ease-in-out infinite;
}
@keyframes leafFloat {
  0%, 100% { transform: translateY(0) rotate(-6deg); }
  50%      { transform: translateY(-6rpx) rotate(6deg); }
}
.brand-title {
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 1.1;
  color: #2F3A26;
  background: linear-gradient(180deg, #34600F 0%, #5AA454 55%, #8ED879 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ========== 3 张独立统计卡（底部分绿色下划线） ========== */
.stats-row {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: center;
  gap: 10rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.stat-card {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 12rpx 6rpx 6rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 18rpx rgba(80, 120, 45, 0.10),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.95);
  position: relative;
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
  transition: transform 160ms ease, box-shadow 160ms ease;
  min-height: 96rpx;          /* v6 88→96rpx，触摸更稳 */
}
.stat-card-underline {
  width: 60%;
  height: 3rpx;
  margin-top: 5rpx;
  background: linear-gradient(90deg, rgba(126,198,106,0), rgba(126,198,106,0.85), rgba(126,198,106,0));
  border-radius: 2rpx;
}
.sound-card-hover {
  transform: scale(0.97);
  box-shadow: 0 4rpx 10rpx rgba(80, 120, 45, 0.06);
}
.stat-card-num {
  font-size: 26rpx;          /* v9 28→26 与面板其它字号节奏一致 */
  font-weight: 900;
  color: #2F3A26;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}
.stat-card-emoji {
  font-size: 24rpx;
  line-height: 1;
  margin-bottom: 2rpx;
}
.stat-card-label {
  font-size: 16rpx;
  color: #657551;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.3rpx;
}

/* ========== 难度选择 胶囊 ========== */
.diff-pills {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.diff-pill {
  flex: 1 1 0;
  min-width: 0;
  padding: 12rpx 0;
  min-height: 64rpx;          /* v9 触摸友好 */
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #5E6F48;
  text-align: center;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 3rpx 8rpx rgba(80, 120, 45, 0.06);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  -webkit-tap-highlight-color: transparent;
  transition: all 220ms cubic-bezier(.2,.8,.2,1);
}
.diff-pill-hover { transform: scale(0.97); }
.diff-pill.active {
  background: linear-gradient(135deg, #8FD27A 0%, #57AA4A 100%);
  color: #FFFFFF;
  box-shadow: 0 5rpx 14rpx rgba(71, 145, 60, 0.26),
              inset 0 2rpx 0 rgba(255,255,255,0.4);
}
.diff-leaf {
  font-size: 16rpx;
  line-height: 1;
  animation: popLeaf 340ms cubic-bezier(.2,.8,.2,1);
}
@keyframes popLeaf {
  0%   { transform: scale(0.3) rotate(-30deg); opacity: 0; }
  60%  { transform: scale(1.3) rotate(12deg);  opacity: 1; }
  100% { transform: scale(1) rotate(0deg);     opacity: 1; }
}

/* ========== 玩法标题行（紧凑，只占一行高度） ========== */
.howto-head {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.howto-head-title {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.howto-bar {
  display: inline-block;
  width: 6rpx;
  height: 22rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #7BC86A, #4D8E3F);
  box-shadow: 0 2rpx 4rpx rgba(77, 142, 63, 0.2);
}
.howto-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #2F3A26;
  letter-spacing: 0.5rpx;
}
.howto-head-more {
  font-size: 18rpx;
  font-weight: 600;
  color: #5E8542;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 3rpx 8rpx rgba(80, 120, 45, 0.07);
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, box-shadow 150ms ease;
}
.more-hover {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.95);
}

/* ========== 玩法卡 网格（单行 4 列 — 原第二排重复卡片已移除） ========== */
.howto-grid {
  flex: 0 0 auto;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  column-gap: 10rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.howto-card {
  flex: 1 1 0;
  min-width: 0;
  height: 132rpx;            /* v6 120→132rpx，icon-circle 放大有空间 */
  border-radius: 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx 6rpx;
  background: #FFFFFF;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.85),
              0 5rpx 12rpx rgba(80, 120, 45, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  -webkit-tap-highlight-color: transparent;
  overflow: hidden;
}
.howto-icon-box {
  width: 62rpx;             /* v6 56→62rpx */
  height: 62rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05),
              inset 0 2rpx 0 rgba(255,255,255,0.85);
}
.howto-card-icon {
  font-size: 32rpx;         /* v6 28→32rpx */
  line-height: 1;
}
.howto-card-title {
  font-size: 18rpx;         /* v6 16→18rpx，更易读 */
  font-weight: 700;
  color: #3A4C2A;
  text-align: center;
  line-height: 1.2;
  letter-spacing: 0.2rpx;
}

/* ========== 横幅 Banner（v6 全 CSS 农场插画，不再依赖外部 PNG） ==========
   尺寸：高度 120→200rpx，左侧场景 220rpx 宽，右侧文字区弹性填充
   场景元素（绝对定位）：天空层 / 太阳 / 云×2 / 草地双层 / 向日葵 / 豌豆射手 / 栅栏 / 小花×3
*/
.banner-hero {
  flex: 0 0 auto;
  height: 200rpx;            /* v6 120→200rpx，给插画完整呼吸空间 */
  position: relative;
  margin: 0 4rpx;
  padding: 14rpx 20rpx 14rpx 14rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(80% 100% at 0% 0%, #FFF6B0 0%, rgba(255,246,176,0) 60%),
    linear-gradient(125deg, #FFF6CE 0%, #E8F4B8 35%, #BFE089 70%, #8FCE63 100%);
  box-shadow:
    0 10rpx 24rpx rgba(102, 148, 52, 0.24),
    0 0 0 3rpx rgba(255,255,255,0.5),
    inset 0 2rpx 0 rgba(255,255,255,0.85),
    inset 0 -4rpx 0 rgba(97, 171, 69, 0.32);
  overflow: hidden;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  box-sizing: border-box;
}

/* 装饰光斑（保留旧版氛围） */
.banner-spot {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  opacity: 0.6;
  pointer-events: none;
  z-index: 0;
}
.banner-spot-1 {
  width: 120rpx; height: 120rpx;
  left: -30rpx; top: -40rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.98), rgba(255,255,255,0) 65%);
  animation: spotDrift 6s ease-in-out infinite;
}
.banner-spot-2 {
  width: 110rpx; height: 110rpx;
  right: -20rpx; bottom: -35rpx;
  background: radial-gradient(circle, rgba(255, 220, 140, 0.7), rgba(255,255,255,0) 65%);
  animation: spotDrift 7.2s ease-in-out infinite reverse;
}
@keyframes spotDrift {
  0%, 100% { transform: translate(0,0) scale(1);    opacity: 0.55; }
  50%      { transform: translate(12rpx,-10rpx) scale(1.08); opacity: 0.72; }
}

/* ============ 左侧：纯 CSS 农场场景 ============ */
.banner-scene {
  position: relative;
  flex-shrink: 0;
  width: 220rpx;
  height: 100%;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #BEE9FF 0%, #D9F2C4 65%, #C2E5A0 100%);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.6),
              inset 0 -2rpx 0 rgba(60, 110, 30, 0.18);
}

/* 天空叠加层（增加云朵漫射感） */
.scene-sky {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 65%;
  background: radial-gradient(60% 80% at 70% 10%, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0) 60%),
              radial-gradient(50% 60% at 20% 30%, rgba(255,236,180,0.45) 0%, rgba(255,236,180,0) 70%);
  pointer-events: none;
  z-index: 1;
}

/* 太阳：核心 + 4 道射线 + 脉动光晕 */
.scene-sun {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 36rpx;
  height: 36rpx;
  z-index: 2;
  animation: sceneSunSpin 14s linear infinite;
}
@keyframes sceneSunSpin {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.sun-core {
  position: absolute;
  left: 50%; top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin: -11rpx 0 0 -11rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #FFF59D 0%, #FFD54F 55%, #FFB300 100%);
  box-shadow: 0 0 16rpx rgba(255, 200, 80, 0.7),
              inset -2rpx -2rpx 4rpx rgba(180, 110, 0, 0.35);
  z-index: 2;
}
.sun-ray {
  position: absolute;
  left: 50%; top: 50%;
  width: 4rpx;
  height: 8rpx;
  margin-left: -2rpx;
  background: linear-gradient(180deg, #FFD54F 0%, rgba(255,179,0,0) 100%);
  border-radius: 2rpx;
  transform-origin: center 18rpx;
}
.sun-ray-1 { transform: translateY(-16rpx); }
.sun-ray-2 { transform: translate(11rpx,-11rpx) rotate(45deg); }
.sun-ray-3 { transform: translate(16rpx,0)    rotate(90deg); }
.sun-ray-4 { transform: translate(11rpx,11rpx) rotate(135deg); }
/* 太阳整体光晕（不旋转的脉动） */
.scene-sun:before {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 40rpx; height: 40rpx;
  margin: -20rpx 0 0 -20rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 220, 100, 0.55) 0%, rgba(255, 220, 100, 0) 70%);
  z-index: 1;
  animation: sceneSunGlow 3.4s ease-in-out infinite;
}
@keyframes sceneSunGlow {
  0%, 100% { transform: scale(1);    opacity: 0.7; }
  50%      { transform: scale(1.15); opacity: 1; }
}

/* 云朵：3 个泡叠加 */
.scene-cloud {
  position: absolute;
  z-index: 2;
}
.scene-cloud-1 {
  top: 22rpx;
  left: 18rpx;
  animation: sceneCloudDrift 12s ease-in-out infinite;
}
.scene-cloud-2 {
  top: 50rpx;
  left: 92rpx;
  transform: scale(0.7);
  opacity: 0.85;
  animation: sceneCloudDrift 16s ease-in-out infinite reverse;
}
@keyframes sceneCloudDrift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(10rpx); }
}
.scene-cloud-2 { animation-name: sceneCloudDrift2; }
@keyframes sceneCloudDrift2 {
  0%, 100% { transform: translateX(0) scale(0.7); }
  50%      { transform: translateX(-8rpx) scale(0.7); }
}
.cloud-puff {
  position: absolute;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(150, 200, 230, 0.4);
}
.cloud-puff-a { width: 18rpx; height: 18rpx; left: 0;   top: 4rpx; }
.cloud-puff-b { width: 22rpx; height: 22rpx; left: 12rpx; top: 0;  }
.cloud-puff-c { width: 16rpx; height: 16rpx; left: 28rpx; top: 5rpx; }

/* 草地：底色 + 两层绿色波浪 */
.scene-ground {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 38rpx;
  background: linear-gradient(180deg, #8FC95F 0%, #6BA940 100%);
  z-index: 3;
}
.scene-grass {
  position: absolute;
  left: 0; right: 0;
  bottom: 22rpx;
  height: 18rpx;
  z-index: 4;
  pointer-events: none;
}
.scene-grass-back {
  bottom: 28rpx;
  background:
    radial-gradient(ellipse 18rpx 14rpx at 5%  100%, #7CB342 0%, #7CB342 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 25% 100%, #7CB342 0%, #7CB342 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 45% 100%, #7CB342 0%, #7CB342 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 65% 100%, #7CB342 0%, #7CB342 50%, transparent 51%),
    radial-gradient(ellipse 18rpx 14rpx at 85% 100%, #7CB342 0%, #7CB342 50%, transparent 51%);
  opacity: 0.85;
}
.scene-grass-front {
  bottom: 0;
  height: 14rpx;
  background:
    radial-gradient(ellipse 16rpx 12rpx at 12% 100%, #4F8E2E 0%, #4F8E2E 50%, transparent 51%),
    radial-gradient(ellipse 16rpx 12rpx at 35% 100%, #4F8E2E 0%, #4F8E2E 50%, transparent 51%),
    radial-gradient(ellipse 16rpx 12rpx at 58% 100%, #4F8E2E 0%, #4F8E2E 50%, transparent 51%),
    radial-gradient(ellipse 16rpx 12rpx at 82% 100%, #4F8E2E 0%, #4F8E2E 50%, transparent 51%);
  z-index: 5;
}

/* 向日葵：茎 + 双叶 + 头（8 花瓣 + 脸 + 双眼 + 嘴） */
.scene-sunflower {
  position: absolute;
  left: 28rpx;
  bottom: 18rpx;
  width: 60rpx;
  height: 120rpx;
  z-index: 6;
  animation: sceneSway 4.2s ease-in-out infinite;
  transform-origin: 50% 100%;
}
@keyframes sceneSway {
  0%, 100% { transform: rotate(-3deg); }
  50%      { transform: rotate(3deg);  }
}
.sf-stem {
  position: absolute;
  left: 50%; bottom: 0;
  width: 6rpx;
  height: 70rpx;
  margin-left: -3rpx;
  background: linear-gradient(180deg, #6FAE3A 0%, #4F8E2E 100%);
  border-radius: 3rpx;
}
.sf-leaf {
  position: absolute;
  width: 22rpx;
  height: 14rpx;
  background: linear-gradient(135deg, #8BC34A 0%, #558B2F 100%);
  border-radius: 50% 50% 50% 50% / 70% 70% 30% 30%;
}
.sf-leaf-l {
  left: -10rpx;
  bottom: 30rpx;
  transform: rotate(-30deg);
  box-shadow: inset 0 -1rpx 0 rgba(0,0,0,0.12);
}
.sf-leaf-r {
  right: -10rpx;
  bottom: 22rpx;
  transform: rotate(30deg) scaleX(-1);
  box-shadow: inset 0 -1rpx 0 rgba(0,0,0,0.12);
}
.sf-head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  margin-left: -28rpx;
  animation: sceneHeadBob 2.6s ease-in-out infinite;
}
@keyframes sceneHeadBob {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50%      { transform: translateY(-2rpx) rotate(2deg); }
}
.sf-petal {
  position: absolute;
  left: 50%; top: 50%;
  width: 14rpx;
  height: 22rpx;
  margin: -11rpx 0 0 -7rpx;
  background: linear-gradient(180deg, #FFE082 0%, #FFB300 100%);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  transform-origin: center 22rpx;
  box-shadow: inset 0 -1rpx 0 rgba(180, 100, 0, 0.3);
}
.sf-petal-1 { transform: translateY(-22rpx) rotate(0deg);   }
.sf-petal-2 { transform: translateY(-15rpx) translateX(15rpx) rotate(45deg);  }
.sf-petal-3 { transform: translateX(22rpx) rotate(90deg);   }
.sf-petal-4 { transform: translateY(15rpx) translateX(15rpx) rotate(135deg);  }
.sf-petal-5 { transform: translateY(22rpx) rotate(180deg);  }
.sf-petal-6 { transform: translateY(15rpx) translateX(-15rpx) rotate(225deg); }
.sf-petal-7 { transform: translateX(-22rpx) rotate(270deg); }
.sf-petal-8 { transform: translateY(-15rpx) translateX(-15rpx) rotate(315deg); }
.sf-face {
  position: absolute;
  left: 50%; top: 50%;
  width: 30rpx; height: 30rpx;
  margin: -15rpx 0 0 -15rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #8D6E63 0%, #5D4037 100%);
  box-shadow: inset 0 -2rpx 4rpx rgba(0,0,0,0.3);
}
.sf-eye {
  position: absolute;
  width: 5rpx; height: 5rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 1rpx 1rpx rgba(0,0,0,0.3);
}
.sf-eye-l { left: 19rpx; top: 25rpx; }
.sf-eye-r { left: 32rpx; top: 25rpx; }
.sf-eye-l:before, .sf-eye-r:before {
  content: "";
  position: absolute;
  left: 1rpx; top: 1rpx;
  width: 3rpx; height: 3rpx;
  border-radius: 50%;
  background: #1A1A1A;
}
.sf-mouth {
  position: absolute;
  left: 50%;
  top: 34rpx;
  width: 10rpx; height: 5rpx;
  margin-left: -5rpx;
  border-bottom: 2rpx solid #1A1A1A;
  border-radius: 0 0 50% 50%;
}

/* 豌豆射手：茎 + 双叶 + 头（脸+眼+嘴+炮口阴影） */
.scene-shooter {
  position: absolute;
  right: 28rpx;
  bottom: 18rpx;
  width: 50rpx;
  height: 110rpx;
  z-index: 6;
  animation: sceneSway 5s ease-in-out infinite reverse;
  transform-origin: 50% 100%;
}
.ps-stem {
  position: absolute;
  left: 50%; bottom: 0;
  width: 6rpx;
  height: 60rpx;
  margin-left: -3rpx;
  background: linear-gradient(180deg, #6FAE3A 0%, #4F8E2E 100%);
  border-radius: 3rpx;
}
.ps-leaf {
  position: absolute;
  width: 20rpx;
  height: 13rpx;
  background: linear-gradient(135deg, #8BC34A 0%, #558B2F 100%);
  border-radius: 50% 50% 50% 50% / 70% 70% 30% 30%;
}
.ps-leaf-l { left: -10rpx; bottom: 28rpx; transform: rotate(-30deg); }
.ps-leaf-r { right: -10rpx; bottom: 18rpx; transform: rotate(30deg) scaleX(-1); }
.ps-head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  animation: sceneHeadBob 2.4s ease-in-out infinite reverse;
}
.ps-face {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #AED581 0%, #7CB342 55%, #558B2F 100%);
  box-shadow: inset 0 -3rpx 4rpx rgba(0,0,0,0.18),
              inset 0 2rpx 0 rgba(255,255,255,0.45);
}
.ps-eye {
  position: absolute;
  left: 18rpx; top: 16rpx;
  width: 9rpx; height: 9rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 1rpx 1rpx rgba(0,0,0,0.2);
}
.ps-eye:before {
  content: "";
  position: absolute;
  left: 2rpx; top: 2rpx;
  width: 5rpx; height: 5rpx;
  border-radius: 50%;
  background: #1A1A1A;
}
.ps-mouth {
  position: absolute;
  right: -2rpx;
  top: 50%;
  width: 12rpx; height: 12rpx;
  margin-top: -6rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2E5A1A 0%, #1A3A0E 100%);
  box-shadow: inset 0 -1rpx 0 rgba(0,0,0,0.4),
              inset 0 1rpx 0 rgba(255,255,255,0.15);
}
.ps-shadow {
  position: absolute;
  right: -1rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-top: -7rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(80,160,40,0.5) 0%, rgba(80,160,40,0) 70%);
  z-index: -1;
}

/* 栅栏：3 竖柱 + 2 横梁（前景，挡在植物前） */
.scene-fence {
  position: absolute;
  left: 0; right: 0; bottom: 12rpx;
  height: 26rpx;
  z-index: 7;
}
.fence-post {
  position: absolute;
  bottom: 0;
  width: 5rpx;
  height: 26rpx;
  background: linear-gradient(180deg, #C08A55 0%, #8B5A2B 100%);
  border-radius: 2rpx 2rpx 0 0;
  box-shadow: inset -1rpx 0 0 rgba(0,0,0,0.18);
}
.fence-post-1 { left: 22rpx;  height: 22rpx; }
.fence-post-2 { left: 110rpx; height: 26rpx; }
.fence-post-3 { left: 198rpx; height: 20rpx; }
.fence-rail {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 4rpx;
  background: linear-gradient(180deg, #C4936A 0%, #8B5A2B 100%);
  border-radius: 2rpx;
}
.fence-rail-top    { top: 6rpx;  width: auto; }
.fence-rail-bottom { top: 16rpx; width: auto; }

/* 小花点缀（草地上的彩色斑点） */
.scene-bloom {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  z-index: 5;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.18);
}
.scene-bloom-1 {
  left: 16rpx;
  bottom: 6rpx;
  background: radial-gradient(circle, #FFEB3B 0%, #FF9800 100%);
}
.scene-bloom-2 {
  left: 70rpx;
  bottom: 4rpx;
  background: radial-gradient(circle, #F48FB1 0%, #E91E63 100%);
}
.scene-bloom-3 {
  left: 152rpx;
  bottom: 7rpx;
  background: radial-gradient(circle, #CE93D8 0%, #7B1FA2 100%);
}

/* ============ 右侧：文字区 + 开始冒险按钮 ============ */
.banner-main {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 4rpx;
  position: relative;
  z-index: 1;
  padding-left: 14rpx;
}
.banner-eyebrow {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 2rpx 6rpx rgba(80, 120, 45, 0.10);
  font-size: 16rpx;
  font-weight: 800;
  color: #4B6A2D;
  letter-spacing: 0.5rpx;
  margin-bottom: 2rpx;
}
.banner-title {
  font-size: 32rpx;            /* v6 24→32rpx，主标题更醒目 */
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.1;
  background: linear-gradient(180deg, #2F5312 0%, #4C8B2A 55%, #7BC86A 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 2rpx 0 rgba(255,255,255,0.25);
}
.banner-sub {
  font-size: 18rpx;            /* v6 13→18rpx，副标题可读 */
  font-weight: 700;
  color: #4B6A2D;
  line-height: 1.25;
  letter-spacing: 0.3rpx;
}
.banner-btn {
  margin-top: 6rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx 10rpx 24rpx;
  gap: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6FCF5E 0%, #3D8A32 100%);
  color: #FFFFFF;
  font-size: 22rpx;            /* v6 16→22rpx，按钮文字更清晰 */
  font-weight: 900;
  letter-spacing: 1rpx;
  box-shadow:
    0 5rpx 12rpx rgba(47, 83, 18, 0.38),
    inset 0 2rpx 0 rgba(255,255,255,0.4),
    inset 0 -2rpx 0 rgba(0,0,0,0.2);
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease;
  animation: bannerBtnPulse 2.8s ease-in-out infinite;
}
@keyframes bannerBtnPulse {
  0%, 100% { box-shadow: 0 5rpx 12rpx rgba(47, 83, 18, 0.38),
                      inset 0 2rpx 0 rgba(255,255,255,0.4),
                      inset 0 -2rpx 0 rgba(0,0,0,0.2); }
  50%      { box-shadow: 0 8rpx 18rpx rgba(47, 83, 18, 0.5),
                      inset 0 2rpx 0 rgba(255,255,255,0.4),
                      inset 0 -2rpx 0 rgba(0,0,0,0.2),
                      0 0 0 4rpx rgba(255, 240, 150, 0.5); }
}
.banner-btn-hover {
  transform: translateY(2rpx) scale(0.97);
  filter: brightness(0.98);
  box-shadow: 0 3rpx 8rpx rgba(47, 83, 18, 0.3),
              inset 0 2rpx 0 rgba(255,255,255,0.35),
              inset 0 -2rpx 0 rgba(0,0,0,0.18);
}
.banner-btn-arrow {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  margin-top: -2rpx;
}

/* ========== 固定底部 CTA：圆角矩形（参考图样式，非胶囊） ========== */
.cta-bar {
  flex-shrink: 0;
  width: 100%;
  padding: 8rpx 28rpx 12rpx;            /* v6 6/10→8/12rpx，与底部 safe 区配合更顺 */
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(241,251,226,0) 0%, #E9F6CF 40%, #E2F3C1 100%);
  box-shadow: 0 -4rpx 12rpx rgba(200, 228, 144, 0.18);
}
.start-main {
  position: relative;
  width: 100%;
  padding: 18rpx 0;                    /* v6 16→18rpx，与 banner 按钮的视觉重量对齐 */
  border-radius: 42rpx;
  border: none;
  background: linear-gradient(180deg, #9BDF7F 0%, #6FCF5E 50%, #4EA944 100%);
  color: #FFFFFF;
  font-size: 30rpx;                    /* v6 28→30rpx，主 CTA 更醒目 */
  font-weight: 900;
  letter-spacing: 3rpx;
  text-align: center;
  line-height: 1.2;
  box-shadow:
    0 6rpx 0 #35742C,
    0 12rpx 22rpx rgba(79, 155, 63, 0.32),
    inset 0 2rpx 0 rgba(255,255,255,0.55);
  -webkit-tap-highlight-color: transparent;
  transition: transform 130ms ease, box-shadow 130ms ease, filter 130ms ease;
  overflow: hidden;
}
.start-main:after { border: none; }
.start-main-shine {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(255,255,255,0.45), rgba(255,255,255,0));
  pointer-events: none;
  border-radius: 40rpx 40rpx 0 0;
}
.start-main-hover {
  transform: translateY(5rpx) scale(0.99);
  filter: brightness(0.98);
  box-shadow:
    0 2rpx 0 #35742C,
    0 5rpx 12rpx rgba(79, 155, 63, 0.26),
    inset 0 2rpx 0 rgba(255,255,255,0.45);
}
