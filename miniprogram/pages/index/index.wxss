/* pages/index/index.wxss — v75 糖果果冻再打磨（v74 基础上回调）
   设计体系：蛋仔派对风糖果果冻（圆润、高饱和、轻 3D）
   - 果冻公式：大圆角 + 白描边 3-4rpx + 浅顶深底渐变 + 底部挤出深色投影 + 顶部内发光
   - 色板：草莓粉 FF8FB5/柠黄 FFD34D/蜜橙 FFA53D/薄荷 7EE0A8/苹果绿 A8E86A/天蓝 7CC8FA/葡萄紫 C79BF2
   v76 更新：
   - 果冻气泡加大加立体：46/32/26/38→60/44/36/50，糖果膜加饱和+白边加厚+双高光斑+厚投影
   - 星心花加大加立体：38/32/30/30/34/26→52/44/40/38/46/34，白描边加厚+糖影加深+彩色光晕
   - 大冒险卡整体高度回压：min/max 370/524→330/456、插画 208×192→200×186、按钮 82→78
   - 横幅吸收余量：max 430→496，flex 权重 hero 1→1.25 / card 1.5→1.15
   v75 更新：
   - 龙珠一星从插画角回退，奖励球改橙黄龙珠+红四尖星居中
   - 整体下移填满：牌匾 margin 22→34，横幅 min/max 290/412→300/430，卡 min/max 350/500→370/524
   - diff-pills 加 margin-top 26rpx：与横幅距离增大，顶部小芽不再被遮挡
   - 背景装饰扩充：果冻气泡 ×4 + 星心花 ×6（蓝星/黄星/粉心/白花点，参考图红框密度）
   v74 更新：
   - 背景装饰重做：emoji→CSS 果冻气泡 ×3（透明高光+白描边）+ 黄星白描边 ×3（★/★/✦）
   - 牌匾去🌻图标；奖励球去「奖励中心」字样，球体加大补偿视觉分量
   - 大冒险卡插画右上角新增龙珠一星（橙黄果冻球+红四尖星 clip-path）
   - 大冒险卡整体紧凑：padding/gap/插画/标题/徽章/按钮全面收紧，横幅上限微增吸收余量
   v73 更新：
   - 页面背景换奶油黄→粉→淡蓝糖果渐变，新增 page-candy 糖星散布层；灌木→橙色果冻波浪
   - 牌匾粉果冻+白描边+黄糖珠（铆钉退役），题字白字粉描边
   - hud 白果冻条+橙黄果冻徽章；横幅白描边+青蓝光晕
   - 词库牌六色果冻（diff-pill--key 挂钩），白字+选中白圈光晕
   - 大冒险卡粉→蓝果冻渐变+糖星装饰；标题双色分段；徽章淡彩描边（bchip--id）
   - 开始冒险橙黄果冻+白描边；奖励中心粉橙果冻球；弹窗白果冻+薄荷 CTA
   v72/v71/v67-v70 历史见 git log；数据绑定与事件零破坏
*/

/* ========== 页面容器（v78：参考图调色——统一奶油黄暖底，淡紫/淡蓝分区色块退场） ========== */
.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background:
    radial-gradient(86% 34% at 10% 4%, rgba(255, 224, 162, 0.5) 0%, rgba(255, 224, 162, 0) 58%),
    radial-gradient(70% 26% at 92% 12%, rgba(255, 208, 233, 0.26) 0%, rgba(255, 208, 233, 0) 56%),
    radial-gradient(88% 30% at 50% 104%, rgba(255, 186, 122, 0.28) 0%, rgba(255, 186, 122, 0) 60%),
    linear-gradient(180deg, #FFF3C6 0%, #FFEECB 30%, #FFEED3 55%, #FFE9D8 80%, #FFE3D6 100%);
  overflow: hidden;
  position: relative;
}
.page > .nav-bar,
.page > .main-view { position: relative; z-index: 1; }

/* ---- v75 果冻气泡 + 星心花散布层（v78 参考图调优：缩号·提透·柔化·疏排，绝对定位不入流，低于主体层） ---- */
.page-candy {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  pointer-events: none;
  z-index: 0;
}
/* 果冻气泡（v78 参考图回调：尺寸缩半档，糖果膜降饱和提透明，白边变薄，
   内外壁阴影与光晕全档减弱——保留果冻球质感，读感更轻盈半透） */
.pc-bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 26%,
    rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.5) 22%,
    rgba(255, 186, 228, 0.4) 52%, rgba(150, 204, 250, 0.42) 100%);
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: inset -5rpx -8rpx 12rpx rgba(120, 172, 235, 0.3),
              inset 5rpx 6rpx 10rpx rgba(255, 255, 255, 0.75),
              0 6rpx 14rpx rgba(190, 150, 220, 0.22),
              0 0 12rpx rgba(255, 186, 228, 0.26);
  animation: pcFloat 4.2s ease-in-out infinite;
}
/* v76: 气泡双高光斑（左上主高光 + 右下次高光），立体果冻感核心 */
.pc-bubble::before {
  content: "";
  position: absolute;
  left: 14%; top: 9%;
  width: 44%; height: 32%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  transform: rotate(-22deg);
  filter: blur(1rpx);
}
.pc-bubble::after {
  content: "";
  position: absolute;
  right: 16%; bottom: 14%;
  width: 18%; height: 13%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  filter: blur(0.5rpx);
}
/* v78 分布：贴边疏排——上段（数据条/横幅两缘）稍密，中段拉开，下段卡区一点+右下角收尾 */
.pc-bubble--1 { left: 8rpx;   top: 380rpx; width: 34rpx; height: 34rpx; }
.pc-bubble--2 { right: 10rpx; top: 466rpx; width: 26rpx; height: 26rpx; animation-delay: 0.7s; animation-duration: 3.6s; }
.pc-bubble--3 { left: 8rpx;   top: 1250rpx; width: 22rpx; height: 22rpx; animation-delay: 1.3s; animation-duration: 3.1s; }
.pc-bubble--4 { right: 6rpx;  bottom: 24rpx; width: 30rpx; height: 30rpx; animation-delay: 1.9s; }
/* 星心花（v78 参考图回调：缩号至小糖星档，白描边变细变半透，糖影/光晕减弱
   ——保留立体糖感，读感轻盈不抢主体；分布疏密对齐参考图） */
.pc-star {
  position: absolute;
  line-height: 1;
  color: #FFD34D;
  text-shadow:
    2rpx 0 0 rgba(255, 255, 255, 0.9), -2rpx 0 0 rgba(255, 255, 255, 0.9),
    0 2rpx 0 rgba(255, 255, 255, 0.9), 0 -2rpx 0 rgba(255, 255, 255, 0.9),
    1.6rpx 1.6rpx 0 rgba(255, 255, 255, 0.9), -1.6rpx -1.6rpx 0 rgba(255, 255, 255, 0.9),
    1.6rpx -1.6rpx 0 rgba(255, 255, 255, 0.9), -1.6rpx 1.6rpx 0 rgba(255, 255, 255, 0.9),
    0 4rpx 0 rgba(245, 179, 1, 0.35),
    0 0 10rpx rgba(255, 211, 77, 0.32);
  animation: pcFloat 3.8s ease-in-out infinite;
}
.pc-star--1 { right: 10rpx; top: 300rpx; font-size: 30rpx; }                     /* 右上黄星（横幅右缘） */
.pc-star--2 { left: 8rpx;   top: 240rpx; font-size: 26rpx; color: #7CC8FA;       /* 左上蓝星（数据条左缘） */
  text-shadow:
    2rpx 0 0 rgba(255, 255, 255, 0.9), -2rpx 0 0 rgba(255, 255, 255, 0.9),
    0 2rpx 0 rgba(255, 255, 255, 0.9), 0 -2rpx 0 rgba(255, 255, 255, 0.9),
    1.6rpx 1.6rpx 0 rgba(255, 255, 255, 0.9), -1.6rpx -1.6rpx 0 rgba(255, 255, 255, 0.9),
    1.6rpx -1.6rpx 0 rgba(255, 255, 255, 0.9), -1.6rpx 1.6rpx 0 rgba(255, 255, 255, 0.9),
    0 4rpx 0 rgba(72, 168, 238, 0.35),
    0 0 10rpx rgba(124, 200, 250, 0.3);
  animation-delay: 0.9s; }
.pc-star--3 { right: 10rpx; top: 620rpx; font-size: 24rpx; color: #FF7BA9;       /* 右中粉爱心（横幅与词库间右缘） */
  text-shadow:
    2rpx 0 0 rgba(255, 255, 255, 0.9), -2rpx 0 0 rgba(255, 255, 255, 0.9),
    0 2rpx 0 rgba(255, 255, 255, 0.9), 0 -2rpx 0 rgba(255, 255, 255, 0.9),
    1.6rpx 1.6rpx 0 rgba(255, 255, 255, 0.9), -1.6rpx -1.6rpx 0 rgba(255, 255, 255, 0.9),
    1.6rpx -1.6rpx 0 rgba(255, 255, 255, 0.9), -1.6rpx 1.6rpx 0 rgba(255, 255, 255, 0.9),
    0 4rpx 0 rgba(216, 79, 134, 0.35),
    0 0 10rpx rgba(255, 123, 169, 0.28);
  animation-delay: 1.6s; animation-duration: 3.3s; }
.pc-star--4 { left: 12rpx;  top: 700rpx; font-size: 22rpx; color: #FFFFFF;       /* 左中白花（横幅与词库间左缘） */
  text-shadow:
    2rpx 0 0 rgba(255, 200, 224, 0.85), -2rpx 0 0 rgba(255, 200, 224, 0.85),
    0 2rpx 0 rgba(255, 200, 224, 0.85), 0 -2rpx 0 rgba(255, 200, 224, 0.85),
    1.6rpx 1.6rpx 0 rgba(255, 200, 224, 0.85), -1.6rpx -1.6rpx 0 rgba(255, 200, 224, 0.85),
    1.6rpx -1.6rpx 0 rgba(255, 200, 224, 0.85), -1.6rpx 1.6rpx 0 rgba(255, 200, 224, 0.85),
    0 4rpx 0 rgba(216, 79, 134, 0.25),
    0 0 10rpx rgba(255, 200, 224, 0.3);
  animation-delay: 0.4s; }
.pc-star--5 { left: 10rpx;  top: 1082rpx; font-size: 28rpx;                      /* 左中黄星（大卡左缘空档） */
  animation-delay: 2.1s; animation-duration: 3.5s; }
.pc-star--6 { right: 10rpx; top: 926rpx; font-size: 20rpx; color: #FFFFFF;       /* 右下白色小星（词库与大卡间右缘） */
  text-shadow:
    2rpx 0 0 rgba(205, 168, 244, 0.85), -2rpx 0 0 rgba(205, 168, 244, 0.85),
    0 2rpx 0 rgba(205, 168, 244, 0.85), 0 -2rpx 0 rgba(205, 168, 244, 0.85),
    1.6rpx 1.6rpx 0 rgba(205, 168, 244, 0.85), -1.6rpx -1.6rpx 0 rgba(205, 168, 244, 0.85),
    1.6rpx -1.6rpx 0 rgba(205, 168, 244, 0.85), -1.6rpx 1.6rpx 0 rgba(205, 168, 244, 0.85),
    0 4rpx 0 rgba(120, 84, 160, 0.22),
    0 0 9rpx rgba(199, 155, 242, 0.28);
  animation-delay: 1.1s; animation-duration: 3s; }
@keyframes pcFloat {
  0%, 100% { transform: translateY(0) rotate(-8deg); }
  50%      { transform: translateY(-10rpx) rotate(8deg); }
}

/* ---- v73 页缘橙色果冻波浪（参考图底部橙丘，替换灌木） ---- */
.page-flora {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 200rpx;
  pointer-events: none;
  z-index: 0;
}
.fb {
  position: absolute;
  border-radius: 50% 50% 42% 42%;
  background: linear-gradient(180deg, #FFC170 0%, #FF9E4A 62%, #F5862E 100%);
  box-shadow: inset -6rpx -8rpx 0 rgba(216, 108, 28, 0.35),
              inset 0 8rpx 12rpx rgba(255, 236, 200, 0.55);
}
.fb--1 { width: 200rpx; height: 150rpx; left: -70rpx;  bottom: -46rpx; transform: rotate(-8deg); }
.fb--2 { width: 150rpx; height: 110rpx; left: 70rpx;   bottom: -60rpx; opacity: 0.9; }
.fb--3 { width: 110rpx; height: 84rpx;  left: -30rpx;  bottom: 52rpx;  opacity: 0.75; }
.fb--4 { width: 210rpx; height: 160rpx; right: -80rpx; bottom: -50rpx; transform: rotate(7deg); }
.fb--5 { width: 150rpx; height: 112rpx; right: 66rpx;  bottom: -62rpx; opacity: 0.9; }
.fb--6 { width: 104rpx; height: 80rpx;  right: -22rpx; bottom: 50rpx;  opacity: 0.75; }

/* ========== 自定义导航栏 ========== */
.nav-bar {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}
.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;   /* v71: 仅居中木牌匾 */
  /* padding 由内联 style 设置：0 20rpx 对称（v71 无左右按钮） */
  box-sizing: border-box;
}

/* v73/v74：中央糖果牌匾（粉果冻 + 白描边 + 黄糖珠 + 白字粉描边，v74 去🌻题字更纯净）
   v81：题字 46→52rpx 再放大；margin 28→22 补偿，底缘位置不变不压副标题 */
.nav-title {
  flex: 0 1 auto;
  min-width: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  margin: 22rpx 0 0;         /* v81: 28→22（牌匾再变高后继续回收下移量，底缘不动） */
  padding: 12rpx 52rpx;      /* v81: 10/46→12/52 随题字再放大 */
  position: relative;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFB1CB 0%, #FF8FB5 55%, #F76E9C 100%);
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 6rpx 0 rgba(216, 79, 134, 0.5),
              0 12rpx 22rpx rgba(216, 79, 134, 0.32),
              inset 0 6rpx 10rpx rgba(255, 255, 255, 0.85),
              inset 0 -6rpx 12rpx rgba(199, 54, 110, 0.18);
}
/* v73: 牌匾两侧黄糖珠（替换 v72 前的木铆钉） */
.candy-bead {
  position: absolute;
  top: 50%;
  width: 20rpx;              /* v81: 18→20 随牌匾再放大 */
  height: 20rpx;
  margin-top: -10rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFF3B0 0%, #FFD34D 55%, #F5B301 100%);
  box-shadow: 0 2rpx 3rpx rgba(180, 120, 20, 0.35),
              inset 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}
.candy-bead--l { left: 20rpx; }   /* v81: 18→20 随牌匾外移 */
.candy-bead--r { right: 20rpx; }
.nav-title-text {
  color: #FFFFFF;
  font-size: 52rpx;          /* v81: 46→52 题字再大一点（v72 36→40 / v80 40→46） */
  font-weight: 900;
  letter-spacing: 7rpx;      /* v81: 6→7 随字号 */
  white-space: nowrap;
  line-height: 1.15;
  /* v73: 白字粉描边——用 8 向 text-shadow 模拟（text-stroke 会吞字芯，弃用）
     v81: 描边 3.5→4rpx、投影 7→8rpx 随字号再加粗 */
  text-shadow:
    4rpx 0 0 #E8548C, -4rpx 0 0 #E8548C, 0 4rpx 0 #E8548C, 0 -4rpx 0 #E8548C,
    4rpx 4rpx 0 #E8548C, -4rpx -4rpx 0 #E8548C, 4rpx -4rpx 0 #E8548C, -4rpx 4rpx 0 #E8548C,
    0 8rpx 0 rgba(199, 54, 110, 0.4);
}

/* v73 副标题（糖果暖棕，保持参考图深色粗体） */
.brand-sub {
  flex: 0 0 auto;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
  color: #8A5A28;
  letter-spacing: 3rpx;
  text-shadow: 0 1.5rpx 0 rgba(255, 255, 255, 0.65);
  line-height: 1.3;
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
}

/* ========== 主体：纯 flex 一屏，禁止滚动 ========== */
.main-view {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 18rpx 26rpx 16rpx;   /* v75: 顶部 14→18 整体下移 */
  /* v72: 顶部微增，给下移后的牌匾留出缓冲；v70 底部留出安全区 */
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  gap: 20rpx;                /* v75: 18→20 */
  box-sizing: border-box;
  justify-content: space-between;
}

/* ================================================================
   v73 数据条（白色果冻胶囊横排 · 彩色图标 + 标签 + 橙黄果冻数字徽章）
   ================================================================ */
.hud-strip {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 255, 255, 0.68) 58%, rgba(255, 246, 214, 0.78) 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 6rpx 0 rgba(245, 179, 1, 0.24),
              0 12rpx 24rpx rgba(245, 179, 1, 0.2),
              inset 0 4rpx 10rpx rgba(255, 255, 255, 0.9);
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.04s;
}
.hud-item {
  display: flex;
  align-items: center;
  gap: 7rpx;
  min-width: 0;
}
.hud-tap {
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, filter 150ms ease;
}
.hud-tap-hover { transform: scale(0.94); filter: brightness(0.96); }
.hud-ico {
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}
.hud-label {
  font-size: 20rpx;
  font-weight: 800;
  color: #8A5A28;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}
.hud-badge {
  min-width: 36rpx;
  padding: 1rpx 10rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #FFC53D 0%, #FFA53D 100%);   /* v73: 橙黄果冻徽章 */
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 2rpx 0 rgba(232, 137, 27, 0.55),
              inset 0 1rpx 2rpx rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hud-badge-txt {
  font-size: 18rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.5;
  text-shadow: 0 1rpx 0 rgba(200, 120, 10, 0.5);
}

/* ================================================================
   v73 插画横幅（白描边 + 青蓝光晕，保留 PvZ 插画与橙色 VS）
   ================================================================ */
.hero-banner {
  flex: 1.7 1 0;             /* v81: 1.55→1.7 继续吸收大冒险卡回压余量（上限 560 不变防过高） */
  min-height: 320rpx;        /* v80: 300→320 */
  max-height: 560rpx;        /* v80: 496→560，主视觉接住卡片让出高度，避免底部留白（v75 经验） */
  position: relative;
  width: 100%;
  border-radius: 36rpx;
  overflow: hidden;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 0 0 6rpx rgba(124, 200, 250, 0.32),
              0 14rpx 30rpx rgba(90, 150, 220, 0.3),
              inset 0 4rpx 12rpx rgba(255, 255, 255, 0.35);
  animation: rise-in 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.1s;
}
.hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.hero-shine {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0) 30%);
  pointer-events: none;
}
/* VS 大字：中偏右草地留白处（参考图位置），橙黄 + 白描边 + 立体投影 */
.hero-vs {
  position: absolute;
  top: 46%;
  right: 28%;
  transform: translateY(-50%) rotate(-5deg);
  pointer-events: none;
  animation: vsPop 0.6s cubic-bezier(0.2, 0.9, 0.2, 1.2) both;
  animation-delay: 0.32s;
}
.hero-vs-text {
  font-size: 86rpx;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 2rpx;
  color: #FFA125;
  -webkit-text-stroke: 5rpx #FFFFFF;
  text-shadow: 0 5rpx 0 rgba(205, 96, 0, 0.55),
               0 10rpx 22rpx rgba(120, 60, 0, 0.4);
  line-height: 1;
}
@keyframes vsPop {
  0%   { opacity: 0; transform: translateY(-50%) rotate(-5deg) scale(0.4); }
  100% { opacity: 1; transform: translateY(-50%) rotate(-5deg) scale(1); }
}

/* ================================================================
   v73 词库选择：单排六枚糖果果冻胶囊（粉/蓝/橙/薄荷/苹果绿/黄）
   白描边 + 底部挤出 + 顶部高光；选中白圈光晕 + 小芽
   ================================================================ */
.diff-pills {
  flex: 0 0 auto;
  margin-top: 26rpx;         /* v75: 与上方横幅距离增大，顶部小芽（伸出 27rpx）不再被遮挡 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  overflow: visible;
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.16s;
}
.diff-pill {
  position: relative;
  flex-shrink: 0;
  padding: 13rpx 17rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFA5BC 0%, #F76FA0 100%);   /* 默认粉（六色由 --key 覆写） */
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 5rpx 0 rgba(216, 79, 134, 0.45),
              0 10rpx 16rpx rgba(216, 79, 134, 0.22),
              inset 0 4rpx 8rpx rgba(255, 255, 255, 0.75);
  -webkit-tap-highlight-color: transparent;
  transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
}
/* 六色果冻挂钩（v73：WXML diff-pill--{{item.key}}） */
.diff-pill--junior {
  background: linear-gradient(180deg, #7CC8FA 0%, #48A8EE 100%);
  box-shadow: 0 5rpx 0 rgba(47, 143, 212, 0.45), 0 10rpx 16rpx rgba(47, 143, 212, 0.22), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.75);
}
.diff-pill--senior {
  background: linear-gradient(180deg, #FFB25C 0%, #FF9038 100%);
  box-shadow: 0 5rpx 0 rgba(232, 121, 0, 0.45), 0 10rpx 16rpx rgba(232, 121, 0, 0.22), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.75);
}
.diff-pill--ket {
  background: linear-gradient(180deg, #6FDAB8 0%, #3EC49A 100%);
  box-shadow: 0 5rpx 0 rgba(43, 164, 126, 0.45), 0 10rpx 16rpx rgba(43, 164, 126, 0.22), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.75);
}
.diff-pill--pet {
  background: linear-gradient(180deg, #A8E86A 0%, #7ED13E 100%);
  box-shadow: 0 5rpx 0 rgba(95, 176, 42, 0.45), 0 10rpx 16rpx rgba(95, 176, 42, 0.22), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.75);
}
.diff-pill--custom {
  background: linear-gradient(180deg, #FFD34D 0%, #FFC02E 100%);
  box-shadow: 0 5rpx 0 rgba(232, 168, 0, 0.45), 0 10rpx 16rpx rgba(232, 168, 0, 0.22), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.75);
}
.diff-pill-hover {
  transform: scale(0.94) translateY(3rpx);
  box-shadow: 0 2rpx 0 rgba(120, 60, 20, 0.3), inset 0 4rpx 8rpx rgba(255, 255, 255, 0.7);
}
.diff-pill-txt {
  font-size: 23rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  white-space: nowrap;
  text-shadow: 0 2rpx 0 rgba(120, 60, 30, 0.28);
}
/* 选中态：白圈光晕 + 微放大（保持本色果冻） */
.diff-pill.active {
  transform: scale(1.08);
  box-shadow: 0 0 0 5rpx rgba(255, 255, 255, 0.95),
              0 0 26rpx rgba(255, 211, 77, 0.75),
              0 6rpx 0 rgba(120, 60, 30, 0.3),
              0 12rpx 20rpx rgba(120, 60, 30, 0.18),
              inset 0 4rpx 8rpx rgba(255, 255, 255, 0.8);
}
.diff-pill.active .diff-pill-txt {
  color: #FFFFFF;
  text-shadow: 0 2rpx 0 rgba(90, 45, 20, 0.32);
}
/* 顶部小芽：茎 + 两片对生叶（糖果嫩绿，无边框） */
.pill-sprout {
  position: absolute;
  top: -27rpx;
  left: 50%;
  width: 40rpx;
  height: 30rpx;
  margin-left: -20rpx;
  pointer-events: none;
  animation: sproutSway 2.6s ease-in-out infinite;
  transform-origin: 50% 100%;
}
@keyframes sproutSway {
  0%, 100% { transform: rotate(-4deg); }
  50%      { transform: rotate(4deg); }
}
.sprout-stem {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 3.5rpx;
  height: 22rpx;
  margin-left: -1.75rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #7ED13E 0%, #4E9C2A 100%);
}
.sprout-leaf {
  position: absolute;
  top: 0;
  width: 17rpx;
  height: 11rpx;
  background: linear-gradient(180deg, #A8E86A 0%, #7ED13E 100%);
  border-radius: 100% 6rpx 100% 6rpx;
  box-shadow: 0 2rpx 4rpx rgba(90, 150, 40, 0.3);
}
.sprout-leaf--l {
  left: 1rpx;
  transform: rotate(-38deg);
  transform-origin: 100% 100%;
}
.sprout-leaf--r {
  right: 1rpx;
  transform: rotate(38deg) scaleX(-1);
  transform-origin: 100% 100%;
}

/* ================================================================
   v35 自定义词包信息条（v73: 白果冻胶囊 + 淡蓝挤出）
   ================================================================ */
.pack-bar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF6DF 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 5rpx 0 rgba(58, 165, 232, 0.22),
              0 10rpx 18rpx rgba(58, 165, 232, 0.16),
              inset 0 4rpx 8rpx rgba(255, 255, 255, 0.9);
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.21s;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, box-shadow 150ms ease;
}
.pack-bar-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(80, 120, 45, 0.10);
}
.pack-bar-icon {
  font-size: 24rpx;
  line-height: 1;
  flex-shrink: 0;
}
.pack-bar-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: #8A5A28;
  letter-spacing: 0.3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: left;
}
.pack-bar-count {
  flex-shrink: 0;
  font-size: 16rpx;
  font-weight: 800;
  color: #2BA47E;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(62, 201, 140, 0.16);
}
.pack-bar-action {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(74, 52, 42, 0.08);
  font-size: 16rpx;
  font-weight: 700;
  color: var(--farm-ink-soft, #7A6450);
}

/* ================================================================
   v73/v74 大冒险卡（粉→蓝糖果果冻渐变 + 白描边 + 糖星装饰；v74 整体高度紧凑）
   ================================================================ */
.adventure-card {
  flex: 0.75 1 0;            /* v81: 0.9→0.75 单元高度再变矮 */
  min-height: 272rpx;        /* v81: 296→272 */
  max-height: 372rpx;        /* v81: 408→372 整体再矮一档，余量交横幅 */
  display: flex;
  flex-direction: column;
  gap: 3rpx;                 /* v81: 5→3 开始按钮与上方间距收紧 */
  padding: 10rpx 13rpx 8rpx; /* v81: 12/14/10→10/13/8 */
  position: relative;        /* v73: 糖星装饰锚 */
  border-radius: 36rpx;
  background: linear-gradient(168deg, #FFDFEB 0%, #FFF6EC 38%, #E9F7E4 66%, #CFE9FA 100%);
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.65),
              0 16rpx 36rpx rgba(180, 120, 200, 0.28),
              inset 0 6rpx 14rpx rgba(255, 255, 255, 0.85);
  overflow: hidden;
  animation: rise-in 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.26s;
  box-sizing: border-box;
}
/* v73: 卡内糖星装饰（不遮挡内容层） */
.card-star {
  position: absolute;
  line-height: 1;
  pointer-events: none;
  z-index: 0;
  opacity: 0.92;
  filter: drop-shadow(0 3rpx 4rpx rgba(216, 120, 80, 0.25));
}
.card-star--1 { left: 22rpx; top: 16rpx; font-size: 30rpx; animation: pcFloat 3.2s ease-in-out infinite; }
.card-star--2 { right: 180rpx; top: 12rpx; font-size: 24rpx; animation: pcFloat 3.8s ease-in-out 0.8s infinite; }
.adventure-card > .ac-body,
.adventure-card > .ac-start { position: relative; z-index: 1; }
/* v70: 上段（左插画 + 右文案/徽章），高度自适应吃掉余量 */
.ac-body {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  align-items: center;       /* v72: 图文两块垂直居中，中心线对齐 */
  gap: 14rpx;                /* v72: 图文水平间距收紧 */
}
/* 左侧插画合影（白框圆角小图，向日葵+坚果+寒冰射手+金杯）
   v72 定高居中；v81 随卡再回压同步收紧（188×172→178×158） */
.ac-illu {
  position: relative;
  width: 178rpx;
  height: 158rpx;            /* v81: 188×172→178×158 */
  align-self: center;        /* v72: 中心线与右侧文案对齐 */
  flex-shrink: 0;
  border-radius: 26rpx;
  overflow: hidden;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.55),
              0 10rpx 20rpx rgba(216, 79, 134, 0.18);
  background: #FFF4E4;
}
.ac-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.ac-illu-ring {
  position: absolute;
  inset: 0;
  border-radius: 18rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.55);
  pointer-events: none;
}
/* 右侧文案区 */
.ac-main {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 7rpx;                 /* v80: 8→7 */
}
/* v73: 卡标题双色分段（粉橙「单词农场」+ 天蓝「大冒险」，白描边蛋仔字） */
.ac-title {
  display: flex;
  align-items: baseline;
  letter-spacing: 2rpx;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
}
.ac-title-a,
.ac-title-b {
  font-size: 38rpx;          /* v80: 36→38 卡题字微放大（用户：单词农场再大一点） */
  font-weight: 900;
}
.ac-title-a {
  color: #FF6E9C;
  /* 白描边蛋仔字（8 向 text-shadow，保字芯） */
  text-shadow:
    2.5rpx 0 0 #FFFFFF, -2.5rpx 0 0 #FFFFFF, 0 2.5rpx 0 #FFFFFF, 0 -2.5rpx 0 #FFFFFF,
    2.5rpx 2.5rpx 0 #FFFFFF, -2.5rpx -2.5rpx 0 #FFFFFF, 2.5rpx -2.5rpx 0 #FFFFFF, -2.5rpx 2.5rpx 0 #FFFFFF,
    0 5rpx 0 rgba(232, 93, 138, 0.3);
}
.ac-title-b {
  color: #38BDF0;
  text-shadow:
    2.5rpx 0 0 #FFFFFF, -2.5rpx 0 0 #FFFFFF, 0 2.5rpx 0 #FFFFFF, 0 -2.5rpx 0 #FFFFFF,
    2.5rpx 2.5rpx 0 #FFFFFF, -2.5rpx -2.5rpx 0 #FFFFFF, 2.5rpx -2.5rpx 0 #FFFFFF, -2.5rpx 2.5rpx 0 #FFFFFF,
    0 5rpx 0 rgba(42, 140, 200, 0.3);
}
.ac-sub {
  font-size: 22rpx;          /* v72: 紧凑回调（v71 24rpx） */
  font-weight: 700;
  color: #8A5A28;
  letter-spacing: 1rpx;
  line-height: 1.3;
}
.ac-chips {
  display: grid;             /* v70: 两列网格，四个标签严格两排两列 */
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;                 /* v74: 10→8 */
  margin-top: 0;             /* v72: 依赖 ac-main gap，去除额外偏移 */
}
/* 白果冻玩法徽章（2×2 两排两列；v74 padding/字号同步收紧） */
.bchip {
  display: flex;
  align-items: center;
  gap: 8rpx;                 /* v74: 10→8 */
  padding: 8rpx 12rpx;       /* v74: 10/14→8/12 */
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF7EA 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 0 rgba(216, 79, 134, 0.22),
              0 8rpx 14rpx rgba(150, 110, 60, 0.14),
              inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
  min-width: 0;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, box-shadow 150ms ease;
}
/* 四枚徽章淡彩描边（绿/黄/橙/蓝，与图标色呼应） */
.bchip--a1 {
  border-color: #C9ECAD;
  box-shadow: 0 4rpx 0 rgba(126, 209, 62, 0.4), 0 8rpx 14rpx rgba(110, 150, 50, 0.16), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92);
}
.bchip--a2 {
  border-color: #FFE9A8;
  box-shadow: 0 4rpx 0 rgba(245, 179, 1, 0.35), 0 8rpx 14rpx rgba(200, 150, 20, 0.16), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92);
}
.bchip--a3 {
  border-color: #FFD1B0;
  box-shadow: 0 4rpx 0 rgba(255, 144, 56, 0.4), 0 8rpx 14rpx rgba(220, 110, 30, 0.16), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92);
}
.bchip--a4 {
  border-color: #BFDCFA;
  box-shadow: 0 4rpx 0 rgba(72, 168, 238, 0.4), 0 8rpx 14rpx rgba(50, 130, 200, 0.16), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92);
}
.bchip-hover {               /* 点击徽章的果冻按压反馈 */
  transform: scale(0.94) translateY(2rpx);
  box-shadow: 0 1rpx 0 rgba(120, 60, 20, 0.2),
              inset 0 3rpx 6rpx rgba(255, 255, 255, 0.8);
}
.bchip-ico {
  font-size: 22rpx;          /* v74: 24→22 */
  line-height: 1;
  flex-shrink: 0;
}
.bchip-txt {
  font-size: 20rpx;          /* v74: 21→20 */
  font-weight: 800;
  color: #7A4E22;
  letter-spacing: 0.3rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ================================================================
   v73 大冒险卡下段：「开始冒险」橙黄果冻大按钮居中；奖励中心粉橙果冻球锚卡右下角
   ================================================================ */
.ac-start {
  flex: 0 0 auto;
  position: relative;        /* 奖励中心定位锚 */
  display: flex;
  align-items: center;
  justify-content: center;   /* 按钮真正居中 */
  padding: 0;
  animation: rise-in 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;
  animation-delay: 0.32s;
}
.start-btn {
  width: 58%;
  margin: 0 auto;
  height: 74rpx;             /* v80: 78→74 随卡再回压 */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFD95E 0%, #FFB020 62%, #FF9C1B 100%);
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 0 rgba(232, 137, 27, 0.85),
              0 16rpx 28rpx rgba(232, 137, 27, 0.35),
              inset 0 6rpx 12rpx rgba(255, 255, 255, 0.75),
              inset 0 -6rpx 12rpx rgba(216, 110, 20, 0.22);
  -webkit-tap-highlight-color: transparent;
  transition: transform 130ms ease, box-shadow 130ms ease, filter 130ms ease;
}
.start-btn-hover {
  transform: translateY(5rpx) scale(0.99);
  filter: brightness(0.98);
  box-shadow: 0 3rpx 0 rgba(232, 137, 27, 0.85),
              0 8rpx 16rpx rgba(232, 137, 27, 0.28),
              inset 0 6rpx 12rpx rgba(255, 255, 255, 0.7);
}
.start-btn-label {
  font-size: 34rpx;          /* v76: 36→34 随卡回压 */
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 6rpx;      /* v74: 8→6 */
  margin-right: -6rpx;    /* 抵消末字字距，视觉居中 */
  line-height: 1.1;
  /* v73: 白字橙描边——8 向 text-shadow 模拟（保字芯） */
  text-shadow:
    3rpx 0 0 #F08A00, -3rpx 0 0 #F08A00, 0 3rpx 0 #F08A00, 0 -3rpx 0 #F08A00,
    3rpx 3rpx 0 #F08A00, -3rpx -3rpx 0 #F08A00, 3rpx -3rpx 0 #F08A00, -3rpx 3rpx 0 #F08A00,
    0 6rpx 0 rgba(200, 110, 10, 0.4);
}

/* ================================================================
   v33 新增：「立即了解」玩法介绍弹窗（左对齐·卡片式·替代原生 showModal）
   - 遮罩：淡紫糖果半透 + 毛玻璃，点击关闭；卡片 pop 弹入（回弹曲线）
   - 规则行：数字徽章（六色渐变循环）+ 标题/描述，全部左对齐
   - 逐条错峰淡入（内联 animation-delay）；小屏 scroll-view 兜底滚动
   - 底部：亲子积分联动提示（v32）+ 薄荷果冻 CTA（v73 糖果化）
   ================================================================ */
.km-mask {
  position: absolute;
  inset: 0;
  background: rgba(120, 84, 160, 0.42);   /* v73: 淡紫糖果遮罩 */
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 36rpx;
  box-sizing: border-box;
  z-index: 200;              /* 高于导航栏/CTA(z1)，全页覆盖 */
  animation: kmFadeIn 0.28s ease-out;
}
@keyframes kmFadeIn { from { opacity: 0; } to { opacity: 1; } }

.km-card {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  flex-direction: column;
  padding: 30rpx 28rpx 26rpx;
  box-sizing: border-box;
  /* v73：白果冻卡 + 粉白双层描边 */
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF6E9 100%);
  border-radius: 40rpx;
  border: 6rpx solid #FFFFFF;
  box-shadow:
    0 12rpx 0 rgba(216, 79, 134, 0.16),
    0 26rpx 48rpx rgba(120, 84, 160, 0.32),
    inset 0 0 0 3rpx rgba(255, 205, 225, 0.55),
    inset 0 4rpx 0 rgba(255, 255, 255, 0.9);
  animation: kmPop 0.42s cubic-bezier(.2,.9,.2,1.15);
}
@keyframes kmPop {
  0%   { opacity: 0; transform: scale(0.82) translateY(24rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

/* ---- 头部：🌱 徽标 + 标题副标题（左） · 关闭 ✕（右） ---- */
.km-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.km-head-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.km-head-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 2rpx;
  min-width: 0;
}
.km-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  /* v73：薄荷果冻徽标砖 */
  background: linear-gradient(180deg, #FFFFFF, #E2F8EC);
  border: 3rpx solid #BFE8D2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(46, 168, 140, 0.22), inset 0 2rpx 0 rgba(255,255,255,0.9);
  flex-shrink: 0;
}
.km-logo-emoji {
  font-size: 36rpx;
  line-height: 1;
  animation: kmSway 2.8s ease-in-out infinite;
}
@keyframes kmSway {
  0%, 100% { transform: rotate(-7deg); }
  50%      { transform: rotate(7deg); }
}
.km-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #7A4E22;
  letter-spacing: 1rpx;
  line-height: 1.2;
}
.km-subtitle {
  font-size: 16rpx;
  font-weight: 500;
  color: #A9885E;
  margin-top: 4rpx;
  letter-spacing: 0.5rpx;
}
.km-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(232, 93, 138, 0.1);
  border: 2rpx solid rgba(232, 93, 138, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #D94F86;
  flex-shrink: 0;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, background 150ms ease;
}
.km-close-hover {
  transform: scale(0.88);
  background: rgba(232, 93, 138, 0.2);
}

/* ---- 分割线：粉糖果虚线 ---- */
.km-divider {
  height: 0;
  margin: 22rpx 4rpx 24rpx;
  flex-shrink: 0;
  border-top: 3rpx dashed rgba(232, 93, 138, 0.4);
}

/* ---- 规则列表：左对齐行式布局，小屏兜底滚动 ---- */
.km-list {
  flex: 0 1 auto;
  min-height: 0;
  max-height: 760rpx;
}
.km-row {
  display: flex;
  align-items: flex-start;       /* 左对齐核心：徽章与文字块顶对齐 */
  gap: 14rpx;
  padding: 15rpx 16rpx;
  /* v73：淡彩果冻便签 + 白描边 + 粉左条 */
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-left-width: 6rpx;
  border-left-color: rgba(216, 79, 134, 0.4);
  box-shadow: 0 3rpx 8rpx rgba(150, 110, 60, 0.1);
  box-sizing: border-box;
  opacity: 0;
  animation: kmRowIn 0.4s ease-out forwards;   /* 逐条淡入（delay 见内联） */
  -webkit-tap-highlight-color: transparent;
}
.km-row + .km-row { margin-top: 14rpx; }
@keyframes kmRowIn {
  from { opacity: 0; transform: translateY(14rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.km-num {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,0.4), 0 3rpx 6rpx rgba(0,0,0,0.08);
  border: 2rpx solid rgba(255,255,255,0.85);
  flex-shrink: 0;
  margin-top: -5rpx;           /* v58 2→-5：徽章中心对齐标题行（VLM P0） */
}
.km-body {
  flex: 1 1 auto;
  min-width: 0;
  text-align: left;              /* 文字块整体左对齐 */
}
.km-row-title {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #7A4E22;
  line-height: 1.3;
  letter-spacing: 0.3rpx;
}
.km-row-icon { font-size: 22rpx; line-height: 1; }
.km-row-name { flex: 1 1 auto; min-width: 0; }
.km-row-desc {
  margin-top: 8rpx;
  font-size: 17rpx;
  font-weight: 500;
  color: #A9885E;
  line-height: 1.6;
  letter-spacing: 0.2rpx;
  text-align: left;              /* 描述左对齐（不两端对齐，避免拉伸） */
}

/* ---- 联动提示：亲子积分 → 奖励中心（v32） ---- */
.km-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 16rpx 2rpx 4rpx;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, rgba(255, 193, 7, 0.10), rgba(255, 193, 7, 0.03));
  -webkit-tap-highlight-color: transparent;
}
.km-tip-icon { font-size: 20rpx; line-height: 1; flex-shrink: 0; }
.km-tip-text {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 16rpx;
  font-weight: 500;
  color: #A16207;
  letter-spacing: 0.2rpx;
  text-align: left;
}
.km-tip-link {
  flex-shrink: 0;
  font-size: 16rpx;
  font-weight: 800;
  color: #D97706;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease, opacity 150ms ease;
}
.km-tip-link-hover { transform: scale(0.94); opacity: 0.8; }

/* ---- CTA：薄荷果冻胶囊按钮（v73 糖果化） ---- */
.km-cta {
  position: relative;
  margin-top: 24rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  border: 3rpx solid #FFFFFF;
  background-image: linear-gradient(180deg, #7EE0A8 0%, #3EC98C 62%, #2FB98C 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow:
    0 6rpx 0 rgba(43, 164, 126, 0.8),
    0 12rpx 22rpx rgba(43, 164, 126, 0.28),
    inset 0 4rpx 10rpx rgba(255,255,255,0.55);
  -webkit-tap-highlight-color: transparent;
  transition: transform 130ms ease, box-shadow 130ms ease, filter 130ms ease;
}
.km-cta-shine {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(255,255,255,0.4), rgba(255,255,255,0));
  pointer-events: none;
}
.km-cta-text {
  font-size: 26rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 3rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 0 rgba(30, 120, 90, 0.45);
}
.km-cta-arrow {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(255,255,255,0.95);
  line-height: 1;
}
.km-cta-hover {
  transform: translateY(4rpx) scale(0.99);
  filter: brightness(0.98);
  box-shadow:
    0 2rpx 0 rgba(43, 164, 126, 0.8),
    0 6rpx 12rpx rgba(43, 164, 126, 0.22),
    inset 0 4rpx 10rpx rgba(255,255,255,0.5);
}

/* ================================================================
   v73/v75 奖励球：v74 去掉文字标签，v75 改「龙珠一星」——橙黄半透明果冻珠
   + 居中红四尖星（clip-path），fabBob 浮动；点击不变，绝对定位锚卡右下角
   ================================================================ */
.reward-fab {
  position: absolute;
  right: 4rpx;               /* v74: 球加大后贴角微调 */
  bottom: 2rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  -webkit-tap-highlight-color: transparent;
  transition: transform 150ms ease;
}
.reward-fab-hover { transform: scale(0.92); }
.fab-ico {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  /* v75: 粉橙糖果球→橙黄龙珠 */
  background: radial-gradient(circle at 34% 26%,
    rgba(255, 246, 201, 0.96) 0%, rgba(255, 222, 107, 0.94) 34%,
    rgba(255, 182, 39, 0.94) 70%, rgba(240, 154, 26, 0.94) 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 6rpx 0 rgba(216, 120, 20, 0.45),
              0 12rpx 20rpx rgba(216, 120, 20, 0.3),
              inset 0 4rpx 8rpx rgba(255, 255, 255, 0.65),
              inset 0 -4rpx 8rpx rgba(216, 110, 20, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fabBob 2.6s ease-in-out infinite;
}
/* v75: 球心红四尖星（龙珠星形）：clip-path 八点四尖，微倾斜更生动 */
.db-star-shape {
  width: 44rpx;
  height: 44rpx;
  margin-top: -4rpx;
  background: linear-gradient(180deg, #FF6A3D 0%, #F0350E 100%);
  clip-path: polygon(50% 0%, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0% 50%, 39% 39%);
  transform: rotate(-14deg);
  filter: drop-shadow(0 2rpx 3rpx rgba(180, 40, 10, 0.45));
}
/* 果冻高光（v75: 去白色星芒，龙珠星为球面主角） */
.fab-spark {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.fab-spark::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 12rpx;
  width: 18rpx;
  height: 11rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  transform: rotate(-24deg);
  filter: blur(1rpx);
}
@keyframes fabBob {
  0%, 100% { transform: translateY(0) rotate(-3deg); }
  50%      { transform: translateY(-5rpx) rotate(3deg); }
}
