<!-- pages/index/index.wxml — v72 牌匾升级与卡内紧凑（在 v71 基础上按反馈调整）
  v72 更新：
    · 牌匾「单词农场」再靠下（margin-top 加大）、题字加大（36→40rpx），左侧新增🌻农场图标
    · 大冒险卡：左侧插画改为定高居中（不再 stretch），与右侧文案块高度基本相当、中心线对齐
    · 右侧文案/徽章间距收紧（ac-main gap 18→12、徽章内衬 12→10rpx 等），图文整体更紧凑
  v71 更新：
    · 导航只保留居中木牌匾「单词农场」（居中、靠下）；左侧返回钮与右侧⚙️钮取消
    · 「怎么玩」弹窗改由大冒险卡内四个玩法徽章点击打开（onKnowMore 由 bchip 承接）
    · 右侧文案/徽章放大（标题/副标/白胶囊字号与内衬加大），与左侧插画高度基本相当
    · 「开始冒险」在卡内水平居中，卡内空隙收紧；奖励中心红浆果钮仍锚定卡右下角（绝对定位）
  v67-v70 历史见 git log；数据绑定与事件零破坏（onBack 移除、onKnowMore 换承载点）
  布局结构（v71）：
    .page (flex column, 高度 {{pageHeight}}rpx, overflow:hidden)
      ├── page-flora         底部灌木装饰（绝对定位，不入流）
      ├── nav-bar            自定义导航（仅居中木牌匾 + 🌻 图标）
      ├── .main-view         纯 flex 主体，禁止滚动
      │   ├── brand-sub      副标题
      │   ├── hud-strip      数据胶囊条（最高分/游戏次数/音效/亲子积分）
      │   ├── hero-banner    PvZ 插画横幅（图 + VS 大字）
      │   ├── diff-pills     词库木牌 ×6
      │   ├── pack-bar       自定义词包信息条（条件渲染）
      │   └── adventure-card 大冒险卡（左插画 + 右文案/2×2徽章可点开玩法 + 居中开始按钮 + 右下角奖励中心）
      └── km-mask            「立即了解」玩法弹窗
-->
<view class="page" style="height: {{pageHeight}}rpx;">

  <!-- ============ v69: 页面底部灌木丛装饰（参考图页缘绿植） ============ -->
  <view class="page-flora">
    <view class="fb fb--1"></view>
    <view class="fb fb--2"></view>
    <view class="fb fb--3"></view>
    <view class="fb fb--4"></view>
    <view class="fb fb--5"></view>
    <view class="fb fb--6"></view>
  </view>

  <!-- ============ 自定义导航栏（居中木牌匾：🌻 图标 + 题字，双铆钉） ============ -->
  <view
    class="nav-bar"
    style="padding-top: {{statusBarHeight}}px; height: calc({{statusBarHeight}}px + {{navBarHeight}}px);"
  >
    <view class="nav-bar-inner" style="height: {{navBarHeight}}px; padding: 0 20rpx;">
      <view class="nav-title">
        <view class="board-screw board-screw--l"></view>
        <text class="nav-logo-ico">🌻</text>
        <text class="nav-title-text">单词农场</text>
        <view class="board-screw board-screw--r"></view>
      </view>
    </view>
  </view>

  <!-- ============ 纯 flex 主体（严格一屏，禁止滚动） ============ -->
  <view class="main-view">

    <!-- 1. 副标题（参考图：牌匾正下方棕色粗体） -->
    <view class="brand-sub">背单词，保卫农场</view>

    <!-- 2. 数据条：最高分 / 游戏次数 / 音效 / 亲子积分（参考图卡其胶囊） -->
    <view class="hud-strip">
      <view class="hud-item">
        <text class="hud-ico">🏆</text>
        <text class="hud-label">最高分</text>
        <view class="hud-badge"><text class="hud-badge-txt">{{highestScore}}</text></view>
      </view>
      <view class="hud-item">
        <text class="hud-ico">🎮</text>
        <text class="hud-label">游戏次数</text>
        <view class="hud-badge"><text class="hud-badge-txt">{{totalGames}}</text></view>
      </view>
      <view class="hud-item hud-tap" bindtap="onToggleSound" hover-class="hud-tap-hover">
        <text class="hud-ico">{{soundEnabled ? '🔊' : '🔇'}}</text>
        <text class="hud-label">音效</text>
      </view>
      <view class="hud-item hud-tap" bindtap="onOpenRewards" hover-class="hud-tap-hover">
        <text class="hud-ico">👤</text>
        <text class="hud-label">亲子积分</text>
        <view class="hud-badge"><text class="hud-badge-txt">{{rewardPoints}}</text></view>
      </view>
    </view>

    <!-- 3. PvZ 插画横幅（参考图主视觉：植物 VS 僵尸 + 橙色描边 VS） -->
    <view class="hero-banner">
      <image class="hero-img" src="/images/banner-hero.jpg" mode="aspectFill" />
      <view class="hero-shine"></view>
      <view class="hero-vs"><text class="hero-vs-text">VS</text></view>
    </view>

    <!-- 4. 词库选择：单排六枚木牌（选中亮柠绿 + 白光圈 + 顶部小芽） -->
    <view class="diff-pills">
      <block wx:for="{{difficulties}}" wx:key="key">
        <view
          class="diff-pill {{difficulty === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectDifficulty"
          hover-class="diff-pill-hover"
        >
          <view wx:if="{{difficulty === item.key}}" class="pill-sprout">
            <view class="sprout-stem"></view>
            <view class="sprout-leaf sprout-leaf--l"></view>
            <view class="sprout-leaf sprout-leaf--r"></view>
          </view>
          <text class="diff-pill-txt">{{item.name}}</text>
        </view>
      </block>
    </view>

    <!-- v35: 自定义词包信息条（已导入时显示：书名 + 词数 + 管理入口） -->
    <view wx:if="{{customPackInfo}}" class="pack-bar" bindtap="_manageWordPack" hover-class="pack-bar-hover">
      <text class="pack-bar-icon">📚</text>
      <text class="pack-bar-name">{{customPackInfo.name}}</text>
      <text class="pack-bar-count">{{customPackInfo.count}} 词</text>
      <text class="pack-bar-action">管理 ›</text>
    </view>

    <!-- 5. 大冒险卡（v72：左插画定高与右文案块等高居中 + 卡内底部「开始冒险」 + 右下角奖励中心） -->
    <view class="adventure-card">
      <view class="ac-body">
        <view class="ac-illu">
          <image class="ac-img" src="/images/card-plants.jpg" mode="aspectFill" />
          <view class="ac-illu-ring"></view>
        </view>
        <view class="ac-main">
          <view class="ac-title">单词农场大冒险</view>
          <view class="ac-sub">背单词、养植物、闯关拿奖励</view>
          <view class="ac-chips">
            <block wx:for="{{howtoList}}" wx:key="id">
              <view
                class="bchip"
                bindtap="onKnowMore"
                hover-class="bchip-hover"
              >
                <text class="bchip-ico">{{item.icon}}</text>
                <text class="bchip-txt">{{item.title}}</text>
              </view>
            </block>
          </view>
        </view>
      </view>
      <!-- 卡内底部：开始冒险居中 + 奖励中心锚定右下角（绝对定位，v71） -->
      <view class="ac-start">
        <view class="start-btn" bindtap="onStart" hover-class="start-btn-hover">
          <text class="start-btn-label">开始冒险</text>
        </view>
        <view class="reward-fab" bindtap="onOpenRewards" hover-class="reward-fab-hover">
          <view class="fab-ico">
            <view class="fab-spark"></view>
          </view>
          <view class="fab-label">奖励中心</view>
        </view>
      </view>
    </view>

  </view>

  <!-- ============ v33: 「立即了解」玩法介绍弹窗（左对齐卡片式，替代原生 showModal） ============ -->
  <view wx:if="{{knowMoreVisible}}" class="km-mask" bindtap="onKnowMoreClose" catchtouchmove="noop">
    <view class="km-card" catchtap="noop">

      <!-- 头部：🌱 徽标 + 标题/副标题（左） · 关闭 ✕（右） -->
      <view class="km-head">
        <view class="km-head-left">
          <view class="km-logo">
            <text class="km-logo-emoji">🌱</text>
          </view>
          <view class="km-head-text">
            <view class="km-title">怎么玩？</view>
            <view class="km-subtitle">两分钟上手，守护你的小农场</view>
          </view>
        </view>
        <view class="km-close" bindtap="onKnowMoreClose" hover-class="km-close-hover">✕</view>
      </view>

      <view class="km-divider"></view>

      <!-- 规则列表：数字徽章 + 标题 + 描述（全部左对齐，逐条错峰淡入） -->
      <scroll-view class="km-list" scroll-y="true">
        <view
          wx:for="{{knowMoreList}}"
          wx:key="id"
          class="km-row"
          style="background: {{item.bg}}; animation-delay: {{index * 60}}ms;"
        >
          <view class="km-num" style="background: {{item.numBg}}; color: {{item.numColor}};">{{index + 1}}</view>
          <view class="km-body">
            <view class="km-row-title">
              <text class="km-row-icon">{{item.icon}}</text>
              <text class="km-row-name">{{item.title}}</text>
            </view>
            <view class="km-row-desc">{{item.desc}}</view>
          </view>
        </view>

        <!-- 底部联动提示：亲子积分 → 奖励中心（v32） -->
        <view class="km-tip">
          <text class="km-tip-icon">🎁</text>
          <text class="km-tip-text">通关可攒亲子积分，兑换专属小心愿</text>
          <text class="km-tip-link" bindtap="onKnowMoreGoRewards" hover-class="km-tip-link-hover">去瞧瞧 ›</text>
        </view>
      </scroll-view>

      <!-- CTA：绿色渐变胶囊「我知道啦」 -->
      <view class="km-cta" bindtap="onKnowMoreConfirm" hover-class="km-cta-hover">
        <text class="km-cta-shine"></text>
        <text class="km-cta-text">我知道啦</text>
        <text class="km-cta-arrow">›</text>
      </view>

    </view>
  </view>

</view>
