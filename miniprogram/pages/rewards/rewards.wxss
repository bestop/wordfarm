/* pages/rewards/rewards.wxss - 亲子奖励中心样式 (v32)
 * v63「木语农场」重设计：
 *   · 页底：草甸渐变；钱包 = 皮革缝线零钱袋；档位卡 = 米黄纸签 + 彩色左缘压条
 *   · 奖励卡 = 挂签纸卡（打孔 + 麻绳痕）；兑换按钮 = 叶绿木印；记录 = 账本纸
 */

.reward-page {
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(120% 60% at 50% -6%, #FFF7D6 0%, rgba(255,247,214,0) 55%),
    linear-gradient(180deg, #B8E6FF 0%, #DDF3C8 30%, #F7EFCF 62%, #FFF9EA 100%);
  overflow: hidden;
}
.rp-scroll {
  flex: 1 1 auto;
  min-height: 0;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

/* ============ 积分钱包卡 ============ */
/* v63：皮革零钱袋（棕革渐变 + 白色缝线 + 铜扣高光） */
.rp-wallet {
  padding: 26rpx 30rpx 20rpx;
  box-sizing: border-box;
  border-radius: 26rpx 34rpx 28rpx 36rpx / 32rpx 26rpx 36rpx 28rpx;
  background-image:
    repeating-linear-gradient(178deg,
      rgba(42, 24, 12, 0.06) 0 2rpx,
      rgba(42, 24, 12, 0) 2rpx 18rpx),
    linear-gradient(180deg,
      rgba(255, 235, 200, 0.20) 0%,
      rgba(255, 235, 200, 0) 40%,
      rgba(42, 24, 12, 0.18) 100%),
    linear-gradient(160deg, #C68A58 0%, #9A6238 55%, #74492A 100%);
  border: 4rpx solid #6B4224;
  box-shadow:
    0 10rpx 0 rgba(63, 38, 20, 0.35),
    0 16rpx 32rpx rgba(74, 52, 42, 0.35),
    inset 0 2rpx 0 rgba(255, 235, 200, 0.35);
  color: #FFF8EA;
  position: relative;
}
/* 内圈白色缝线（皮革手缝感） */
.rp-wallet::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 3rpx dashed rgba(255, 244, 214, 0.45);
  border-radius: 20rpx 28rpx 22rpx 30rpx / 26rpx 20rpx 30rpx 22rpx;
  pointer-events: none;
}
.rp-wallet-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.rp-wallet-icon {
  font-size: 64rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.18));
  animation: walletBob 2.8s ease-in-out infinite;
}
@keyframes walletBob {
  0%, 100% { transform: translateY(0) rotate(-4deg); }
  50%      { transform: translateY(-8rpx) rotate(4deg); }
}
.rp-wallet-main {
  flex: 1 1 auto;
  min-width: 0;
}
.rp-wallet-points {
  font-size: 60rpx;   /* v59: 64→60 与三列小数据拉开层级又保冲击力 */
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 3rpx 8rpx rgba(42, 24, 12, 0.35);
}
.rp-wallet-label {
  margin-top: 6rpx;   /* v59: 主数字-副标题呼吸感 */
  font-size: 20rpx;
  font-weight: 700;
  opacity: 0.92;
  letter-spacing: 1rpx;
}
.rp-wallet-meta {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  /* v63：皮革内袋（深色内凹） */
  background: rgba(42, 24, 12, 0.28);
  box-shadow: inset 0 3rpx 6rpx rgba(42, 24, 12, 0.4);
}
.rp-meta {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.rp-meta-num {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.rp-meta-label {
  font-size: 15rpx;
  font-weight: 600;
  opacity: 0.92;
}
.rp-meta-divider {
  flex: 0 0 auto;
  width: 2rpx;
  height: 40rpx;
  background: rgba(255, 244, 214, 0.5);
  border-radius: 1rpx;
}

/* ============ 月度进度条 ============ */
.rp-month-progress {
  margin: 16rpx 6rpx 4rpx;
  position: relative;   /* v59: 终点旗标定位锚 */
}
/* v59: 终点 🏁 旗标 — 600 分长线目标具象化, 强化「快到了」的渴望感 */
.rp-month-progress::after {
  content: '🏁';
  position: absolute;
  right: -4rpx;
  top: -14rpx;
  font-size: 24rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 2rpx rgba(180, 83, 9, 0.25));
}
.rp-month-bar {
  height: 16rpx;   /* v59: 12→16 能量槽感（儿童游戏化进度） */
  border-radius: 999rpx;
  background: #FFF3D9;
  border: 1rpx solid #FFE082;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(180, 83, 9, 0.12);
}
.rp-month-fill {
  height: 100%;
  min-width: 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFD54F, #FB8C00);
  box-shadow: 0 0 6rpx rgba(251, 140, 0, 0.5);
  transition: width 0.6s cubic-bezier(.2,.9,.2,1);
}
.rp-month-text {
  margin-top: 6rpx;
  font-size: 16rpx;
  font-weight: 700;
  color: #A1782B;
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ============ 三档奖励区 ============ */
.rp-tier {
  margin-top: 28rpx;   /* v59: 模块间距呼吸感 */
  padding: 20rpx 20rpx 16rpx;
  box-sizing: border-box;
  /* v63：米黄纸签卡（手绘抖动圆角 + 墨线 + 纸纹） */
  border-radius: 20rpx 28rpx 24rpx 30rpx / 26rpx 20rpx 30rpx 24rpx;
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.04) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 26rpx),
    linear-gradient(180deg, #FFFDF7 0%, #FFF6E0 100%);
  border: 2rpx solid rgba(74, 52, 42, 0.45);
  box-shadow: 2rpx 3rpx 0 rgba(74, 52, 42, 0.10),
              0 8rpx 18rpx rgba(74, 52, 42, 0.12);
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;   /* v63 错峰入场 */
}
/* v63: 三档错峰延迟（用档位类而非 nth-of-type，wx:if 场景下定位更稳） */
.tier-instant { animation-delay: 0.02s; }
.tier-weekend { animation-delay: 0.10s; }
.tier-grand   { animation-delay: 0.18s; }
/* 各档主题色（左缘厚压条 + 标题色，v63 保留识别色） */
.tier-instant { border-left: 10rpx solid #5FC55E; }
.tier-weekend { border-left: 10rpx solid #FFB300; }
.tier-grand   { border-left: 10rpx solid #42A5F5; }

.rp-tier-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rp-tier-icon {
  font-size: 22rpx;
  line-height: 1;
}
.rp-tier-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  color: #4A342A;
  letter-spacing: 1rpx;
}
.tier-instant .rp-tier-name { color: #2E7D32; }
.tier-weekend .rp-tier-name { color: #B45309; }
.tier-grand   .rp-tier-name { color: #1565C0; }

.rp-tier-chip {
  flex-shrink: 0;
  max-width: 46%;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rp-tier-chip.on {
  color: #FFFFFF;
  background: linear-gradient(135deg, #81C784, #43A047);
  box-shadow: 0 3rpx 8rpx rgba(67, 160, 71, 0.35);
}
.rp-tier-chip.off {
  color: #7A6450;
  background: #FFF9EA;                    /* v63: 纸底 */
  border: 2rpx dashed rgba(74, 52, 42, 0.4);  /* v63: 虚线墨框 = 待解锁印记 */
  box-shadow: none;
}
.tier-weekend .rp-tier-chip.on { background: linear-gradient(135deg, #FFD54F, #FB8C00); }
.tier-grand   .rp-tier-chip.on { background: linear-gradient(135deg, #64B5F6, #1E88E5); }

.rp-tier-sub {
  margin-top: 6rpx;
  font-size: 16rpx;
  font-weight: 600;
  color: #7A6450;
  letter-spacing: 0.4rpx;
}

/* ============ 奖励卡网格 ============ */
.rp-grid {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.rp-item {
  width: calc((100% - 12rpx) / 2);
  box-sizing: border-box;
  padding: 14rpx 14rpx 12rpx;
  /* v63：挂签纸卡（右上打孔 + 墨线框） */
  border-radius: 12rpx 18rpx 14rpx 20rpx / 16rpx 12rpx 20rpx 14rpx;
  background:
    radial-gradient(circle at calc(100% - 12rpx) 12rpx, #FBF3E2 0 5rpx, rgba(74, 52, 42, 0.55) 5rpx 7rpx, rgba(74, 52, 42, 0) 8rpx),
    linear-gradient(180deg, #FFFDF7 0%, #FFF6E0 100%);
  border: 2rpx solid rgba(74, 52, 42, 0.45);
  box-shadow: 1rpx 2rpx 0 rgba(74, 52, 42, 0.08),
              0 4rpx 10rpx rgba(74, 52, 42, 0.10);
  transition: transform 150ms ease;
}
.rp-item.locked {
  opacity: 0.72;
}
.rp-item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rp-item-emoji {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #FFFDF5;
  border-radius: 14rpx 20rpx 16rpx 22rpx / 18rpx 14rpx 22rpx 16rpx;
  border: 2rpx dashed rgba(74, 52, 42, 0.4);
}
.rp-item-info {
  flex: 1 1 auto;
  min-width: 0;
}
.rp-item-name {
  font-size: 22rpx;
  font-weight: 800;
  color: #4A342A;
  line-height: 1.25;
}
.rp-item-cost {
  margin-top: 4rpx;
  font-size: 16rpx;
  font-weight: 800;
  color: #EF8F00;
  line-height: 1;
}

/* ============ 兑换按钮 ============ */
.rp-item-btn {
  margin-top: 12rpx;
  height: 62rpx;   /* v59: 56→62 与家长确认条等高, 卡片底线对齐 */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 8rpx;
  box-sizing: border-box;
}
.rp-item-btn.can {
  /* v63：叶绿木印兑换钮 */
  color: #FFFFFF;
  text-shadow: 0 2rpx 0 rgba(43, 74, 21, 0.4);
  background:
    repeating-linear-gradient(0deg,
      rgba(43, 74, 21, 0.10) 0 2rpx,
      rgba(255, 255, 255, 0.05) 2rpx 4rpx,
      rgba(43, 74, 21, 0) 4rpx 30rpx),
    linear-gradient(180deg, #8ED44E 0%, #6FBF2E 55%, #4E9321 100%);
  border: 2rpx solid #2E7D14;
  box-shadow: 0 5rpx 0 #2E7D14, 0 8rpx 14rpx rgba(85, 160, 47, 0.35);
}
.rp-item-btn.nope {
  color: #A9927D;
  background: #FFF9EA;            /* v63: 纸底 */
  border: 2rpx dashed rgba(74, 52, 42, 0.4);    /* v63: 虚线墨框 = 未开印记 */
  box-shadow: none;
}
.rp-btn-hover {
  transform: translateY(3rpx);
  box-shadow: 0 2rpx 0 #2E7D14, 0 4rpx 8rpx rgba(85, 160, 47, 0.28);
}

/* ============ 家长确认长按条 ============ */
.rp-confirm {
  margin-top: 12rpx;
}
.rp-confirm-tip {
  font-size: 15rpx;
  font-weight: 700;
  color: #8D6E63;
  text-align: center;
  margin-bottom: 8rpx;
}
/* v32.1 VLM 建议：按钮带微脉冲，提示这是需要长按的特殊交互 */
.rp-confirm-btn {
  position: relative;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx 18rpx 14rpx 20rpx / 16rpx 12rpx 20rpx 14rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #FFF8E1, #FFEFC5);   /* v59: 暖琥珀 */
  border: 2rpx solid #E0A82E;
  box-shadow: 0 3rpx 0 rgba(169, 106, 0, 0.55);
  animation: rpPulse 1.6s ease-in-out infinite;
}
@keyframes rpPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 179, 0, 0.0); }
  50%      { transform: scale(1.015); box-shadow: 0 0 0 6rpx rgba(255, 179, 0, 0.18); }
}
.rp-confirm-text {
  position: relative;
  z-index: 2;
  font-size: 20rpx;
  font-weight: 900;
  color: #A05E0B;   /* v59: 暗红褐→暖琥珀（去警示感, 呼应钱包金） */
  letter-spacing: 1rpx;
}
.rp-confirm-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 0;
  background: linear-gradient(90deg, #FFE082, #FFB300);
}
.rp-confirm-btn.run .rp-confirm-fill {
  width: 100%;
  transition: width 2s linear;
}

/* ============ 兑换记录 ============ */
.rp-history {
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  /* v63：账本纸（横格线 + 墨线框） */
  border-radius: 16rpx 22rpx 18rpx 24rpx / 20rpx 16rpx 24rpx 18rpx;
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.05) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 24rpx),
    linear-gradient(180deg, #FFFDF7 0%, #FFF6E0 100%);
  border: 2rpx solid rgba(74, 52, 42, 0.45);
  box-shadow: 2rpx 2rpx 0 rgba(74, 52, 42, 0.08);
}
.rp-history-head {
  font-size: 24rpx;
  font-weight: 900;
  color: #4A342A;
  letter-spacing: 1rpx;
}
.rp-history-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0 0;
}
.rp-history-emoji {
  font-size: 28rpx;
  line-height: 1;
}
.rp-history-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 19rpx;
  font-weight: 700;
  color: #6D5138;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rp-history-cost {
  flex-shrink: 0;
  font-size: 16rpx;
  font-weight: 800;
  color: #D84315;
}
.rp-history-time {
  flex-shrink: 0;
  font-size: 15rpx;
  font-weight: 600;
  color: #A9927D;
}

/* ============ 底部说明 ============ */
.rp-footer-tip {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  /* v63：牛皮纸提示条 */
  border-radius: 14rpx 20rpx 16rpx 22rpx / 18rpx 14rpx 22rpx 16rpx;
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.045) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 22rpx),
    linear-gradient(180deg, #FBF3E2 0%, #F3E5C8 100%);
  border: 2rpx dashed rgba(74, 52, 42, 0.4);
  font-size: 17rpx;
  font-weight: 600;
  color: #6D5138;
  line-height: 1.6;
  text-align: center;
}

/* 底部安全区占位（配合 inline style 高度） */
.rp-bottom-safe {
  flex-shrink: 0;
}
