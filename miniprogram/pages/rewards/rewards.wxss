/* pages/rewards/rewards.wxss - 亲子奖励中心样式 (v32)
 * v77「糖果果冻」统一重设计（与首页 v76 蛋仔风同源）：
 *   · 页底：糖果渐变（奶油黄→粉→淡蓝）+ 果冻气泡/星心花散布层
 *   · 钱包 = 草莓粉果冻袋（白描边 + 白色虚线糖霜内圈 + 白果冻内袋）
 *   · 档位卡 = 白果冻卡 + 三档彩色左缘糖条（薄荷/蜜橙/天蓝）
 *   · 奖励卡 = 白果冻小卡（白描边+淡彩挤出）；兑换按钮 = 薄荷果冻（与首页弹窗 CTA 同款）
 *   · 记录 = 白果冻账卡；布局度量与 v59/v63 保持一致（仅换肤不动结构）
 */

.reward-page {
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(90% 40% at 12% 4%, rgba(255, 214, 235, 0.45) 0%, rgba(255, 214, 235, 0) 58%),
    radial-gradient(84% 34% at 88% 20%, rgba(190, 226, 255, 0.4) 0%, rgba(190, 226, 255, 0) 60%),
    radial-gradient(90% 30% at 50% 104%, rgba(255, 178, 92, 0.3) 0%, rgba(255, 178, 92, 0) 62%),
    linear-gradient(180deg, #FFF2AE 0%, #FFE7BC 26%, #FFDFE4 52%, #EFE7F8 76%, #CFE6FA 100%);
  overflow: hidden;
  position: relative;
}

/* ---- v77 果冻气泡 + 星心花散布层（绝对定位不入流，低于内容层，同首页 page-candy 公式） ---- */
.rp-candy {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  pointer-events: none;
  z-index: 0;
}
.rp-bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 26%,
    rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.6) 24%,
    rgba(255, 178, 226, 0.48) 52%, rgba(132, 198, 250, 0.5) 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: inset -7rpx -10rpx 16rpx rgba(104, 158, 232, 0.42),
              inset 7rpx 8rpx 13rpx rgba(255, 255, 255, 0.85),
              0 9rpx 20rpx rgba(140, 110, 205, 0.28),
              0 0 18rpx rgba(255, 178, 226, 0.35);
  animation: rpFloat 4.2s ease-in-out infinite;
}
.rp-bubble::before {
  content: "";
  position: absolute;
  left: 14%; top: 9%;
  width: 44%; height: 32%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  transform: rotate(-22deg);
  filter: blur(1rpx);
}
.rp-bubble::after {
  content: "";
  position: absolute;
  right: 16%; bottom: 14%;
  width: 18%; height: 13%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  filter: blur(0.5rpx);
}
.rp-bubble--1 { left: 6rpx;   top: 320rpx; width: 54rpx; height: 54rpx; }
.rp-bubble--2 { right: 8rpx;  top: 760rpx; width: 42rpx; height: 42rpx; animation-delay: 0.7s; animation-duration: 3.6s; }
.rp-bubble--3 { left: 8rpx;   bottom: 180rpx; width: 46rpx; height: 46rpx; animation-delay: 1.4s; animation-duration: 3.2s; }
.rp-star {
  position: absolute;
  line-height: 1;
  color: #FFD34D;
  text-shadow:
    3rpx 0 0 #FFFFFF, -3rpx 0 0 #FFFFFF, 0 3rpx 0 #FFFFFF, 0 -3rpx 0 #FFFFFF,
    2.4rpx 2.4rpx 0 #FFFFFF, -2.4rpx -2.4rpx 0 #FFFFFF, 2.4rpx -2.4rpx 0 #FFFFFF, -2.4rpx 2.4rpx 0 #FFFFFF,
    0 6rpx 0 rgba(245, 179, 1, 0.5),
    0 0 16rpx rgba(255, 211, 77, 0.55);
  animation: rpFloat 3.8s ease-in-out infinite;
}
.rp-star--1 { right: 10rpx; top: 300rpx; font-size: 48rpx; }                     /* 右上黄星 */
.rp-star--2 { left: 6rpx;   top: 130rpx; font-size: 42rpx; color: #7CC8FA;       /* 左上蓝星 */
  text-shadow:
    3rpx 0 0 #FFFFFF, -3rpx 0 0 #FFFFFF, 0 3rpx 0 #FFFFFF, 0 -3rpx 0 #FFFFFF,
    2.4rpx 2.4rpx 0 #FFFFFF, -2.4rpx -2.4rpx 0 #FFFFFF, 2.4rpx -2.4rpx 0 #FFFFFF, -2.4rpx 2.4rpx 0 #FFFFFF,
    0 6rpx 0 rgba(72, 168, 238, 0.5),
    0 0 16rpx rgba(124, 200, 250, 0.5);
  animation-delay: 0.9s; }
.rp-star--3 { right: 12rpx; bottom: 320rpx; font-size: 40rpx; color: #FF7BA9;    /* 右下粉爱心 */
  text-shadow:
    3rpx 0 0 #FFFFFF, -3rpx 0 0 #FFFFFF, 0 3rpx 0 #FFFFFF, 0 -3rpx 0 #FFFFFF,
    2.4rpx 2.4rpx 0 #FFFFFF, -2.4rpx -2.4rpx 0 #FFFFFF, 2.4rpx -2.4rpx 0 #FFFFFF, -2.4rpx 2.4rpx 0 #FFFFFF,
    0 6rpx 0 rgba(216, 79, 134, 0.5),
    0 0 16rpx rgba(255, 123, 169, 0.45);
  animation-delay: 1.6s; animation-duration: 3.3s; }
.rp-star--4 { left: 10rpx;  bottom: 90rpx; font-size: 38rpx; color: #FFFFFF;     /* 左下白花 */
  text-shadow:
    3rpx 0 0 rgba(255, 190, 220, 0.95), -3rpx 0 0 rgba(255, 190, 220, 0.95),
    0 3rpx 0 rgba(255, 190, 220, 0.95), 0 -3rpx 0 rgba(255, 190, 220, 0.95),
    2.4rpx 2.4rpx 0 rgba(255, 190, 220, 0.95), -2.4rpx -2.4rpx 0 rgba(255, 190, 220, 0.95),
    2.4rpx -2.4rpx 0 rgba(255, 190, 220, 0.95), -2.4rpx 2.4rpx 0 rgba(255, 190, 220, 0.95),
    0 6rpx 0 rgba(216, 79, 134, 0.35),
    0 0 16rpx rgba(255, 190, 220, 0.5);
  animation-delay: 0.4s; }
@keyframes rpFloat {
  0%, 100% { transform: translateY(0) rotate(-8deg); }
  50%      { transform: translateY(-10rpx) rotate(8deg); }
}

.rp-scroll {
  flex: 1 1 auto;
  min-height: 0;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* ============ 积分钱包卡 ============ */
/* v77：草莓粉果冻零钱袋（白描边 + 白色虚线糖霜内圈，与首页牌匾同源） */
.rp-wallet {
  padding: 26rpx 30rpx 20rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #FFB1CB 0%, #FF8FB5 55%, #F76E9C 100%);
  border: 4rpx solid #FFFFFF;
  box-shadow:
    0 8rpx 0 rgba(216, 79, 134, 0.45),
    0 16rpx 32rpx rgba(216, 79, 134, 0.3),
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.85),
    inset 0 -6rpx 12rpx rgba(199, 54, 110, 0.2);
  color: #FFFFFF;
  position: relative;
}
/* 内圈白色糖霜虚线（果冻袋手缝感） */
.rp-wallet::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.5);
  border-radius: 26rpx;
  pointer-events: none;
}
.rp-wallet-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.rp-wallet-icon {
  font-size: 64rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(199, 54, 110, 0.3));
  animation: walletBob 2.8s ease-in-out infinite;
}
@keyframes walletBob {
  0%, 100% { transform: translateY(0) rotate(-4deg); }
  50%      { transform: translateY(-8rpx) rotate(4deg); }
}
.rp-wallet-main {
  flex: 1 1 auto;
  min-width: 0;
}
.rp-wallet-points {
  font-size: 60rpx;   /* v59: 64→60 与三列小数据拉开层级又保冲击力 */
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 3rpx 0 rgba(199, 54, 110, 0.45);
}
.rp-wallet-label {
  margin-top: 6rpx;   /* v59: 主数字-副标题呼吸感 */
  font-size: 20rpx;
  font-weight: 700;
  opacity: 0.96;
  letter-spacing: 1rpx;
}
.rp-wallet-meta {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  /* v77：白果冻内袋（白半透明内凹） */
  background: rgba(255, 255, 255, 0.24);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: inset 0 2rpx 6rpx rgba(199, 54, 110, 0.2);
}
.rp-meta {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.rp-meta-num {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 1rpx 0 rgba(199, 54, 110, 0.35);
}
.rp-meta-label {
  font-size: 15rpx;
  font-weight: 600;
  opacity: 0.96;
}
.rp-meta-divider {
  flex: 0 0 auto;
  width: 2rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 1rpx;
}

/* ============ 月度进度条 ============ */
.rp-month-progress {
  margin: 16rpx 6rpx 4rpx;
  position: relative;   /* v59: 终点旗标定位锚 */
}
/* v59: 终点 🏁 旗标 — 600 分长线目标具象化, 强化「快到了」的渴望感 */
.rp-month-progress::after {
  content: '🏁';
  position: absolute;
  right: -4rpx;
  top: -14rpx;
  font-size: 24rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 2rpx rgba(232, 168, 0, 0.3));
}
.rp-month-bar {
  height: 16rpx;   /* v59: 12→16 能量槽感（儿童游戏化进度） */
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid #FFFFFF;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(120, 84, 160, 0.15);
}
.rp-month-fill {
  height: 100%;
  min-width: 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFD34D, #FFA53D);   /* v77: 糖果柠黄→蜜橙 */
  box-shadow: 0 0 6rpx rgba(255, 165, 61, 0.55);
  transition: width 0.6s cubic-bezier(.2,.9,.2,1);
}
.rp-month-text {
  margin-top: 6rpx;
  font-size: 16rpx;
  font-weight: 700;
  color: #8A5A28;
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ============ 三档奖励区 ============ */
.rp-tier {
  margin-top: 28rpx;   /* v59: 模块间距呼吸感 */
  padding: 20rpx 20rpx 16rpx;
  box-sizing: border-box;
  /* v77：白果冻档位卡（白描边 + 内发光 + 淡紫柔影） */
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF6E9 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 6rpx 0 rgba(150, 110, 60, 0.14),
              0 14rpx 26rpx rgba(120, 84, 160, 0.16),
              inset 0 4rpx 10rpx rgba(255, 255, 255, 0.9);
  animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both;   /* v63 错峰入场 */
}
/* v63: 三档错峰延迟（用档位类而非 nth-of-type，wx:if 场景下定位更稳） */
.tier-instant { animation-delay: 0.02s; }
.tier-weekend { animation-delay: 0.10s; }
.tier-grand   { animation-delay: 0.18s; }
/* 各档主题色（左缘糖条 + 标题色，v77 糖果化：薄荷/蜜橙/天蓝） */
.tier-instant { border-left: 10rpx solid #7ED13E; }
.tier-weekend { border-left: 10rpx solid #FFB020; }
.tier-grand   { border-left: 10rpx solid #48A8EE; }

.rp-tier-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rp-tier-icon {
  font-size: 22rpx;
  line-height: 1;
}
.rp-tier-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  color: #7A4E22;
  letter-spacing: 1rpx;
}
.tier-instant .rp-tier-name { color: #1E9E71; }
.tier-weekend .rp-tier-name { color: #C77500; }
.tier-grand   .rp-tier-name { color: #2F7FC2; }

.rp-tier-chip {
  flex-shrink: 0;
  max-width: 46%;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* v77：已解锁 = 三色果冻糖豆（薄荷/蜜橙/天蓝，白描边+挤出） */
.rp-tier-chip.on {
  color: #FFFFFF;
  text-shadow: 0 1rpx 0 rgba(30, 120, 90, 0.4);
  background: linear-gradient(180deg, #7EE0A8, #3EC98C);
  border: 2rpx solid #FFFFFF;
  box-shadow: 0 3rpx 0 rgba(43, 164, 126, 0.5), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
}
.rp-tier-chip.off {
  color: #A9885E;
  background: rgba(255, 255, 255, 0.85);               /* v77: 白果冻底 */
  border: 2rpx dashed rgba(216, 79, 134, 0.45);        /* v77: 虚线糖霜框 = 待解锁印记 */
  box-shadow: none;
}
.tier-weekend .rp-tier-chip.on {
  background: linear-gradient(180deg, #FFD95E, #FFB020);
  text-shadow: 0 1rpx 0 rgba(200, 110, 10, 0.45);
  box-shadow: 0 3rpx 0 rgba(232, 137, 27, 0.5), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
}
.tier-grand   .rp-tier-chip.on {
  background: linear-gradient(180deg, #9ED8FF, #48A8EE);
  text-shadow: 0 1rpx 0 rgba(30, 110, 170, 0.45);
  box-shadow: 0 3rpx 0 rgba(47, 143, 212, 0.5), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
}

.rp-tier-sub {
  margin-top: 6rpx;
  font-size: 16rpx;
  font-weight: 600;
  color: #A9885E;
  letter-spacing: 0.4rpx;
}

/* ============ 奖励卡网格 ============ */
.rp-grid {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.rp-item {
  width: calc((100% - 12rpx) / 2);
  box-sizing: border-box;
  padding: 14rpx 14rpx 12rpx;
  /* v77：白果冻奖励小卡（白描边 + 淡彩挤出） */
  border-radius: 20rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF7EA 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 0 rgba(150, 110, 60, 0.14),
              0 8rpx 16rpx rgba(120, 84, 160, 0.1),
              inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92);
  transition: transform 150ms ease;
}
.rp-item.locked {
  opacity: 0.72;
}
.rp-item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rp-item-emoji {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  /* v77：白果冻糖珠底座 */
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF3E0 100%);
  border-radius: 18rpx;
  border: 2.5rpx solid #FFFFFF;
  box-shadow: 0 3rpx 0 rgba(232, 168, 0, 0.25), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
}
.rp-item-info {
  flex: 1 1 auto;
  min-width: 0;
}
.rp-item-name {
  font-size: 22rpx;
  font-weight: 800;
  color: #7A4E22;
  line-height: 1.25;
}
.rp-item-cost {
  margin-top: 4rpx;
  font-size: 16rpx;
  font-weight: 800;
  color: #EF8F00;
  line-height: 1;
}

/* ============ 兑换按钮 ============ */
.rp-item-btn {
  margin-top: 12rpx;
  height: 62rpx;   /* v59: 56→62 与家长确认条等高, 卡片底线对齐 */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 8rpx;
  box-sizing: border-box;
}
.rp-item-btn.can {
  /* v77：薄荷果冻兑换钮（与首页弹窗 CTA 同款） */
  color: #FFFFFF;
  text-shadow: 0 2rpx 0 rgba(30, 120, 90, 0.45);
  background: linear-gradient(180deg, #7EE0A8 0%, #3EC98C 62%, #2FB98C 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 5rpx 0 rgba(43, 164, 126, 0.8), 0 10rpx 16rpx rgba(43, 164, 126, 0.28),
              inset 0 3rpx 8rpx rgba(255, 255, 255, 0.55);
}
.rp-item-btn.nope {
  color: #C58FA6;
  background: rgba(255, 255, 255, 0.85);            /* v77: 白果冻底 */
  border: 2.5rpx dashed rgba(216, 79, 134, 0.4);    /* v77: 虚线糖霜框 = 未开印记 */
  box-shadow: none;
}
.rp-btn-hover {
  transform: translateY(3rpx);
  box-shadow: 0 2rpx 0 rgba(43, 164, 126, 0.8), 0 4rpx 8rpx rgba(43, 164, 126, 0.22),
              inset 0 3rpx 6rpx rgba(255, 255, 255, 0.5);
}

/* ============ 家长确认长按条 ============ */
.rp-confirm {
  margin-top: 12rpx;
}
.rp-confirm-tip {
  font-size: 15rpx;
  font-weight: 700;
  color: #A9885E;
  text-align: center;
  margin-bottom: 8rpx;
}
/* v32.1 VLM 建议：按钮带微脉冲，提示这是需要长按的特殊交互 */
.rp-confirm-btn {
  position: relative;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  overflow: hidden;
  /* v77：蜂蜜果冻长按条（白描边+挤出） */
  background: linear-gradient(180deg, #FFE9A8 0%, #FFCF5E 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 0 rgba(232, 137, 27, 0.55), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.8);
  animation: rpPulse 1.6s ease-in-out infinite;
}
@keyframes rpPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 4rpx 0 rgba(232, 137, 27, 0.55), 0 0 0 0 rgba(255, 179, 0, 0.0); }
  50%      { transform: scale(1.015); box-shadow: 0 4rpx 0 rgba(232, 137, 27, 0.55), 0 0 0 6rpx rgba(255, 179, 0, 0.18); }
}
.rp-confirm-text {
  position: relative;
  z-index: 2;
  font-size: 20rpx;
  font-weight: 900;
  color: #C77500;   /* v77: 蜜橙暖棕（呼应蜂蜜果冻） */
  letter-spacing: 1rpx;
}
.rp-confirm-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  width: 0;
  background: linear-gradient(90deg, #FFD34D, #FFA53D);
}
.rp-confirm-btn.run .rp-confirm-fill {
  width: 100%;
  transition: width 2s linear;
}

/* ============ 兑换记录 ============ */
.rp-history {
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  /* v77：白果冻账卡 */
  border-radius: 20rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF6E9 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 4rpx 0 rgba(150, 110, 60, 0.12),
              0 10rpx 20rpx rgba(120, 84, 160, 0.1),
              inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92);
}
.rp-history-head {
  font-size: 24rpx;
  font-weight: 900;
  color: #7A4E22;
  letter-spacing: 1rpx;
}
.rp-history-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0 0;
}
.rp-history-emoji {
  font-size: 28rpx;
  line-height: 1;
}
.rp-history-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 19rpx;
  font-weight: 700;
  color: #8A5A28;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rp-history-cost {
  flex-shrink: 0;
  font-size: 16rpx;
  font-weight: 800;
  color: #E8548C;
}
.rp-history-time {
  flex-shrink: 0;
  font-size: 15rpx;
  font-weight: 600;
  color: #BFA38C;
}

/* ============ 底部说明 ============ */
.rp-footer-tip {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  /* v77：白果冻提示条 + 粉色虚线糖霜框 */
  border-radius: 20rpx;
