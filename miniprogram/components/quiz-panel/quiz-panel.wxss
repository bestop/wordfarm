/* components/quiz-panel/quiz-panel.wxss - 答题面板样式
 * v77 糖果果冻重设计（与首页 v76 蛋仔风同源）：
 *   · 面板 = 白果冻纸身（白→奶油渐变 + 顶部内发光 + 紫葡萄柔影）
 *   · 顶条 = 粉糖果压条 + 双黄糖珠（替换木压条+铆钉）
 *   · 选项 = 四色白果冻卡（绿/黄/蓝/粉淡彩描边 + 本命色挤出投影，A/B/C/D 徽章 = 果冻糖珠）
 *   · 选中/揭示 = 薄荷果冻；答错抖动（本地 keyframes，组件样式隔离仍生效）
 *   · 布局度量与 v42/v59/v63 版本保持一致（仅换肤，不动结构）
 */

/* v12 关键修复：自定义组件宿主节点默认 inline，部分机型高度计算异常
   导致面板内容（尤其底部选项）被裁切。显式声明 block 保证布局稳定。 */
/* v16 修复（Task 15）：紧凑化 option 与 options-area，释放 ~47rpx 垂直空间
   目标：答题区 4 个选项在所有机型完整显示，不被 .game-page overflow:hidden 裁切 */
:host {
  display: block;
  width: 100%;
}

.quiz-panel {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;          /* v15: 文档流末端不被父级 flex 压缩，永远完整显示 */
  /* v77：白果冻面板身（白→奶油渐变，紫葡萄柔影托底） */
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8EC 60%, #FFF3DC 100%);
  border-radius: 38rpx 38rpx 0 0;
  box-shadow: 0 -10rpx 28rpx rgba(120, 84, 160, 0.22);
  overflow: visible;
}
/* v77：顶部糖果压条（粉白渐变 + 双黄糖珠），替换 v63 木压条 */
.quiz-panel::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 16rpx;
  border-radius: 38rpx 38rpx 0 0;
  background-image:
    radial-gradient(circle at 36rpx 8rpx, #FFF3B0 0 4rpx, rgba(216, 79, 134, 0.5) 4rpx 6rpx, rgba(216, 79, 134, 0) 7rpx),
    radial-gradient(circle at calc(100% - 36rpx) 8rpx, #FFF3B0 0 4rpx, rgba(216, 79, 134, 0.5) 4rpx 6rpx, rgba(216, 79, 134, 0) 7rpx),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 233, 242, 0.95) 100%);
  border-bottom: 3rpx solid rgba(232, 93, 138, 0.32);
  pointer-events: none;
  z-index: 1;
}

/* ============ 题目区（v9 按内容收缩，弹性让位给选项区） ============ */
.question-area {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 18rpx 0;          /* v63: 顶部让出压条高度 */
  position: relative;
  transition: background 0.2s ease;
}
.question-area.fb-correct { background: rgba(126, 224, 168, 0.2); }
.question-area.fb-wrong { background: rgba(255, 123, 169, 0.16); }
.question-area.fb-timeout { background: rgba(255, 165, 61, 0.16); }   /* v39: 超时琥珀色 */

.question-label {
  font-size: 16rpx;
  color: #A9885E;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 2rpx;
}
.question-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.word {
  font-size: 32rpx;
  font-weight: 900;
  color: #7A4E22;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.85);
  line-height: 1.15;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.phonetic {
  font-size: 17rpx;               /* v59: 16→17 辅学信息儿童可读 */
  color: #E8548C;                 /* v77: 莓粉果冻 IPA（替换印章朱砂红） */
  font-weight: 700;
  font-family: "PingFang SC", "Helvetica Neue", "Segoe UI", sans-serif;
  line-height: 1.15;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.question-empty {
  font-size: 20rpx;
  color: #A9885E;
}

/* ============ v39: 题目限时倒计时 ============ */
.q-timer {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  margin: 2rpx 0 4rpx;
}
.q-timer-track {
  flex: 1;
  height: 10rpx;
  /* v77：白果冻凹槽（柔和内影） */
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: inset 0 1rpx 3rpx rgba(120, 84, 160, 0.16);
}
.q-timer-fill {
  height: 100%;
  width: 100%;
  background: linear-gradient(90deg, #FFD34D, #FFA53D);   /* v77: 柠黄→蜜橙糖果条 */
  border-radius: 999rpx;
  /* 心跳 500ms 一跳，transition 抹平步进 → 视觉连续 */
  transition: width 0.5s linear;
}
.q-timer-sec {
  flex-shrink: 0;
  min-width: 64rpx;
  text-align: right;
  font-size: 18rpx;
  font-weight: 900;
  color: #A9885E;
  line-height: 1;
}
/* 紧急态：莓粉红条 + 秒数脉冲提醒 */
.q-timer-danger .q-timer-fill {
  background: linear-gradient(90deg, #FF7BA9, #E23A5F);
}
.q-timer-danger .q-timer-sec {
  color: #E23A5F;
  animation: q-timer-pulse 0.6s ease-in-out infinite;
}
@keyframes q-timer-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.18); }
}

/* ============ 选项区（v42 2×2 网格：两行两列, 古典写法真机必换行） ============ */
.options-area {
  flex: 0 0 auto;
  display: flex;
  flex-wrap: wrap;              /* v42: width<50% 两列必换行成 2×2 */
  justify-content: space-between; /* v42: 列距自动分配 — 弃 gap(iOS<14.1 不支持) */
  padding: 8rpx 14rpx 16rpx;   /* v42: 底 12→16 吃末行 margin, 顶部呼吸感不变 */
  box-sizing: border-box;
}
.option {
  width: 48.8%;                /* v42: 百分数直写 — flex 简写嵌 calc 真机解析不可靠 */
  margin-bottom: 10rpx;        /* v42: 行间距, margin 所有引擎恒生效 */
  min-width: 0;
  min-height: 72rpx;            /* v40: 60→72 点击目标 +20%，孩子手指好点 */
  /* v77：白果冻选项卡（白描边 + 内发光 + 淡紫柔影） */
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF7EA 100%);
  border: 3rpx solid #FFFFFF;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 10rpx;          /* v40: 5/8→8/10 内容舒展 */
  box-sizing: border-box;
  transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.15s ease, border-color 0.15s ease;
  box-shadow: 0 4rpx 0 rgba(150, 110, 60, 0.16),
              0 8rpx 14rpx rgba(120, 84, 160, 0.12),
              inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92);
  overflow: hidden;
}
/* ===== v77：四选项各配白果冻纸色 + 本命色挤出投影（A 叶绿 / B 蜜橙 / C 天蓝 / D 莓粉） ===== */
.option-0 { background: linear-gradient(180deg, #FFFFFF 0%, #EAF7DC 100%); box-shadow: 0 4rpx 0 rgba(126, 209, 62, 0.4), 0 8rpx 14rpx rgba(110, 150, 50, 0.14), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92); }
.option-1 { background: linear-gradient(180deg, #FFFFFF 0%, #FFF3D0 100%); box-shadow: 0 4rpx 0 rgba(245, 179, 1, 0.35), 0 8rpx 14rpx rgba(200, 150, 20, 0.14), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92); }
.option-2 { background: linear-gradient(180deg, #FFFFFF 0%, #E1F3FF 100%); box-shadow: 0 4rpx 0 rgba(72, 168, 238, 0.4), 0 8rpx 14rpx rgba(50, 130, 200, 0.14), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92); }
.option-3 { background: linear-gradient(180deg, #FFFFFF 0%, #FFEDF5 100%); box-shadow: 0 4rpx 0 rgba(232, 84, 140, 0.4), 0 8rpx 14rpx rgba(166, 26, 105, 0.12), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.92); }
/* v77: A/C/D 徽章 = 本命色果冻糖珠（B 蜜橙为默认） */
.option-0 .option-badge { background: radial-gradient(circle at 34% 28%, rgba(255,255,255,0.85) 0 6rpx, rgba(255,255,255,0) 9rpx), linear-gradient(180deg, #A8E86A 0%, #7ED13E 100%); color: #FFFFFF; border-color: #FFFFFF; text-shadow: 0 1rpx 0 rgba(95, 176, 42, 0.6); box-shadow: 0 2rpx 0 rgba(95, 176, 42, 0.5), inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7); }
.option-2 .option-badge { background: radial-gradient(circle at 34% 28%, rgba(255,255,255,0.85) 0 6rpx, rgba(255,255,255,0) 9rpx), linear-gradient(180deg, #9ED8FF 0%, #48A8EE 100%); color: #FFFFFF; border-color: #FFFFFF; text-shadow: 0 1rpx 0 rgba(30, 110, 170, 0.55); box-shadow: 0 2rpx 0 rgba(47, 143, 212, 0.5), inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7); }
.option-3 .option-badge { background: radial-gradient(circle at 34% 28%, rgba(255,255,255,0.85) 0 6rpx, rgba(255,255,255,0) 9rpx), linear-gradient(180deg, #FFB1CB 0%, #F76FA0 100%); color: #FFFFFF; border-color: #FFFFFF; text-shadow: 0 1rpx 0 rgba(199, 54, 110, 0.55); box-shadow: 0 2rpx 0 rgba(216, 79, 134, 0.5), inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7); }
/* v40: A/B/C/D 字母徽章 → v77 果冻糖珠（蜜橙蜡 + 白描边 + 顶光） */
.option-badge {
  flex-shrink: 0;
  margin-right: 8rpx;        /* v42b: 徽章-文本间距, 替代 .option gap(老 iOS 不支持) */
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 28%, rgba(255,255,255,0.85) 0 6rpx, rgba(255,255,255,0) 9rpx),
    linear-gradient(180deg, #FFD95E 0%, #FFB020 100%);
  color: #FFFFFF;
  border: 2rpx solid #FFFFFF;
  font-size: 20rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  text-shadow: 0 1rpx 0 rgba(200, 110, 10, 0.55);
  box-shadow: 0 2rpx 0 rgba(232, 137, 27, 0.5), inset 0 1rpx 3rpx rgba(255, 255, 255, 0.7);
}
.option-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
  word-wrap: break-word;
  white-space: normal;
  text-align: center;
  line-height: 1.35;
  font-size: 24rpx;          /* v40: 22→24 恢复易读字号（增高由 canvas flex 吸收） */
  font-weight: 800;
  color: #7A4E22;
  letter-spacing: 0.3rpx;
  flex: 1;                   /* v40: width:100%→flex 自适应（给徽章让位） */
  min-width: 0;
}
.option:active {
  transform: translateY(3rpx);   /* v40: 按下位移 — 果冻按压下沉（替代缩放） */
  box-shadow: 0 1rpx 0 rgba(150, 110, 60, 0.2),
              inset 0 3rpx 6rpx rgba(255, 255, 255, 0.85);
  background: #FFF6E3;
}
.option.selected {
  /* v77：选中 = 薄荷果冻卡（白描边 + 薄荷挤出） */
  background: linear-gradient(180deg, #7EE0A8 0%, #3EC98C 100%);
  border-color: #FFFFFF;
  color: #FFFFFF;
  box-shadow: 0 4rpx 0 rgba(43, 164, 126, 0.55), 0 8rpx 14rpx rgba(43, 164, 126, 0.25), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.5);
  transform: scale(0.97);
}
.option.selected .option-badge {
  background: rgba(255, 253, 245, 0.35);   /* 白色半透明徽章浮于薄荷冻 */
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, 0.7);
  box-shadow: none;
}
/* v59: 选中/揭示态白字真正生效 — .option-text 自带 color 覆盖了父级 color,
   v40 起白字从未生效（深底深字，儿童可读性 P0） */
.option.selected .option-text { color: #FFFFFF; text-shadow: 0 1rpx 0 rgba(30, 120, 90, 0.5); }
.option.reveal .option-text { color: #FFFFFF; text-shadow: 0 1rpx 0 rgba(30, 120, 90, 0.5); }
.option.reveal {
  background: linear-gradient(180deg, #7EE0A8 0%, #3EC98C 100%);
  border-color: #FFFFFF;
  color: #FFFFFF;
  box-shadow: 0 4rpx 0 rgba(43, 164, 126, 0.55), 0 8rpx 14rpx rgba(43, 164, 126, 0.25), inset 0 3rpx 6rpx rgba(255, 255, 255, 0.5);
}
.option.reveal .option-badge {
  background: rgba(255, 253, 245, 0.35);
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, 0.7);
  box-shadow: none;
}

/* ============ 反馈浮层（v77：果冻印章反馈） ============ */
.feedback {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  border: 3rpx solid #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  color: #FFFFFF;
  text-shadow: 0 2rpx 0 rgba(42, 24, 12, 0.28);
  pointer-events: none;
  animation: pop-in-centered 0.4s ease-out;
  z-index: 10;
}
.feedback.correct {
  /* v77：薄荷果冻章 */
  background: linear-gradient(180deg, #7EE0A8, #3EC98C);
  box-shadow: 0 6rpx 0 rgba(43, 164, 126, 0.6), 0 12rpx 24rpx rgba(43, 164, 126, 0.4), inset 0 3rpx 8rpx rgba(255,255,255,0.5);
}
.feedback.wrong {
  /* v77：莓粉果冻章 */
  background: linear-gradient(180deg, #FF7BA9, #E23A5F);
  box-shadow: 0 6rpx 0 rgba(198, 40, 70, 0.55), 0 12rpx 24rpx rgba(198, 40, 70, 0.38), inset 0 3rpx 8rpx rgba(255,255,255,0.4);
}
/* v39: 超时反馈（蜜橙暖色 — 温和提示，区别于答错惩罚粉红） */
.feedback.timeout {
  background: linear-gradient(180deg, #FFD95E, #FFA53D);
  box-shadow: 0 6rpx 0 rgba(232, 137, 27, 0.55), 0 12rpx 24rpx rgba(232, 137, 27, 0.4), inset 0 3rpx 8rpx rgba(255,255,255,0.5);
}

/* v6 修复 (Task 11 F20): 改名为 pop-in-centered，避免与 app.wxss 全局 pop-in 同名冲突 */
@keyframes pop-in-centered {
  0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
  60% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1); }
}

/* ============ v63 修复：答错抖动本地化 ============
 * 组件默认样式隔离，wxml 中的 anim-shake 不会命中 app.wxss 全局定义；
 * 此前答错抖动实际从未生效 —— 本地补齐 keyframes + 类，隔离环境下照样摇摆。 */
.anim-shake { animation: shake-local 0.5s ease; }
@keyframes shake-local {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}
