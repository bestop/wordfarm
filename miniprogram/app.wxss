/* app.wxss - 全局样式：糖果果冻主题 (v77 与首页 v73-v76 蛋仔风统一)
 *
 * 设计语言（对齐 pages/index v76 果冻公式）：
 *   · 果冻公式 —— 大圆角 + 白描边 3-4rpx + 浅顶深底渐变 + 底部挤出深色投影 + 顶部内发光
 *   · 色板 —— 草莓粉 FF8FB5/柠黄 FFD34D/蜜橙 FFA53D/薄荷 7EE0A8/苹果绿 A8E86A/天蓝 7CC8FA/葡萄紫 C79BF2
 *   · 按钮家族 —— 橙黄果冻(默认)/草莓粉(primary)/薄荷(mint)/天蓝(sky)/白果冻(ghost)
 *   · 卡片 —— 白果冻卡 + 粉白双层描边（与首页弹窗同款）
 *   · 微动效保留 —— 入场错峰浮现 / 呼吸浮动 / 按压下沉
 *
 * 兼容性策略：--farm-* 变量名保留（旧页面回退安全），纹理类 wood/paper-surface 不再被页面引用
 */

/* ============ 颜色变量（糖果果冻色系 v77，变量名保留兼容旧引用） ============ */
page {
  /* 纸张（v77 糖果奶油底） */
  --farm-paper: #FFF6E3;
  --farm-paper-light: #FFFDF7;
  --farm-kraft: #FFF3DC;
  /* 木材变量退役保留（旧引用回退值，不再被页面使用） */
  --wood-light: #D8AC74;
  --wood-mid: #BC8048;
  --wood-deep: #9A6238;
  --wood-edge: #6B4224;
  /* 墨色（v77 糖果暖棕） */
  --farm-ink: #7A4E22;
  --farm-ink-soft: #8A5A28;
  --farm-ink-faint: #A9885E;
  /* 点缀（糖果六色主色） */
  --farm-leaf: #7ED13E;
  --farm-leaf-deep: #5FBF2E;
  --farm-sun: #FFD34D;
  --farm-sky: #7CC8FA;
  --farm-rust: #FF6E8C;
  /* 糖果点缀色 */
  --farm-berry: #FF6E9C;
  --farm-grape: #C79BF2;
  --farm-mint: #3EC98C;
  --farm-coral: #FFA53D;

  /* 兼容旧变量名（部分页面 wxss 仍引用） */
  --color-bg: #FFF6E3;
  --color-card: #FFFDF7;
  --color-text: var(--farm-ink);
  --color-text-muted: var(--farm-ink-soft);
  --color-text-light: var(--farm-ink-faint);
  --color-danger: var(--farm-rust);
  --color-success: var(--farm-leaf);
  --shadow-card: 0 12rpx 28rpx rgba(120, 84, 160, 0.16);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;

  background: var(--farm-paper);
  color: var(--farm-ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ============ 通用类 ============ */
view, text { box-sizing: border-box; }

/* ============ 木质纹理面板（板条拼缝 + 顺纹 + 顶光） ============ */
.wood-surface {
  background-image:
    repeating-linear-gradient(90deg,
      rgba(63, 38, 20, 0.14) 0 3rpx,
      rgba(255, 255, 255, 0.06) 3rpx 6rpx,
      rgba(63, 38, 20, 0) 6rpx 86rpx),
    repeating-linear-gradient(178deg,
      rgba(63, 38, 20, 0.05) 0 2rpx,
      rgba(63, 38, 20, 0) 2rpx 30rpx),
    linear-gradient(180deg,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0) 34%,
      rgba(63, 38, 20, 0.10) 100%),
    linear-gradient(180deg, var(--wood-light) 0%, var(--wood-mid) 52%, var(--wood-deep) 100%);
}
/* 横向板条（用于横梁 / 木架：板缝水平分布） */
.wood-surface-h {
  background-image:
    repeating-linear-gradient(0deg,
      rgba(63, 38, 20, 0.13) 0 3rpx,
      rgba(255, 255, 255, 0.05) 3rpx 5rpx,
      rgba(63, 38, 20, 0) 5rpx 44rpx),
    linear-gradient(180deg,
      rgba(255, 255, 255, 0.20) 0%,
      rgba(255, 255, 255, 0) 40%,
      rgba(63, 38, 20, 0.12) 100%),
    linear-gradient(180deg, var(--wood-light) 0%, var(--wood-mid) 55%, var(--wood-deep) 100%);
}

/* ============ 手绘纸张面板（米黄纸 + 细横纹 + 墨线描边） ============ */
.paper-surface {
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.045) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 26rpx),
    linear-gradient(180deg, var(--farm-paper-light) 0%, var(--farm-paper) 100%);
  border: 3rpx solid rgba(74, 52, 42, 0.55);
  box-shadow:
    2rpx 4rpx 0 rgba(74, 52, 42, 0.10),
    0 10rpx 24rpx rgba(74, 52, 42, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.85);
}

/* ============ 果冻按钮家族（沿用 kawaii-btn 类名，v77 全面换装糖果果冻） ============ */
.kawaii-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 56rpx;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #FFFFFF;
  text-shadow: 0 2rpx 0 rgba(200, 110, 10, 0.4);
  /* 默认：蜜橙果冻（与首页开始冒险按钮同款） */
  background-image: linear-gradient(180deg, #FFD95E 0%, #FFB020 62%, #FF9C1B 100%);
  border: 4rpx solid #FFFFFF;
  box-shadow:
    0 8rpx 0 rgba(232, 137, 27, 0.85),
    0 14rpx 26rpx rgba(232, 137, 27, 0.32),
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.75),
    inset 0 -6rpx 12rpx rgba(216, 110, 20, 0.22);
  transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.12s ease;
  line-height: 1.2;
}
.kawaii-btn:active {
  transform: translateY(5rpx) scale(0.98);
  filter: brightness(0.97);
  box-shadow:
    0 3rpx 0 rgba(232, 137, 27, 0.85),
    0 8rpx 16rpx rgba(232, 137, 27, 0.26),
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.7);
}
/* 主按钮：草莓粉果冻（与首页牌匾同源） */
.kawaii-btn-primary {
  text-shadow: 0 2rpx 0 rgba(199, 54, 110, 0.45);
  background-image: linear-gradient(180deg, #FFB1CB 0%, #FF8FB5 55%, #F76E9C 100%);
  border-color: #FFFFFF;
  box-shadow:
    0 8rpx 0 rgba(216, 79, 134, 0.5),
    0 14rpx 26rpx rgba(216, 79, 134, 0.32),
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.85),
    inset 0 -6rpx 12rpx rgba(199, 54, 110, 0.2);
}
.kawaii-btn-primary:active { box-shadow: 0 3rpx 0 rgba(216, 79, 134, 0.5), 0 8rpx 16rpx rgba(216,79,134,0.26), inset 0 5rpx 10rpx rgba(255,255,255,0.8); }
/* 薄荷果冻（继续/再来一局；与首页弹窗 CTA 同款） */
.kawaii-btn-mint {
  color: #FFFFFF;
  text-shadow: 0 2rpx 0 rgba(30, 120, 90, 0.45);
  background-image: linear-gradient(180deg, #7EE0A8 0%, #3EC98C 62%, #2FB98C 100%);
  border-color: #FFFFFF;
  box-shadow:
    0 8rpx 0 rgba(43, 164, 126, 0.8),
    0 14rpx 26rpx rgba(43, 164, 126, 0.28),
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.55),
    inset 0 -6rpx 12rpx rgba(30, 140, 100, 0.22);
}
.kawaii-btn-mint:active { box-shadow: 0 3rpx 0 rgba(43, 164, 126, 0.8), 0 8rpx 16rpx rgba(43,164,126,0.22), inset 0 5rpx 10rpx rgba(255,255,255,0.5); }
/* 天蓝果冻（次要强调） */
.kawaii-btn-sky {
  text-shadow: 0 2rpx 0 rgba(30, 110, 170, 0.45);
  background-image: linear-gradient(180deg, #9ED8FF 0%, #7CC8FA 55%, #48A8EE 100%);
  border-color: #FFFFFF;
  box-shadow:
    0 8rpx 0 rgba(47, 143, 212, 0.75),
    0 14rpx 26rpx rgba(47, 143, 212, 0.28),
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.7),
    inset 0 -6rpx 12rpx rgba(30, 110, 170, 0.2);
}
.kawaii-btn-sky:active { box-shadow: 0 3rpx 0 rgba(47, 143, 212, 0.75), 0 8rpx 16rpx rgba(47,143,212,0.22), inset 0 5rpx 10rpx rgba(255,255,255,0.65); }
/* 白果冻按钮（退出等次级操作：白果冻 + 粉柔影） */
.kawaii-btn-ghost {
  color: #A9885E;
  text-shadow: none;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF3E9 100%);
  border: 3rpx solid #FFFFFF;
  box-shadow:
    0 5rpx 0 rgba(216, 79, 134, 0.22),
    0 10rpx 18rpx rgba(120, 84, 160, 0.12),
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.9);
}
.kawaii-btn-ghost:active {
  transform: translateY(4rpx) scale(0.98);
  box-shadow: 0 2rpx 0 rgba(216, 79, 134, 0.22), 0 4rpx 10rpx rgba(120, 84, 160, 0.1), inset 0 3rpx 6rpx rgba(255,255,255,0.85);
}

/* ============ 白果冻卡片（v77：与首页弹窗同款粉白双层描边） ============ */
.kawaii-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF6E9 100%);
  border-radius: 40rpx;
  border: 6rpx solid #FFFFFF;
  box-shadow:
    0 12rpx 0 rgba(216, 79, 134, 0.16),
    0 26rpx 48rpx rgba(120, 84, 160, 0.28),
    inset 0 0 0 3rpx rgba(255, 205, 225, 0.5),
    inset 0 4rpx 0 rgba(255, 255, 255, 0.9);
  padding: 32rpx;
}

/* ============ 渐变文字（v77 糖果蜜橙→莓粉→天蓝） ============ */
.kawaii-gradient-text {
  background: linear-gradient(120deg, #FF9C1B, #FF6E9C 45%, #38BDF0 80%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

/* ============ 动画库 ============ */
/* 保留旧关键帧（多页引用，不可删） */
@keyframes pulse-soft {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
@keyframes pop-in {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(1); }
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

/* v63 新增：木语农场微动效库 */
/* 入场浮现（错峰延迟由各页面按模块设置） */
@keyframes rise-in {
  0%   { opacity: 0; transform: translateY(26rpx) scale(0.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
/* 悬挂木牌摇摆（角度极小，稳定不晕） */
@keyframes sign-sway {
  0%, 100% { transform: rotate(-1.1deg); }
  50%      { transform: rotate(1.1deg); }
}
/* 呼吸浮动 */
@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8rpx); }
}
/* 火漆盖章 */
@keyframes stamp-in {
  0%   { transform: scale(0.4) rotate(-14deg); opacity: 0; }
  60%  { transform: scale(1.14) rotate(4deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}
/* 手绘微颤（挂件/贴纸） */
@keyframes wobble-jiggle {
  0%, 100% { transform: rotate(0deg); }
  25%      { transform: rotate(-1.8deg); }
  75%      { transform: rotate(1.8deg); }
}

.anim-pulse { animation: pulse-soft 1.4s ease-in-out infinite; }
.anim-pop { animation: pop-in 0.4s ease-out; }
.anim-shake { animation: shake 0.5s ease; }
.anim-rise { animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both; }
.anim-bob { animation: bob 2.6s ease-in-out infinite; }

/* ============ 安全区域 ============ */
.safe-top { padding-top: env(safe-area-inset-top); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* ============ 自适应布局基础 ============ */
/*
 * 微信小程序中 100vh 包含导航栏高度，比可见区域大，
 * 导致底部内容被截断。此处不使用 100vh，改由 JS 计算
 * windowHeightRpx 并通过内联 style 设置容器高度。
 * page 设为 height:100% 作为 CSS 降级方案。
 */
page {
  height: 100%;
}

/* 自适应页面容器: 配合 JS 设置 style="height: {{pageHeight}}rpx" */
.adaptive-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

/* 可滚动内容区: 在 flex 容器中自动占据剩余空间 */
.adaptive-scroll {
  flex: 1;
  min-height: 0;  /* 关键: 允许 flex 子项收缩，使 scroll-view 正确滚动 */
  -webkit-overflow-scrolling: touch;
}

/* 固定区域: 不收缩 */
.adaptive-fixed {
  flex-shrink: 0;
}
