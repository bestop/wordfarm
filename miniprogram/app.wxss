/* app.wxss - 全局样式：「木语农场」木质手账拟物主题 (v63 基底 + v65 缤纷鲜化)
 *
 * 设计语言：
 *   · 农场木质纹理 —— 板条木纹（repeating-linear-gradient 拼缝 + 顺纹丝缕 + 顶部光泽）
 *   · 手绘感描边 —— 有机抖动圆角（不等半径 border-radius）+ 咖啡墨线描边
 *   · 拟物卡片 —— 牛皮纸卡 + 和纸胶带 + 火漆徽章 + 皮革缝线
 *   · 丰富微动效 —— 入场错峰浮现 / 木牌摇摆 / 火漆盖章 / 呼吸浮动 / 按压下沉
 *   · v65 缤纷鲜化 —— 全局色板提饱和提亮：蜜色橡木、鲜绿草甸、糖果点缀四色新增
 *
 * 兼容性策略（高配机优先）：毛玻璃 backdrop-filter 大胆使用；纹理全部为
 * 纯 CSS 渐变（零图片资源，不增加包体积）；老机型仅丢失模糊层不丢布局。
 */

/* ============ 颜色变量（木语农场色系 · v65 缤纷版） ============ */
page {
  /* 纸张（v65 提亮一档，更通透） */
  --farm-paper: #FFF9EA;
  --farm-paper-light: #FFFDF7;
  --farm-kraft: #FBEFD2;
  /* 木材（v65 蜜色橡木：比旧版亮一档） */
  --wood-light: #D8AC74;
  --wood-mid: #BC8048;
  --wood-deep: #9A6238;
  --wood-edge: #6B4224;
  /* 墨色（手绘线稿） */
  --farm-ink: #4A342A;
  --farm-ink-soft: #7A6450;
  --farm-ink-faint: #A9927D;
  /* 点缀（v65 鲜化：叶绿/阳光/天空/珊瑚红全部提饱和） */
  --farm-leaf: #5FC23A;
  --farm-leaf-deep: #3F9420;
  --farm-sun: #FFB300;
  --farm-sky: #A5E3FF;
  --farm-rust: #FF5252;
  /* v65 新增糖果点缀色（胶带/徽章/强调） */
  --farm-berry: #FF6E9C;
  --farm-grape: #9C4DCC;
  --farm-mint: #26BFA6;
  --farm-coral: #FF7043;

  /* 兼容旧变量名（部分页面 wxss 仍引用） */
  --color-bg: #FFF9EA;
  --color-card: #FFFDF7;
  --color-text: var(--farm-ink);
  --color-text-muted: var(--farm-ink-soft);
  --color-text-light: var(--farm-ink-faint);
  --color-danger: var(--farm-rust);
  --color-success: var(--farm-leaf);
  --shadow-card: 0 12rpx 28rpx rgba(74, 52, 42, 0.14);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;

  background: var(--farm-paper);
  color: var(--farm-ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ============ 通用类 ============ */
view, text { box-sizing: border-box; }

/* ============ 木质纹理面板（板条拼缝 + 顺纹 + 顶光） ============ */
.wood-surface {
  background-image:
    repeating-linear-gradient(90deg,
      rgba(63, 38, 20, 0.14) 0 3rpx,
      rgba(255, 255, 255, 0.06) 3rpx 6rpx,
      rgba(63, 38, 20, 0) 6rpx 86rpx),
    repeating-linear-gradient(178deg,
      rgba(63, 38, 20, 0.05) 0 2rpx,
      rgba(63, 38, 20, 0) 2rpx 30rpx),
    linear-gradient(180deg,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0) 34%,
      rgba(63, 38, 20, 0.10) 100%),
    linear-gradient(180deg, var(--wood-light) 0%, var(--wood-mid) 52%, var(--wood-deep) 100%);
}
/* 横向板条（用于横梁 / 木架：板缝水平分布） */
.wood-surface-h {
  background-image:
    repeating-linear-gradient(0deg,
      rgba(63, 38, 20, 0.13) 0 3rpx,
      rgba(255, 255, 255, 0.05) 3rpx 5rpx,
      rgba(63, 38, 20, 0) 5rpx 44rpx),
    linear-gradient(180deg,
      rgba(255, 255, 255, 0.20) 0%,
      rgba(255, 255, 255, 0) 40%,
      rgba(63, 38, 20, 0.12) 100%),
    linear-gradient(180deg, var(--wood-light) 0%, var(--wood-mid) 55%, var(--wood-deep) 100%);
}

/* ============ 手绘纸张面板（米黄纸 + 细横纹 + 墨线描边） ============ */
.paper-surface {
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.045) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 26rpx),
    linear-gradient(180deg, var(--farm-paper-light) 0%, var(--farm-paper) 100%);
  border: 3rpx solid rgba(74, 52, 42, 0.55);
  box-shadow:
    2rpx 4rpx 0 rgba(74, 52, 42, 0.10),
    0 10rpx 24rpx rgba(74, 52, 42, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.85);
}

/* ============ 拟物按钮家族（沿用 kawaii-btn 类名，全面换装木牌质感） ============ */
.kawaii-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 56rpx;
  /* 手绘抖动圆角：不等半径制造「手工剪裁」轮廓 */
  border-radius: 38rpx 26rpx 40rpx 24rpx / 26rpx 38rpx 24rpx 40rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #FFF8EA;
  text-shadow: 0 2rpx 0 rgba(63, 38, 20, 0.35);
  background-image:
    repeating-linear-gradient(90deg,
      rgba(63, 38, 20, 0.12) 0 3rpx,
      rgba(255, 255, 255, 0.05) 3rpx 6rpx,
      rgba(63, 38, 20, 0) 6rpx 64rpx),
    linear-gradient(180deg,
      rgba(255, 255, 255, 0.28) 0%,
      rgba(255, 255, 255, 0) 38%,
      rgba(63, 38, 20, 0.14) 100%),
    linear-gradient(180deg, var(--wood-light) 0%, var(--wood-mid) 50%, var(--wood-deep) 100%);
  border: 3rpx solid var(--wood-edge);
  box-shadow:
    0 8rpx 0 var(--wood-edge),
    0 14rpx 26rpx rgba(74, 52, 42, 0.32),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.45);
  transition: transform 0.12s ease, box-shadow 0.12s ease, filter 0.12s ease;
  line-height: 1.2;
}
.kawaii-btn:active {
  transform: translateY(6rpx) scale(0.98);
  filter: brightness(0.96);
  box-shadow:
    0 2rpx 0 var(--wood-edge),
    0 6rpx 14rpx rgba(74, 52, 42, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}
/* 主按钮：阳光漆木（v65 亮琥珀） */
.kawaii-btn-primary {
  color: #5A3A10;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.4);
  background-image:
    repeating-linear-gradient(90deg,
      rgba(122, 74, 10, 0.10) 0 3rpx,
      rgba(255, 255, 255, 0.08) 3rpx 6rpx,
      rgba(122, 74, 10, 0) 6rpx 64rpx),
    linear-gradient(180deg, #FFE082 0%, #FFC940 52%, #F0A800 100%);
  border-color: #A96A00;
  box-shadow:
    0 8rpx 0 #A96A00,
    0 14rpx 26rpx rgba(240, 168, 0, 0.35),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.6);
}
.kawaii-btn-primary:active { box-shadow: 0 2rpx 0 #A96A00, 0 6rpx 14rpx rgba(240,168,0,0.28), inset 0 2rpx 0 rgba(255,255,255,0.5); }
/* 薄荷→鲜叶绿漆木（继续/再来一局；v65 提鲜） */
.kawaii-btn-mint {
  color: #FFFFFF;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(43, 74, 21, 0.12) 0 3rpx,
      rgba(255, 255, 255, 0.06) 3rpx 6rpx,
      rgba(43, 74, 21, 0) 6rpx 64rpx),
    linear-gradient(180deg, rgba(255,255,255,0.30) 0%, rgba(255,255,255,0) 38%, rgba(43,74,21,0.16) 100%),
    linear-gradient(180deg, #9CCC65 0%, #7DBE33 52%, #558B2F 100%);
  border-color: #33691E;
  box-shadow:
    0 8rpx 0 #33691E,
    0 14rpx 26rpx rgba(85, 139, 47, 0.35),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.45);
}
.kawaii-btn-mint:active { box-shadow: 0 2rpx 0 #33691E, 0 6rpx 14rpx rgba(85,139,47,0.28), inset 0 2rpx 0 rgba(255,255,255,0.35); }
/* 天空漆木（次要强调） */
.kawaii-btn-sky {
  color: #14384D;
  text-shadow: none;
  background-image:
    repeating-linear-gradient(90deg,
      rgba(20, 56, 77, 0.08) 0 3rpx,
      rgba(255, 255, 255, 0.10) 3rpx 6rpx,
      rgba(20, 56, 77, 0) 6rpx 64rpx),
    linear-gradient(180deg, #D8F0FF 0%, #A5DCF5 52%, #7FC4E8 100%);
  border-color: #3E7A9E;
  box-shadow:
    0 8rpx 0 #3E7A9E,
    0 14rpx 26rpx rgba(110, 193, 228, 0.35),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.65);
}
.kawaii-btn-sky:active { box-shadow: 0 2rpx 0 #3E7A9E, 0 6rpx 14rpx rgba(110,193,228,0.28), inset 0 2rpx 0 rgba(255,255,255,0.5); }
/* 纸签按钮（退出等次级操作：牛皮纸签 + 墨线） */
.kawaii-btn-ghost {
  color: var(--farm-ink-soft);
  text-shadow: none;
  background: var(--farm-paper-light);
  border: 3rpx dashed rgba(74, 52, 42, 0.45);
  box-shadow:
    0 6rpx 0 rgba(74, 52, 42, 0.22),
    0 10rpx 18rpx rgba(74, 52, 42, 0.12);
}
.kawaii-btn-ghost:active {
  transform: translateY(4rpx) scale(0.98);
  box-shadow: 0 2rpx 0 rgba(74, 52, 42, 0.22), 0 4rpx 10rpx rgba(74, 52, 42, 0.10);
}

/* ============ 拟物卡片（亮米黄纸卡 + 抖动墨线描边；v65 纸色提亮） ============ */
.kawaii-card {
  background:
    repeating-linear-gradient(180deg,
      rgba(122, 100, 80, 0.04) 0 1rpx,
      rgba(122, 100, 80, 0) 1rpx 26rpx),
    linear-gradient(180deg, #FFFDF7 0%, #FFF9EA 100%);
  border-radius: 40rpx 30rpx 42rpx 28rpx / 30rpx 40rpx 28rpx 42rpx;
  border: 4rpx solid rgba(74, 52, 42, 0.55);
  box-shadow:
    0 16rpx 36rpx rgba(74, 52, 42, 0.22),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.9);
  padding: 32rpx;
}

/* ============ 渐变文字（v65 鲜果蜜语渐变） ============ */
.kawaii-gradient-text {
  background: linear-gradient(120deg, #FFA726, #3F9420 45%, #FFC400 80%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

/* ============ 动画库 ============ */
/* 保留旧关键帧（多页引用，不可删） */
@keyframes pulse-soft {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
@keyframes pop-in {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(1); }
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}

/* v63 新增：木语农场微动效库 */
/* 入场浮现（错峰延迟由各页面按模块设置） */
@keyframes rise-in {
  0%   { opacity: 0; transform: translateY(26rpx) scale(0.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}
/* 悬挂木牌摇摆（角度极小，稳定不晕） */
@keyframes sign-sway {
  0%, 100% { transform: rotate(-1.1deg); }
  50%      { transform: rotate(1.1deg); }
}
/* 呼吸浮动 */
@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8rpx); }
}
/* 火漆盖章 */
@keyframes stamp-in {
  0%   { transform: scale(0.4) rotate(-14deg); opacity: 0; }
  60%  { transform: scale(1.14) rotate(4deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}
/* 手绘微颤（挂件/贴纸） */
@keyframes wobble-jiggle {
  0%, 100% { transform: rotate(0deg); }
  25%      { transform: rotate(-1.8deg); }
  75%      { transform: rotate(1.8deg); }
}

.anim-pulse { animation: pulse-soft 1.4s ease-in-out infinite; }
.anim-pop { animation: pop-in 0.4s ease-out; }
.anim-shake { animation: shake 0.5s ease; }
.anim-rise { animation: rise-in 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.05) both; }
.anim-bob { animation: bob 2.6s ease-in-out infinite; }

/* ============ 安全区域 ============ */
.safe-top { padding-top: env(safe-area-inset-top); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* ============ 自适应布局基础 ============ */
/*
 * 微信小程序中 100vh 包含导航栏高度，比可见区域大，
 * 导致底部内容被截断。此处不使用 100vh，改由 JS 计算
 * windowHeightRpx 并通过内联 style 设置容器高度。
 * page 设为 height:100% 作为 CSS 降级方案。
 */
page {
  height: 100%;
}

/* 自适应页面容器: 配合 JS 设置 style="height: {{pageHeight}}rpx" */
.adaptive-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

/* 可滚动内容区: 在 flex 容器中自动占据剩余空间 */
.adaptive-scroll {
  flex: 1;
  min-height: 0;  /* 关键: 允许 flex 子项收缩，使 scroll-view 正确滚动 */
  -webkit-overflow-scrolling: touch;
}

/* 固定区域: 不收缩 */
.adaptive-fixed {
  flex-shrink: 0;
}
